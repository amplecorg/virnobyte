---
import Base from '@/layouts/Base.astro';
import { services } from '@/lib/data';
Astro.response.status = 404;
const top = services().filter((s) => s.footer).slice(0, 6);
---

<Base title="Page not found | Virnobyte" description="The page you were looking for could not be found." noindex canonical="/404">
  <section class="section">
    <div class="wrap stack" style="max-width:760px">
      <span class="eyebrow">Error 404</span>
      <h1>This page isn't here</h1>
      <p class="lede">The link may be old or mistyped. These pages are the most likely matches:</p>
      <ul class="ticks">
        {top.map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}
        <li><a href="/membership">Membership card</a></li>
        <li><a href="/contact">Contact Virnobyte</a></li>
      </ul>
      <p><a class="btn" href="/">Go to the home page</a></p>
    </div>
  </section>
</Base>
