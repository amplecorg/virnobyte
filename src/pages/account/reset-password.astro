---
import Auth from '@/layouts/Auth.astro';
import Field from '@/components/Field.astro';
import { validateResetToken, resetPasswordWithToken, rateLimit } from '@/lib/auth';

const token = String(Astro.url.searchParams.get('token') ?? '').trim();

let tokenError = '';
let formError = '';

if (!token) {
  tokenError = 'Password reset token is missing. Please check the link from your email.';
} else {
  const check = validateResetToken(token);
  if (!check.valid) {
    tokenError = check.error || 'This password reset link is invalid or has expired.';
  }
}

if (!tokenError && Astro.request.method === 'POST') {
  if (!rateLimit(`reset-pw:${Astro.clientAddress}`, 10, 15 * 60_000)) {
    formError = 'Too many attempts. Please wait 15 minutes before trying again.';
  } else {
    const form = await Astro.request.formData();
    const password = String(form.get('password') ?? '');
    const confirmPassword = String(form.get('confirmPassword') ?? '');

    if (password.length < 8) {
      formError = 'Password must be at least 8 characters long.';
    } else if (password !== confirmPassword) {
      formError = 'Passwords do not match. Please verify and re-enter.';
    } else {
      const res = resetPasswordWithToken(token, password);
      if (!res.success) {
        formError = res.error || 'Failed to update password. Please request a new link.';
      } else {
        return Astro.redirect('/account/login?reset=1', 303);
      }
    }
  }
}
---

<Auth
  title="Reset Password | Virnobyte"
  heading="Set a new password"
  lede="Choose a secure password of at least 8 characters for your account."
>
  {tokenError ? (
    <div>
      <p class="alert alert--error" role="alert">{tokenError}</p>
      <div style="margin-top: 1.5rem;">
        <a href="/account/forgot-password" class="btn btn--block">Request a new reset link</a>
      </div>
      <p class="small muted" style="margin-top: 1.5rem;">
        <a href="/account/login">&larr; Return to sign in</a>
      </p>
    </div>
  ) : (
    <>
      {formError && <p class="alert alert--error" role="alert">{formError}</p>}
      <form method="post" novalidate>
        <Field
          label="New Password"
          name="password"
          type="password"
          required
          autocomplete="new-password"
          minlength={8}
          hint="At least 8 characters."
        />
        <Field
          label="Confirm New Password"
          name="confirmPassword"
          type="password"
          required
          autocomplete="new-password"
          minlength={8}
        />
        <button class="btn btn--block" type="submit">Update password</button>
      </form>
      <p class="small muted">
        <a href="/account/login">&larr; Cancel and return to sign in</a>
      </p>
    </>
  )}
</Auth>

