---
// GST tax invoice for a website order, laid out like Virnobyte's billing-software invoices.
// Private: the order's owner or an admin only (the /account prefix also makes it no-store + noindex).
import { getSettings } from '@/lib/settings';
import { getOrder, orderItems } from '@/lib/commerce/orders';
import { amountInWords, computeInvoice, ensureInvoiceNumber, invoiceEligible, money } from '@/lib/commerce/invoice';

const ref = Astro.params.ref ?? '';
const user = Astro.locals.user;
let order = getOrder(ref);
if (!order) return new Response('Invoice not found', { status: 404 });
if (!user || (user.role !== 'admin' && user.id !== order.user_id)) {
  return Astro.redirect(`/account/login?next=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

// Orders paid before invoicing existed (or marked paid by an admin) get their number on first view.
if (!order.invoice_no && invoiceEligible(order)) {
  ensureInvoiceNumber(order.order_id);
  order = getOrder(ref)!;
}
const ready = !!order.invoice_no;

const s = getSettings();
const co = s.company;
const items = orderItems(order.id);
const inv = computeInvoice(items, order);

const dmy = (v?: string | null) => {
  if (!v) return '';
  const d = new Date(v.length <= 10 ? `${v}T00:00:00` : v.replace(' ', 'T') + (v.includes('Z') ? '' : 'Z'));
  return Number.isNaN(d.getTime()) ? v : d.toLocaleDateString('en-GB', { timeZone: 'Asia/Kolkata' });
};
const address = [order.address_line1, order.address_line2, `${order.city}, ${order.state} – ${order.pincode}`].filter(Boolean).join(', ');
const isPaid = order.payment_status === 'PAID';
const isCod = order.payment_method === 'cod';
const gatewayLabel = order.gateway === 'cashfree' ? 'Cashfree' : order.gateway === 'razorpay' ? 'Razorpay' : 'online payment';
// One GST rate across all lines → show it on the tax rows (e.g. CGST @9%).
const rates = [...new Set(inv.hsnSummary.map((h) => h.gstRate))];
const rateLabel = (div: number) => (rates.length === 1 ? `${rates[0] / div}%` : 'as per HSN summary');
const backHref = `/order-success?order_id=${encodeURIComponent(order.order_id)}`;
const title = ready ? `Tax Invoice ${order.invoice_no}` : `Invoice for order ${order.order_id}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {co.legalName}</title>
    <link rel="icon" href="/favicon-32.png" />
  </head>
  <body>
    <nav class="toolbar" aria-label="Invoice actions">
      <a href={backHref}>← Back to order</a>
      {ready && <button type="button" data-print>Download / Print PDF</button>}
    </nav>

    {
      !ready ? (
        <main class="sheet pending">
          <h1>Invoice not issued yet</h1>
          <p>
            Order <strong>{order.order_id}</strong> is {order.order_status === 'CANCELLED' ? 'cancelled' : 'awaiting payment confirmation'}.
            The tax invoice is issued automatically once the payment is confirmed.
          </p>
          <p><a href={backHref}>View order status</a></p>
        </main>
      ) : (
        <main class="sheet">
          <header class="doc-head">
            <strong>TAX INVOICE</strong>
            <span class="pill">ORIGINAL FOR RECIPIENT</span>
          </header>

          <div class="box">
            <!-- Seller + invoice meta -->
            <div class="grid-2 b-bottom">
              <div class="seller">
                <img src="/virnobyte-logo.png" alt="" width="64" height="50" />
                <div>
                  <h2>{co.legalName.toUpperCase()}</h2>
                  <p>{co.registeredOffice}</p>
                  <p class="kv-2">
                    <span><b>GSTIN:</b> {co.gstin}</span>
                    <span><b>Mobile:</b> {co.billingPhone}</span>
                  </p>
                  <p><b>PAN Number:</b> {co.pan}</p>
                  <p><b>Email:</b> {co.accountsEmail}</p>
                  <p><b>Website:</b> {co.website}</p>
                </div>
              </div>
              <div class="meta b-left">
                <div><span>Invoice No.</span><strong>{order.invoice_no}</strong></div>
                <div><span>Invoice Date</span><strong>{dmy(order.invoice_date)}</strong></div>
                <div><span>Order ID</span><strong>{order.order_id}</strong></div>
                <div><span>Order Date</span><strong>{dmy(order.created_at)}</strong></div>
              </div>
            </div>

            <!-- Bill to / Ship to -->
            <div class="grid-2 b-bottom">
              <div class="party">
                <h3>BILL TO</h3>
                <p class="party-name">{(order.customer_company || order.customer_name).toUpperCase()}</p>
                {order.customer_company && <p>Attn: {order.customer_name}</p>}
                <p><span class="lbl">Address:</span> {address}</p>
                <p><span class="lbl">Mobile:</span> {order.customer_phone}{order.customer_email && <> · {order.customer_email}</>}</p>
                <p class="kv-2">
                  {order.customer_gstin && <span><span class="lbl">GSTIN:</span> {order.customer_gstin}</span>}
                  <span><span class="lbl">Place of Supply:</span> {order.state}</span>
                </p>
              </div>
              <div class="party b-left">
                <h3>SHIP TO</h3>
                <p class="party-name">{order.customer_name.toUpperCase()}</p>
                <p><span class="lbl">Address:</span> {address}</p>
              </div>
            </div>

            <!-- Items -->
            <table class="items">
              <thead>
                <tr>
                  <th class="c-sno">S.NO.</th>
                  <th class="c-item">ITEMS</th>
                  <th>HSN</th>
                  <th>QTY.</th>
                  <th>RATE</th>
                  <th>AMOUNT</th>
                </tr>
              </thead>
              <tbody>
                {inv.lines.map((l) => (
                  <tr>
                    <td class="c">{l.sno}</td>
                    <td>{l.name}</td>
                    <td class="c">{l.hsn}</td>
                    <td class="c">{l.quantity} {l.unit}</td>
                    <td class="r">{money(l.rate)}</td>
                    <td class="r">{money(l.taxable)}</td>
                  </tr>
                ))}
                <tr class="spacer"><td /><td /><td /><td /><td /><td /></tr>
                {inv.intraState ? (
                  <>
                    <tr class="tax"><td /><td class="r"><i>CGST @{rateLabel(2)}</i></td><td class="c">-</td><td class="c">-</td><td class="c">-</td><td class="r">₹ {money(inv.cgst)}</td></tr>
                    <tr class="tax"><td /><td class="r"><i>SGST @{rateLabel(2)}</i></td><td class="c">-</td><td class="c">-</td><td class="c">-</td><td class="r">₹ {money(inv.sgst)}</td></tr>
                  </>
                ) : (
                  <tr class="tax"><td /><td class="r"><i>IGST @{rateLabel(1)}</i></td><td class="c">-</td><td class="c">-</td><td class="c">-</td><td class="r">₹ {money(inv.igst)}</td></tr>
                )}
                {Math.abs(inv.roundOff) >= 0.01 && (
                  <tr class="tax"><td /><td class="r"><i>Round off</i></td><td /><td /><td /><td class="r">{inv.roundOff > 0 ? '+' : '−'} {money(Math.abs(inv.roundOff))}</td></tr>
                )}
              </tbody>
              <tfoot>
                <tr>
                  <td />
                  <td class="r"><b>TOTAL</b></td>
                  <td />
                  <td class="c"><b>{inv.quantity}</b></td>
                  <td />
                  <td class="r"><b>₹ {inv.total.toLocaleString('en-IN')}</b></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <!-- HSN summary -->
          <table class="hsn">
            <thead>
              {inv.intraState ? (
                <>
                  <tr><th rowspan="2">HSN/SAC</th><th rowspan="2">Taxable Value</th><th colspan="2">CGST</th><th colspan="2">SGST</th><th rowspan="2">Total Tax Amount</th></tr>
                  <tr><th>Rate</th><th>Amount</th><th>Rate</th><th>Amount</th></tr>
                </>
              ) : (
                <>
                  <tr><th rowspan="2">HSN/SAC</th><th rowspan="2">Taxable Value</th><th colspan="2">IGST</th><th rowspan="2">Total Tax Amount</th></tr>
                  <tr><th>Rate</th><th>Amount</th></tr>
                </>
              )}
            </thead>
            <tbody>
              {inv.hsnSummary.map((h) => (
                <tr>
                  <td class="r">{h.hsn}</td>
                  <td class="r">{money(h.taxable)}</td>
                  {inv.intraState ? (
                    <>
                      <td class="c">{h.gstRate / 2}%</td><td class="r">{money(h.cgst)}</td>
                      <td class="c">{h.gstRate / 2}%</td><td class="r">{money(h.sgst)}</td>
                    </>
                  ) : (
                    <>
                      <td class="c">{h.gstRate}%</td><td class="r">{money(h.igst)}</td>
                    </>
                  )}
                  <td class="r">₹ {money(h.tax)}</td>
                </tr>
              ))}
              <tr class="sum">
                <td class="r"><b>Total</b></td>
                <td class="r"><b>{money(inv.taxable)}</b></td>
                {inv.intraState ? (
                  <>
                    <td /><td class="r"><b>{money(inv.cgst)}</b></td>
                    <td /><td class="r"><b>{money(inv.sgst)}</b></td>
                  </>
                ) : (
                  <>
                    <td /><td class="r"><b>{money(inv.igst)}</b></td>
                  </>
                )}
                <td class="r"><b>₹ {money(inv.tax)}</b></td>
              </tr>
            </tbody>
          </table>

          <div class="box">
            <div class="b-bottom pad">
              <h3>Total Amount (in words)</h3>
              <p>{amountInWords(inv.total)}</p>
            </div>
            <div class="grid-2 b-bottom">
              <div class="pad">
                <h3>Payment</h3>
                {isPaid ? (
                  <dl class="pay">
                    <dt>Status</dt><dd class="paid">PAID</dd>
                    <dt>Mode</dt><dd>{isCod ? 'Cash on Delivery' : `Online via ${gatewayLabel}`}</dd>
                    {order.gateway_payment_id && (<><dt>Payment ID</dt><dd>{order.gateway_payment_id}</dd></>)}
                    {order.paid_at && (<><dt>Paid on</dt><dd>{dmy(order.paid_at)}</dd></>)}
                  </dl>
                ) : (
                  <dl class="pay">
                    <dt>Status</dt><dd>PAYABLE ON DELIVERY</dd>
                    <dt>Mode</dt><dd>Cash on Delivery</dd>
                    <dt>Amount due</dt><dd>₹ {inv.total.toLocaleString('en-IN')}</dd>
                  </dl>
                )}
              </div>
              <div class="pad b-left">
                <h3>Order reference</h3>
                <dl class="pay">
                  <dt>Order ID</dt><dd>{order.order_id}</dd>
                  <dt>Supply</dt><dd>{inv.intraState ? `Intra-state (${co.gstState})` : `Inter-state to ${order.state}`}</dd>
                  <dt>Reverse charge</dt><dd>No</dd>
                </dl>
              </div>
            </div>
            <div class="grid-2">
              <div class="pad terms">
                <h3>Terms and Conditions</h3>
                <p>Thanks for doing business with us!</p>
                <p><b>Declaration</b><br />{co.declaration}</p>
                <ol>
                  {co.invoiceTerms.map((t) => <li>{t}</li>)}
                </ol>
              </div>
              <div class="pad b-left sign">
                <div class="stamp" aria-hidden="true">
                  <span>{co.legalName.replace(/ Private Limited$/i, '').toUpperCase()}</span>
                  <small>PUNE</small>
                </div>
                <p>Authorised Signatory For<br /><b>{co.legalName.toUpperCase()}</b></p>
                <p class="note">This is a computer-generated invoice and does not require a physical signature.</p>
              </div>
            </div>
          </div>
        </main>
      )
    }

    <script>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>

    <style is:global>
      :root {
        --ink: #111827;
        --muted: #4b5563;
        --line: #1f2937;
        --soft: #e5e7eb;
        --head: #e5e7eb;
        --paper: #ffffff;
        --bg: #eef1f5;
        --accent: #0a5fc2;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 12.5px/1.45 'Roboto', 'Segoe UI', Arial, sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .toolbar {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        max-width: 210mm;
        margin: 0 auto;
        padding: 12px 16px;
        background: var(--bg);
      }
      .toolbar a {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
      }
      .toolbar button {
        border: 0;
        border-radius: 999px;
        padding: 10px 18px;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }
      .sheet {
        width: 210mm;
        max-width: 100%;
        min-height: 297mm;
        margin: 0 auto 32px;
        padding: 12mm 10mm;
        background: var(--paper);
        box-shadow: 0 10px 40px rgb(15 23 42 / 0.12);
      }
      .sheet.pending {
        min-height: 0;
        font-size: 15px;
      }
      .doc-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
        font-size: 15px;
      }
      .pill {
        border: 1px solid #9ca3af;
        color: #6b7280;
        padding: 1px 8px;
        border-radius: 3px;
        font-size: 13px;
        letter-spacing: 0.02em;
      }
      .box {
        border: 1px solid var(--line);
      }
      .box + .hsn,
      .hsn + .box {
        margin-top: 10px;
      }
      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      .b-bottom {
        border-bottom: 1px solid var(--line);
      }
      .b-left {
        border-left: 1px solid var(--line);
      }
      .pad {
        padding: 8px 10px;
      }
      h2,
      h3,
      p {
        margin: 0;
      }
      h3 {
        font-size: 12.5px;
        font-weight: 600;
        margin-bottom: 4px;
      }
      .seller {
        display: flex;
        gap: 12px;
        padding: 10px;
      }
      .seller img {
        flex: none;
        object-fit: contain;
      }
      .seller h2 {
        font-size: 16px;
        margin-bottom: 2px;
      }
      .kv-2 {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 24px;
      }
      .meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-content: center;
        gap: 14px 8px;
        padding: 10px;
        text-align: center;
      }
      .meta span {
        display: block;
        font-weight: 600;
      }
      .meta strong {
        font-weight: 400;
        overflow-wrap: anywhere;
      }
      .party {
        padding: 8px 10px 10px;
      }
      .party-name {
        font-weight: 700;
        margin: 2px 0 4px;
      }
      .lbl {
        color: var(--muted);
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      .items th {
        background: var(--head);
        font-weight: 500;
        padding: 8px 6px;
        border-bottom: 1px solid var(--line);
        border-left: 1px solid var(--line);
      }
      .items th:first-child,
      .items td:first-child {
        border-left: 0;
      }
      .items td {
        padding: 6px;
        vertical-align: top;
        border-left: 1px solid var(--line);
      }
      .items .c-sno {
        width: 7%;
      }
      .items .c-item {
        width: 47%;
      }
      .items .spacer td {
        height: 120px;
      }
      .items .tax td {
        padding-top: 4px;
        padding-bottom: 4px;
      }
      .items tfoot td {
        background: var(--head);
        border-top: 1px solid var(--line);
        padding: 8px 6px;
      }
      .c {
        text-align: center;
      }
      .r {
        text-align: right;
      }
      .hsn {
        border: 1px solid var(--line);
        margin-top: 10px;
      }
      .hsn th {
        background: var(--head);
        font-weight: 500;
        padding: 4px 6px;
        border: 1px solid var(--line);
      }
      .hsn td {
        padding: 4px 6px;
        border-left: 1px solid var(--line);
        border-right: 1px solid var(--line);
      }
      .hsn .sum td {
        border-top: 1px solid var(--line);
      }
      .pay {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 2px 14px;
        margin: 0;
      }
      .pay dt {
        color: var(--muted);
      }
      .pay dd {
        margin: 0;
        overflow-wrap: anywhere;
      }
      .pay .paid {
        color: #047857;
        font-weight: 700;
      }
      .terms p {
        margin-bottom: 4px;
      }
      .terms ol {
        margin: 0;
        padding-left: 16px;
      }
      .sign {
        display: grid;
        justify-items: center;
        align-content: center;
        gap: 6px;
        text-align: center;
      }
      .stamp {
        display: grid;
        place-content: center;
        width: 74px;
        height: 74px;
        border: 2px solid #64748b;
        border-radius: 50%;
        color: #475569;
        font-size: 8.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1.2;
        transform: rotate(-12deg);
        opacity: 0.85;
      }
      .note {
        color: var(--muted);
        font-size: 10.5px;
      }
      @media (max-width: 760px) {
        .sheet {
          padding: 16px 10px;
          min-height: 0;
        }
        .grid-2 {
          grid-template-columns: 1fr;
        }
        .b-left {
          border-left: 0;
          border-top: 1px solid var(--line);
        }
        .items,
        .hsn {
          font-size: 11px;
        }
        .items .spacer td {
          height: 24px;
        }
      }
      @page {
        size: A4;
        margin: 8mm;
      }
      @media print {
        html,
        body {
          background: #fff;
        }
        .toolbar {
          display: none;
        }
        .sheet {
          width: auto;
          min-height: 0;
          margin: 0;
          padding: 0;
          box-shadow: none;
        }
        .grid-2 {
          grid-template-columns: 1fr 1fr !important;
        }
      }
    </style>
  </body>
</html>
