---
import Auth from '@/layouts/Auth.astro';
import Field from '@/components/Field.astro';
import { createPasswordReset, rateLimit } from '@/lib/auth';

if (Astro.locals.user) {
  return Astro.redirect('/account');
}

let error = '';
let email = '';
let submitted = false;
let devUrl: string | undefined = undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  // Honeypot check
  if (form.get('website')) {
    submitted = true;
  } else {
    email = String(form.get('email') ?? '').trim();

    if (!rateLimit(`forgot-pw:${Astro.clientAddress}`, 5, 15 * 60_000)) {
      error = 'Too many requests. Please wait 15 minutes before trying again.';
    } else if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      error = 'Please enter a valid email address.';
    } else {
      const res = await createPasswordReset(email, Astro.url.origin);
      if (!res.success && res.error) {
        error = res.error;
      } else {
        submitted = true;
        devUrl = res.devUrl;
      }
    }
  }
}
---

<Auth
  title="Forgot Password | Virnobyte"
  heading="Reset your password"
  lede="Enter the email address associated with your account and we will send you a link to reset your password."
>
  {submitted ? (
    <div>
      <p class="alert alert--ok" role="status">
        If an account with that email exists, we have sent instructions to reset your password. Please check your inbox and spam folder.
      </p>

      {devUrl && (
        <div class="alert" style="margin-top: 1rem; word-break: break-all; background: #e0f2fe; border-color: #7dd3fc; color: #0369a1;">
          <strong>Local Development Notice:</strong> SMTP is not configured in <code>.env</code>. You can use this generated link to test:
          <div style="margin-top: 0.5rem;">
            <a href={devUrl} style="text-decoration: underline; font-weight: 600;">{devUrl}</a>
          </div>
        </div>
      )}

      <p class="small muted" style="margin-top: 1.5rem;">
        <a href="/account/login">&larr; Return to sign in</a>
      </p>
    </div>
  ) : (
    <>
      {error && <p class="alert alert--error" role="alert">{error}</p>}
      <form method="post" novalidate>
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" />
        <Field
          label="Email address"
          name="email"
          type="email"
          required
          autocomplete="email"
          value={email}
          hint="We will send a secure reset link to this address."
        />
        <button class="btn btn--block" type="submit">Send reset link</button>
      </form>
      <p class="small muted">
        Remember your password? <a href="/account/login">Sign in</a>.
      </p>
    </>
  )}
</Auth>

