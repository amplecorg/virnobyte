---
import Auth from '@/layouts/Auth.astro';
import Field from '@/components/Field.astro';
import { createSession, rateLimit, registerCustomer } from '@/lib/auth';
import { get } from '@/lib/db';
import { planById, requestMembership } from '@/lib/data';

const next = Astro.url.searchParams.get('next');
const safeNext = next && next.startsWith('/') && !next.startsWith('//') ? next : null;
const isCheckout = safeNext && safeNext.startsWith('/checkout');

const planId = Number(Astro.url.searchParams.get('plan')) || null;
const plan = planId ? planById(planId) : undefined;
const errors: Record<string, string> = {};
const values = { name: '', email: '', phone: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values.name = String(form.get('name') ?? '').trim();
  values.email = String(form.get('email') ?? '').trim();
  values.phone = String(form.get('phone') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!values.name) errors.name = 'Enter your name as it should appear on your card.';
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(values.email)) errors.email = 'Enter an email address like name@example.com.';
  else if (get('SELECT 1 FROM users WHERE email = ?', values.email)) errors.email = 'An account with this email already exists. Sign in instead.';
  if (!/^[+]?[0-9 ()-]{10,16}$/.test(values.phone)) errors.phone = 'Enter a 10-digit mobile number, e.g. 98765 43210.';
  if (password.length < 8) errors.password = 'Use at least 8 characters.';
  if (!rateLimit(`reg:${Astro.clientAddress}`, 5, 60 * 60_000)) errors.form = 'Too many accounts created from this connection. Please call us.';

  if (!Object.keys(errors).length) {
    const id = registerCustomer({ ...values, password });
    const isSecure = Astro.url.protocol === 'https:' || Astro.request.headers.get('x-forwarded-proto') === 'https';
    createSession(Astro.cookies, id, isSecure);
    if (plan && plan.active) {
      requestMembership(id, plan.id);
      return Astro.redirect('/account?requested=1', 303);
    }
    return Astro.redirect(safeNext ?? '/account', 303);
  }
}
---

<Auth
  title={isCheckout ? 'Create an account to order | Virnobyte' : 'Create an account | Virnobyte'}
  heading={plan ? `Get the ${plan.name} card` : isCheckout ? 'Create your account to order' : 'Create your account'}
  lede={
    plan
      ? 'Create an account to request your card. We will call to confirm and activate it.'
      : isCheckout
        ? 'Create an account to complete your checkout and track doorstep delivery.'
        : 'Track your membership card, coins and service visits.'
  }
>
  {isCheckout && (
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 12px 14px; border-radius: 8px; margin-bottom: 16px; font-size: 0.9rem;">
      🛒 <strong>Fast Checkout:</strong> Create your account to place this order and track your delivery.
    </div>
  )}
  {errors.form && <p class="alert alert--error" role="alert">{errors.form}</p>}
  <form method="post" novalidate>
    <Field label="Full name" name="name" required autocomplete="name" value={values.name} error={errors.name} hint="Your full name for delivery." />
    <Field label="Email" name="email" type="email" required autocomplete="email" value={values.email} error={errors.email} />
    <Field label="Mobile number" name="phone" type="tel" required autocomplete="tel" inputmode="tel" value={values.phone} error={errors.phone} />
    <Field label="Password" name="password" type="password" required autocomplete="new-password" minlength={8} error={errors.password} hint="At least 8 characters." />
    <button class="btn btn--block" type="submit">{plan ? `Create account and request ${plan.name}` : isCheckout ? 'Create Account & Proceed to Checkout' : 'Create account'}</button>
  </form>
  <p class="small muted">Already have an account? <a href={`/account/login${safeNext ? `?next=${encodeURIComponent(safeNext)}` : ''}`}>Sign in</a>.</p>
</Auth>
