---
import Auth from '@/layouts/Auth.astro';
import Field from '@/components/Field.astro';
import { authenticate, createSession, rateLimit } from '@/lib/auth';

const next = Astro.url.searchParams.get('next');
const reset = Astro.url.searchParams.get('reset');
const safeNext = next && next.startsWith('/') && !next.startsWith('//') ? next : null;
let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  if (!rateLimit(`login:${Astro.clientAddress}`, 10, 15 * 60_000)) {
    error = 'Too many sign-in attempts. Wait 15 minutes and try again.';
  } else {
    const user = authenticate(email, password);
    if (!user) error = 'That email and password do not match an account.';
    else {
      const isSecure = Astro.url.protocol === 'https:' || Astro.request.headers.get('x-forwarded-proto') === 'https';
      createSession(Astro.cookies, user.id, isSecure);
      return Astro.redirect(safeNext ?? (user.role === 'admin' ? '/admin' : '/account'), 303);
    }
  }
}
---

<Auth title="Sign in | Virnobyte" heading="Sign in to your account" lede="See your membership card, coin balance and service history.">
  {reset === '1' && (
    <p class="alert alert--ok" role="status">
      Your password has been reset successfully. Please sign in with your new password.
    </p>
  )}
  {error && <p class="alert alert--error" role="alert">{error}</p>}
  <form method="post">
    <Field label="Email" name="email" type="email" required autocomplete="email" value={email} />
    <Field label="Password" name="password" type="password" required autocomplete="current-password" />
    <div style="display: flex; justify-content: flex-end; margin-top: -0.5rem; margin-bottom: 0.25rem;">
      <a href="/account/forgot-password" class="small muted">Forgot password?</a>
    </div>
    <button class="btn btn--block" type="submit">Sign in</button>
  </form>
  <p class="small muted">
    New here? <a href={`/account/register${safeNext ? `?next=${encodeURIComponent(safeNext)}` : ''}`}>Create an account</a>.
  </p>
</Auth>
