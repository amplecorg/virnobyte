---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Photo from '@/components/Photo.astro';
import { contactInfo, getSettings } from '@/lib/settings';
import { services } from '@/lib/data';
import { breadcrumbs, localBusiness } from '@/lib/schema';

const s = getSettings();
const c = contactInfo(s);
const svc = services();
const years = new Date().getFullYear() - s.business.foundedYear;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
];
const VALUES = [
  { t: 'Customer first', d: 'We recommend what solves your problem, even when that is the cheaper option.' },
  { t: 'Transparency', d: 'Diagnosis before repair, itemised quotes, and no work without your approval.' },
  { t: 'Reliability', d: 'Tested components, tidy installations and records of what was done.' },
  { t: 'Integrity', d: 'Your devices and data are handled with care and kept private.' },
];

const CERTIFICATES = [
  {
    id: 'dpiit',
    title: 'Certificate of Recognition',
    authority: 'Ministry of Commerce & Industry · DPIIT',
    subtitle: 'Government of India · Startup India',
    regLabel: 'Certificate No.',
    regNumber: 'DIPP264419',
    date: '29-05-2026',
    validity: 'Valid up to 27-04-2036',
    description: 'Recognized as an innovative startup working in the IT Services sector under the Startup India initiative.',
    image: '/certificates/certificate-1.jpg',
    badge: 'Startup India',
  },
  {
    id: 'mca',
    title: 'Certificate of Incorporation',
    authority: 'Ministry of Corporate Affairs',
    subtitle: 'Central Registration Centre, Govt. of India',
    regLabel: 'CIN',
    regNumber: 'U95111PN2026PTC255068',
    date: '28-04-2026',
    validity: 'Company Limited by Shares',
    description: 'Incorporated under the Companies Act, 2013 as Virnobyte Private Limited.',
    image: '/certificates/certificate-5.jpg',
    badge: 'MCA Incorporated',
  },
  {
    id: 'gst',
    title: 'GST Registration Certificate',
    authority: 'Goods & Services Tax Network',
    subtitle: 'Government of India · Form GST REG-06',
    regLabel: 'GSTIN',
    regNumber: '27AAMCV1703G1ZD',
    date: '09-05-2026',
    validity: 'Regular Taxpayer',
    description: 'Government-registered GST enterprise authorized for computer hardware, IT networking & repair services.',
    image: '/certificates/certificate-6.jpg',
    badge: 'GST Certified',
  },
  {
    id: 'msme',
    title: 'Udyam Registration Certificate',
    authority: 'Ministry of Micro, Small & Medium Enterprises',
    subtitle: 'Government of India · MSME',
    regLabel: 'Udyam Reg. No.',
    regNumber: 'UDYAM-MH-26-1136149',
    date: '09-05-2026',
    validity: 'Enterprise Type: Micro',
    description: 'National Industry Classification for computer consultancy, peripheral hardware & IT support services.',
    image: '/certificates/certificate-3.jpg',
    badge: 'MSME Certified',
  },
  {
    id: 'pan',
    title: 'Corporate Permanent Account Number (e-PAN)',
    authority: 'Income Tax Department',
    subtitle: 'Government of India',
    regLabel: 'PAN',
    regNumber: 'AAMCV1703G',
    date: '28-04-2026',
    validity: 'Permanent Corporate Tax ID',
    description: 'Statutory corporate permanent account number issued to Virnobyte Private Limited.',
    image: '/certificates/certificate-4.jpg',
    badge: 'Income Tax',
  },
  {
    id: 'tan',
    title: 'Tax Deduction Account Number (TAN)',
    authority: 'Income Tax Department',
    subtitle: 'Government of India',
    regLabel: 'TAN',
    regNumber: 'PNEV29601F',
    date: '28-04-2026',
    validity: 'Section 397(1) Compliant',
    description: 'Tax Deduction & Collection Account allotment under the Income Tax Act for compliant corporate operations.',
    image: '/certificates/certificate-2.jpg',
    badge: 'Income Tax',
  },
];
---

<Base
  title="About Virnobyte | IT Solutions & Computer Services in Pune"
  description={`Virnobyte is a hardware, networking and IT services company in Chikhali, Pimpri-Chinchwad, serving homes and businesses across Pune since ${s.business.foundedYear}.`}
  canonical="/about"
  image="/og/pages/about.jpg"
  jsonLd={[localBusiness(Astro.site!, s), breadcrumbs(Astro.site!, crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow={`Since ${s.business.foundedYear} · ${c.locality}, ${c.city}`}
    title="About Virnobyte"
    lede={`A Pune hardware, networking and IT services company that repairs, installs and supports technology for homes and businesses — from a workshop in ${c.locality}.`}
    image="virnobyte-custom-it-solutions-server"
    imageAlt="Server rack with organised network cabling"
  />

  <section class="section">
    <div class="wrap about">
      <div class="prose" data-reveal>
        <h2>Who we are</h2>
        <p>
          {c.legalName} is based at Sadichha Complex on Mahadev Temple Road, Jadhav Wadi, in {c.locality}. We provide computer and laptop repair,
          networking, CCTV installation, printer services, software support, annual maintenance contracts and on-site technical help for
          customers in {c.city} and across Pune.
        </p>
        <p>
          Alongside services, we supply new and refurbished laptops and desktops, printers, CCTV systems, networking equipment, RAM, SSDs,
          UPS units and other hardware — so customers can get advice, equipment and installation from one place.
        </p>
        <h2>Experience</h2>
        <p>
          {years > 0 ? `With more than ${years} years of hands-on work, ` : ''}our technicians have seen most of the ways computers,
          networks and CCTV systems fail. That experience is what lets us diagnose accurately, quote honestly and fix things properly the first time.
        </p>
        <h2>How we work</h2>
        <p>
          Every job starts with a diagnosis. We explain what we found, give you an itemised quote, and begin only after you approve it.
          We use tested components, keep a record of the work, and stay reachable afterwards. That approach is why many customers
          move from one-off repairs to our <a href="/membership">membership card</a> or an <a href="/services/amc-services">IT AMC</a>.
        </p>
        <p class="cert-jump-note">
          <a href="#certificates" class="cert-jump-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <span>View our 6 Government Registrations & Certifications ↓</span>
          </a>
        </p>
      </div>
      <div class="side" data-reveal>
        <div class="card mv">
          <h2>Our mission</h2>
          <p>To deliver reliable, transparent and customer-focused technology solutions through quality service, trusted support and continuous improvement for homes and businesses.</p>
        </div>
        <div class="card mv">
          <h2>Our vision</h2>
          <p>To become a trusted technology partner for homes and businesses by delivering dependable hardware, networking and IT support while continuously improving quality, innovation and long-term value.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow">What guides the work</span>
        <h2>Customer-first, and transparent about it</h2>
      </div>
      <ul class="values">
        {
          VALUES.map((v) => (
            <li data-reveal>
              <h3>{v.t}</h3>
              <p>{v.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Certificates & Accreditations ────────────────────────── -->
  <section class="section cert-section" id="certificates">
    <div class="wrap">
      <div class="section-head cert-head" data-reveal>
        <div class="cert-eyebrow-wrap">
          <span class="cert-pill">Official Accreditations</span>
          <span class="cert-sub-pill">Quality You Can Trust</span>
        </div>
        <h2>Government Registrations & Corporate Certificates</h2>
        <p class="lede">
          Virnobyte Private Limited is an incorporated, government-certified IT company. Every document below reflects our statutory compliance,
          tax registration, and formal recognition under Indian regulatory bodies.
        </p>
      </div>

      <div class="cert-grid">
        {CERTIFICATES.map((cert, index) => (
          <article class="cert-card" data-reveal data-cert-index={index}>
            <div class="cert-thumb-container">
              <img
                src={cert.image}
                alt={`${cert.title} - ${cert.authority}`}
                class="cert-thumbnail"
                loading="lazy"
                width="600"
                height="850"
              />
              <div class="cert-overlay">
                <button
                  type="button"
                  class="cert-trigger-btn"
                  data-open-cert={index}
                  aria-label={`Enlarge ${cert.title}`}
                >
                  <span class="cert-icon-circle">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </span>
                  <span class="cert-trigger-text">Click to Inspect Document</span>
                </button>
              </div>
              <span class="cert-card-badge">{cert.badge}</span>
            </div>

            <div class="cert-details">
              <div class="cert-auth-row">
                <span class="cert-authority">{cert.authority}</span>
                <span class="cert-date">{cert.date}</span>
              </div>
              <h3 class="cert-name">{cert.title}</h3>
              <div class="cert-id-tag">
                <span class="cert-id-label">{cert.regLabel}:</span>
                <code class="cert-id-value">{cert.regNumber}</code>
              </div>
              <p class="cert-summary">{cert.description}</p>
              <div class="cert-card-footer">
                <span class="cert-validity-status">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  {cert.validity}
                </span>
                <button
                  type="button"
                  class="cert-link-btn"
                  data-open-cert={index}
                >
                  Full View ↗
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Accessible Fullscreen Lightbox Modal ─────────────────── -->
  <dialog id="cert-dialog" class="cert-dialog" aria-label="Certificate Full View">
    <div class="cert-dialog-backdrop" data-close-cert></div>
    <div class="cert-dialog-window">
      <header class="cert-dialog-top">
        <div class="cert-dialog-meta">
          <span id="modal-authority" class="cert-modal-eyebrow"></span>
          <h3 id="modal-title" class="cert-modal-title"></h3>
          <p id="modal-details" class="cert-modal-sub"></p>
        </div>
        <div class="cert-dialog-btns">
          <a
            id="modal-download"
            href="#"
            target="_blank"
            class="cert-modal-btn cert-modal-btn--secondary"
            title="Open high resolution image in new tab"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>High-Res</span>
          </a>
          <button
            type="button"
            class="cert-modal-btn cert-modal-btn--close"
            data-close-cert
            aria-label="Close preview"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </header>

      <div class="cert-dialog-stage">
        <button
          type="button"
          class="cert-nav-arrow cert-nav-arrow--prev"
          id="cert-prev"
          aria-label="Previous certificate"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="cert-dialog-img-holder">
          <img id="modal-img" src="" alt="Certificate Document" class="cert-modal-image" />
        </div>

        <button
          type="button"
          class="cert-nav-arrow cert-nav-arrow--next"
          id="cert-next"
          aria-label="Next certificate"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <footer class="cert-dialog-bottom">
        <span id="modal-counter" class="cert-modal-counter">1 of 6</span>
        <span class="cert-modal-hint">Use Left/Right arrows to navigate · Press Esc to close</span>
      </footer>
    </div>
  </dialog>

  <section class="section">
    <div class="wrap split">
      <div class="stack" data-reveal>
        <span class="eyebrow">Technology and services</span>
        <h2>What our team handles</h2>
        <p class="lede">Repairs, installations and ongoing support across {svc.length} service areas:</p>
        <ul class="svc-list">
          {svc.map((x) => <li><a href={`/services/${x.slug}`}>{x.name}</a></li>)}
        </ul>
      </div>
      <div class="stack" data-reveal>
        <span class="eyebrow">Service coverage</span>
        <h2>Where we work</h2>
        <p>
          Walk-in repairs are handled at our {c.locality} workshop. Our technicians visit homes, shops and offices across {c.city}
          and Pune for on-site repairs, installations, networking and AMC visits.
        </p>
        <ul class="ticks">
          {s.business.serviceAreas.map((a) => <li>{a}</li>)}
        </ul>
        <Photo image="virnobyte-wifi-router-setup" alt="Wi-Fi router connected with a network cable during an installation" sizes="(min-width: 1024px) 45vw, 100vw" class="cov-img" />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script is:inline define:vars={{ CERTIFICATES }}>
  const dialog = document.getElementById('cert-dialog');
  const modalImg = document.getElementById('modal-img');
  const modalTitle = document.getElementById('modal-title');
  const modalAuthority = document.getElementById('modal-authority');
  const modalDetails = document.getElementById('modal-details');
  const modalDownload = document.getElementById('modal-download');
  const modalCounter = document.getElementById('modal-counter');
  const prevBtn = document.getElementById('cert-prev');
  const nextBtn = document.getElementById('cert-next');

  let activeIndex = 0;

  function loadCert(idx) {
    activeIndex = (idx + CERTIFICATES.length) % CERTIFICATES.length;
    const cert = CERTIFICATES[activeIndex];
    if (!cert) return;

    modalImg.src = cert.image;
    modalImg.alt = `${cert.title} - ${cert.authority}`;
    modalTitle.textContent = cert.title;
    modalAuthority.textContent = `${cert.authority} • ${cert.subtitle}`;
    modalDetails.textContent = `${cert.regLabel}: ${cert.regNumber}  |  ${cert.validity}`;
    modalDownload.href = cert.image;
    modalCounter.textContent = `${activeIndex + 1} of ${CERTIFICATES.length}`;

    if (dialog && !dialog.open) {
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      document.body.style.overflow = 'hidden';
    }
  }

  function dismissModal() {
    if (dialog) {
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
      document.body.style.overflow = '';
    }
  }

  document.querySelectorAll('[data-open-cert]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const idx = parseInt(btn.getAttribute('data-open-cert'), 10);
      loadCert(isNaN(idx) ? 0 : idx);
    });
  });

  document.querySelectorAll('[data-close-cert]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      dismissModal();
    });
  });

  if (prevBtn) prevBtn.addEventListener('click', () => loadCert(activeIndex - 1));
  if (nextBtn) nextBtn.addEventListener('click', () => loadCert(activeIndex + 1));

  window.addEventListener('keydown', (e) => {
    if (!dialog || !dialog.open) return;
    if (e.key === 'Escape') dismissModal();
    if (e.key === 'ArrowLeft') loadCert(activeIndex - 1);
    if (e.key === 'ArrowRight') loadCert(activeIndex + 1);
  });
</script>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
  }
  .side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .mv {
    display: grid;
    gap: var(--space-3);
  }
  .mv h2 {
    font-size: 1.375rem;
  }
  .mv p {
    color: var(--ink-2);
  }
  .values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .values li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid var(--ink);
  }
  .values p {
    color: var(--ink-2);
  }
  .split {
    display: grid;
    gap: var(--space-7);
  }
  .svc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2 200px;
    column-gap: var(--space-5);
  }
  .svc-list li {
    padding: 6px 0;
    break-inside: avoid;
    border-bottom: 1px solid var(--line);
  }
  .svc-list a {
    text-decoration: none;
    font-weight: 600;
  }
  .svc-list a:hover {
    text-decoration: underline;
  }
  .split :global(.cov-img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-l);
  }

  .cert-jump-note {
    margin-top: var(--space-4);
  }
  .cert-jump-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.6rem 1.1rem;
    border-radius: 9999px;
    background: var(--surface);
    color: var(--accent);
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: 700;
    box-shadow: 0 2px 6px -1px rgb(11 23 36 / 0.08);
    transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
  }
  .cert-jump-btn:hover {
    background: var(--accent-tint);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* ── Certificates Section ───────────────────────────────────── */
  .cert-section {
    background: linear-gradient(180deg, #f0f4f9 0%, #e8eef6 100%);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    position: relative;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .cert-eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }
  .cert-pill {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }
  .cert-sub-pill {
    display: inline-flex;
    align-items: center;
    background: #e0eaf6;
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--line);
  }

  .cert-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    margin-top: var(--space-6);
  }

  .cert-card {
    background: var(--surface);
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    box-shadow: 0 4px 16px -4px rgb(11 23 36 / 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.25s cubic-bezier(0.2, 0, 0, 1), border-color 0.25s ease;
  }
  .cert-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px -8px rgb(11 23 36 / 0.16);
    border-color: var(--accent);
  }

  .cert-thumb-container {
    position: relative;
    background: #eef2f7;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .cert-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1);
  }
  .cert-card:hover .cert-thumbnail {
    transform: scale(1.05);
  }

  .cert-card-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: rgb(11 23 36 / 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1px solid rgb(255 255 255 / 0.15);
    z-index: 2;
  }

  .cert-overlay {
    position: absolute;
    inset: 0;
    background: rgb(11 23 36 / 0.6);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 3;
  }
  .cert-card:hover .cert-overlay {
    opacity: 1;
  }
  .cert-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--surface);
    color: var(--ink);
    border: none;
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
    transform: translateY(8px);
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), background-color 0.2s ease, color 0.2s ease;
  }
  .cert-card:hover .cert-trigger-btn {
    transform: translateY(0);
  }
  .cert-trigger-btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .cert-icon-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cert-details {
    padding: var(--space-5);
    display: flex;
