---
import Admin from '@/layouts/Admin.astro';
import InventoryNav from '@/components/admin/InventoryNav.astro';
import Field from '@/components/Field.astro';
import { all, get, run } from '@/lib/db';
import { num } from '@/lib/format';
import { ago, when } from '@/lib/inventory/format';
import { USABLE_SQL, confirmSourceStock, setStock, removeStockRow, syncProducts } from '@/lib/inventory/stock';
import { issuePortalToken, revokePortal } from '@/lib/inventory/vendor';
import { getPublicOrigin } from '@/lib/commerce/http';

const isNew = Astro.params.id === 'new';
const sid = isNew ? 0 : Number(Astro.params.id);
let src = isNew ? undefined : get<any>('SELECT * FROM inv_sources WHERE id = ?', sid);
if (!isNew && !src) return Astro.redirect('/admin/inventory/sources');
const admin = Astro.locals.user!;
const actor = `Admin: ${admin.name || admin.email}`;
const origin = ['localhost', '127.0.0.1'].includes(Astro.url.hostname) ? Astro.url.origin : getPublicOrigin(Astro);

const listedProductIds = () => all<{ product_id: number }>('SELECT product_id FROM inv_stock WHERE source_id = ?', sid).map((r) => r.product_id);

let flash = Astro.url.searchParams.get('created') ? 'Vendor added. Next step: press “Create Seller Hub link” on the right and send it to them on WhatsApp.' : '';
let error = '';
let portalLink = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '').trim();
  const int = (k: string, def: number) => {
    const v = Math.trunc(Number(str(k)));
    return Number.isFinite(v) && str(k) !== '' ? v : def;
  };
  try {
    switch (str('_action')) {
      case 'details': {
        const own = src?.kind === 'own';
        const name = str('name');
        const email = str('email').toLowerCase();
        const method = own ? 'manual' : str('update_method') === 'manual' ? 'manual' : 'portal';
        if (name.length < 2) throw new Error('Enter the vendor name.');
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error('Check the email address.');
        const vals = [
          name, str('contact_name'), str('phone'), email, str('city'),
          own ? 0 : Math.max(1, int('priority', 10)),
          own ? 1 : f.get('active') === 'on' ? 1 : 0,
          method,
          own ? 0 : Math.max(0, int('stale_hours', 24)), str('notes'),
        ];
        const cols = 'name, contact_name, phone, email, city, priority, active, update_method, stale_hours, notes';
        if (isNew) {
          const res = run(`INSERT INTO inv_sources (kind, ${cols}) VALUES ('vendor', ?,?,?,?,?,?,?,?,?,?)`, ...vals);
          return Astro.redirect(`/admin/inventory/sources/${Number(res.lastInsertRowid)}?created=1`, 303);
        }
        run(`UPDATE inv_sources SET ${cols.split(', ').map((c) => `${c} = ?`).join(', ')} WHERE id = ?`, ...vals, sid);
        // Switching a vendor on/off or changing its freshness rule changes what can be sold
        // (re-sync without marking its stock as freshly confirmed).
        syncProducts(listedProductIds());
        flash = 'Saved.';
        break;
      }
      case 'portal_link':
        portalLink = `${origin}/vendor/access?t=${issuePortalToken(sid)}`;
        flash = 'New Seller Hub link created. Any older link for this vendor has stopped working.';
        break;
      case 'portal_revoke':
        revokePortal(sid);
        flash = 'Seller Hub access removed. The vendor is signed out everywhere.';
        break;
      case 'save_stock': {
        const current = all<{ product_id: number; qty: number; sku: string }>('SELECT product_id, qty, sku FROM inv_stock WHERE source_id = ?', sid);
        const changed = current
          .map((c) => {
            const raw = f.get(`qty_${c.product_id}`);
            if (raw == null) return null;
            const qty = Math.max(0, Math.trunc(Number(String(raw).replace(/[,\s]/g, '')) || 0));
            const sku = str(`sku_${c.product_id}`);
            return qty !== c.qty || sku !== c.sku ? { productId: c.product_id, qty, sku } : null;
          })
          .filter((x): x is { productId: number; qty: number; sku: string } => !!x);
        if (changed.length) setStock(sid, changed, 'SET', actor, str('note'));
        else confirmSourceStock(sid);
        flash = changed.length ? `${changed.length} product${changed.length === 1 ? '' : 's'} updated.` : 'Nothing changed — stock marked as checked.';
        break;
      }
      case 'confirm':
        confirmSourceStock(sid);
        flash = 'Stock confirmed as current.';
        break;
      case 'add_product': {
        const pid = Number(str('product_id'));
        if (!pid) throw new Error('Choose a product.');
        setStock(sid, [{ productId: pid, qty: int('qty', 0), sku: str('sku') }], 'SET', actor, 'Added to source');
        flash = 'Product added.';
        break;
      }
      case 'remove':
        removeStockRow(sid, Number(str('product_id')), actor);
        flash = 'Product removed from this vendor.';
        break;
      case 'delete': {
        if (src?.kind === 'own') throw new Error('Your own stock cannot be deleted.');
        if (get('SELECT 1 FROM inv_allocations WHERE source_id = ? LIMIT 1', sid)) {
          throw new Error('This vendor has order history. Switch it off instead, so past orders keep their records.');
        }
        const ids = listedProductIds();
        run('DELETE FROM inv_sources WHERE id = ?', sid);
        syncProducts(ids);
        return Astro.redirect('/admin/inventory/sources?deleted=1', 303);
      }
    }
  } catch (e: any) {
    error = e.message;
  }
  if (!isNew) src = get<any>('SELECT * FROM inv_sources WHERE id = ?', sid);
}

const s = src ?? { kind: 'vendor', name: '', contact_name: '', phone: '', email: '', city: '', priority: 10, active: 1, update_method: 'portal', stale_hours: 48, notes: '' };
const own = s.kind === 'own';
const usable = !isNew && !!get(`SELECT 1 FROM inv_sources s WHERE s.id = ? AND ${USABLE_SQL}`, sid);
const stock = isNew
  ? []
  : all<any>(
      `SELECT st.*, p.name, p.slug, p.published, COALESCE(ip.tracked, 0) AS tracked,
         (SELECT COALESCE(SUM(a.qty), 0) FROM inv_allocations a WHERE a.source_id = st.source_id AND a.product_id = st.product_id
            AND (a.status IN ('ASSIGNED','ACCEPTED') OR (a.status = 'HELD' AND a.expires_at > datetime('now')))) AS reserved
       FROM inv_stock st JOIN products p ON p.id = st.product_id LEFT JOIN inv_products ip ON ip.product_id = st.product_id
       WHERE st.source_id = ? ORDER BY p.name`,
      sid,
    );
const listed = new Set(stock.map((r) => r.product_id));
const addable = isNew ? [] : all<{ id: number; name: string }>('SELECT id, name FROM products ORDER BY name').filter((p) => !listed.has(p.id));
const openLines = isNew ? 0 : get<{ n: number }>("SELECT COUNT(*) AS n FROM inv_allocations WHERE source_id = ? AND status IN ('ASSIGNED','ACCEPTED')", sid)!.n;
const title = isNew ? 'Add vendor' : s.name;

// One-click sending of a freshly created link: WhatsApp (wa.me) to the vendor's phone, or an email draft.
const invite = portalLink
  ? `Hello ${s.contact_name || s.name}, this is Virnobyte. Here is your private Seller Hub link. Open it to add the products you sell, keep your stock up to date and ship our orders:\n${portalLink}\n\nPlease keep this link private.`
  : '';
const digits = String(s.phone ?? '').replace(/\D/g, '').replace(/^0+/, '');
const waPhone = digits.length === 10 ? `91${digits}` : digits.length >= 11 ? digits : '';
const waUrl = invite && waPhone ? `https://wa.me/${waPhone}?text=${encodeURIComponent(invite)}` : '';
const mailUrl = invite && s.email ? `mailto:${s.email}?subject=${encodeURIComponent('Your Virnobyte Seller Hub link')}&body=${encodeURIComponent(invite)}` : '';
---

<Admin title={title} active="vendors">
  <div class="inv">
    <div class="page-head">
      <div>
        <a href="/admin/inventory/sources" class="back-btn">Vendors</a>
        <h1>{title}</h1>
        {
          !isNew && (
            <p>
              {own
                ? 'Your own stock — always used first.'
                : !s.active
                  ? 'Switched off — nothing is sold from this vendor.'
                  : !stock.length
                    ? 'New vendor — no products yet. Send them their Seller Hub link so they can add what they sell.'
                    : usable
                      ? `Stock confirmed ${ago(s.stock_updated_at)} — being sold.`
                      : `Stock last confirmed ${ago(s.stock_updated_at)} — out of date, so it is not being sold until they confirm.`}
              {openLines > 0 && <> · <a href={`/admin/inventory/fulfilment?source=${sid}`}>{openLines} item{openLines === 1 ? '' : 's'} waiting to ship</a></>}
            </p>
          )
        }
      </div>
    </div>
    <InventoryNav active="sources" />

    {flash && <p class="alert alert--ok" role="status" style="margin-bottom:14px">{flash}</p>}
    {error && <p class="alert alert--error" role="alert" style="margin-bottom:14px">{error}</p>}
    {
      portalLink && (
        <section class="panel" style="border-color:#9fd8bf">
          <h2 style="margin-bottom:8px">Send {s.name} their Seller Hub link</h2>
          <p class="small muted" style="margin-bottom:12px">It is shown only now. Anyone with the link can see this vendor's orders and change its stock, so send it only to them.</p>
          <div class="btn-row" style="margin-bottom:12px">
            {waUrl && (
              <a class="btn" href={waUrl} target="_blank" rel="noopener">Send on WhatsApp</a>
            )}
            {mailUrl && (
              <a class="btn btn--ghost" href={mailUrl}>Send by email</a>
            )}
          </div>
          <div class="link-box">
            <input id="portal-link" readonly value={portalLink} aria-label="Seller Hub link" />
            <button class="btn btn--sm btn--ghost" type="button" data-copy="portal-link">Copy link</button>
          </div>
          {!waUrl && <p class="small muted" style="margin-top:8px">Add the vendor's phone number above to send it on WhatsApp in one click.</p>}
        </section>
      )
    }

    <div class:list={[!isNew && 'split-2']}>
      <section class="panel">
        <h2 style="margin-bottom:12px">{isNew ? 'Vendor details' : 'Details'}</h2>
        <form method="post">
          <input type="hidden" name="_action" value="details" />
          <div class="form-grid">
            <Field class="half" label={own ? 'Name' : 'Vendor / business name'} name="name" required value={s.name} />
            <Field class="half" label="Contact person" name="contact_name" value={s.contact_name} />
            <Field class="half" label="Phone / WhatsApp" name="phone" type="tel" value={s.phone} />
            <Field class="half" label="Email (order emails go here)" name="email" type="email" value={s.email} hint={own ? 'Leave blank to use the business email.' : 'Without an email, order emails come to you instead.'} />
            <Field class="half" label="City" name="city" value={s.city} />
            {!own && <Field class="half" label="Priority (1 = used first)" name="priority" type="number" min={1} step={1} value={s.priority} />}
            {
              !own && (
                <>
                  <Field
                    class="half"
                    label="How this vendor updates stock"
                    name="update_method"
                    type="select"
                    value={s.update_method}
                    options={[
                      { value: 'portal', label: 'Vendor manages it in their Seller Hub' },
                      { value: 'manual', label: 'I update it here' },
                    ]}
                  />
                  <Field class="half" label="Stop selling their stock if not confirmed for (hours)" name="stale_hours" type="number" min={0} step={1} value={s.stale_hours} hint="0 = never goes out of date. 24–48 is safe for most vendors." />
                  <label class="switch"><input type="checkbox" name="active" checked={!!s.active} /> Active (sell this vendor's stock)</label>
                </>
              )
            }
            <Field label="Internal notes" name="notes" type="textarea" rows={2} value={s.notes} />
          </div>
          <button class="btn" type="submit" style="margin-top:14px">{isNew ? 'Add vendor' : 'Save details'}</button>
        </form>
      </section>

      {
        !isNew && (
          <div>
            {!own && (
              <section class="panel">
                <h2 style="margin-bottom:8px">Seller Hub access</h2>
                <p class="small muted" style="margin-bottom:12px">
                  The vendor's own dashboard: orders to ship (no prices), their inventory with + / − stock controls, and packing slips. Opens from a private link — no password needed.
                  {s.portal_token_hash ? ` Link active · last used ${ago(s.portal_last_seen)}.` : ' No link issued yet.'}
                </p>
                <div class="btn-row">
                  <form method="post" data-confirm={s.portal_token_hash ? 'Create a new link? The current link will stop working.' : undefined}>
                    <input type="hidden" name="_action" value="portal_link" />
                    <button class="btn btn--sm" type="submit">{s.portal_token_hash ? 'Create new link' : 'Create Seller Hub link'}</button>
                  </form>
                  {s.portal_token_hash && (
                    <form method="post" data-confirm="Remove Seller Hub access for this vendor?">
                      <input type="hidden" name="_action" value="portal_revoke" />
                      <button class="btn btn--sm btn--ghost" type="submit">Remove access</button>
                    </form>
                  )}
                </div>
              </section>
            )}

          </div>
        )
      }
    </div>

    {
      !isNew && (
        <section class="panel">
          <div class="panel-head">
            <h2>Products &amp; stock at {s.name}</h2>
            <form method="post">
              <input type="hidden" name="_action" value="confirm" />
              <button class="btn btn--sm btn--ghost" type="submit" title="The vendor confirmed every number is still right">Mark stock as checked</button>
            </form>
          </div>
          {stock.length ? (
            <form method="post">
              <input type="hidden" name="_action" value="save_stock" />
              <div class="table-wrap">
                <table class="tbl">
                  <thead>
                    <tr>
                      <th scope="col">Product</th>
                      <th scope="col">Vendor SKU / code</th>
                      <th scope="col" class="num">On hand</th>
                      <th scope="col" class="num">Reserved</th>
                      <th scope="col">Updated</th>
                      <th scope="col"><span class="sr-only">Remove</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {stock.map((r) => (
                      <tr>
                        <td>
                          <a class="row-link" href={`/admin/inventory/products/${r.product_id}`}>{r.name}</a>
                          <div class="small muted">{r.slug}{!r.tracked && ' · not tracked'}{!r.published && ' · hidden'}</div>
                        </td>
                        <td><input class="sku-in" name={`sku_${r.product_id}`} value={r.sku} aria-label={`SKU for ${r.name}`} /></td>
                        <td class="num"><input class="qty-in" type="number" min="0" step="1" name={`qty_${r.product_id}`} value={r.qty} aria-label={`Units of ${r.name}`} /></td>
                        <td class="num">{r.reserved || ''}</td>
                        <td class="small">{when(r.updated_at)}</td>
                        <td><button class="btn btn--sm btn--ghost" type="submit" form={`rm-${r.product_id}`}>Remove</button></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="inline-form" style="margin-top:12px">
                <div class="field">
                  <label for="note">Note for the stock log (optional)</label>
                  <input id="note" name="note" placeholder="e.g. Vendor confirmed on call" />
                </div>
                <button class="btn" type="submit">Save stock</button>
              </div>
            </form>
          ) : (
            <p class="muted">No products yet. Add them below, or the vendor can add them in their Seller Hub.</p>
          )}
          {stock.map((r) => (
            <form method="post" id={`rm-${r.product_id}`} data-confirm={`Remove ${r.name} from ${s.name}?`} hidden>
              <input type="hidden" name="_action" value="remove" />
              <input type="hidden" name="product_id" value={r.product_id} />
            </form>
          ))}
          {addable.length > 0 && (
            <form method="post" class="inline-form" style="margin-top:18px;padding-top:16px;border-top:1px solid var(--line)">
              <input type="hidden" name="_action" value="add_product" />
              <div class="field">
                <label for="ap">Add product</label>
                <select id="ap" name="product_id" required>
                  <option value="">Choose…</option>
                  {addable.map((p) => <option value={p.id}>{p.name}</option>)}
                </select>
              </div>
              <div class="field" style="flex:0 1 120px">
                <label for="aq">Units</label>
                <input id="aq" name="qty" type="number" min="0" step="1" value="0" />
              </div>
              <div class="field">
                <label for="as">Vendor SKU / code</label>
                <input id="as" name="sku" />
              </div>
              <button class="btn btn--ghost" type="submit">Add</button>
            </form>
          )}
          <p class="small muted" style="margin-top:12px">Adding a product here also starts tracking it, so the site follows live stock.</p>
        </section>
      )
    }

    {
      !isNew && !own && (
        <form method="post" data-confirm={`Delete ${s.name}? This cannot be undone.`} style="margin-top:8px">
          <input type="hidden" name="_action" value="delete" />
          <button class="btn btn--danger" type="submit">Delete vendor</button>
        </form>
      )
    }
  </div>
</Admin>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const input = document.getElementById(b.dataset.copy!) as HTMLInputElement | null;
      if (!input) return;
      input.select();
      try {
        await navigator.clipboard.writeText(input.value);
        b.textContent = 'Copied';
      } catch {
        document.execCommand('copy');
      }
    }),
  );
</script>
