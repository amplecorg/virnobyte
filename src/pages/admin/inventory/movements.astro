---
import Admin from '@/layouts/Admin.astro';
import InventoryNav from '@/components/admin/InventoryNav.astro';
import { all } from '@/lib/db';
import { when } from '@/lib/inventory/format';

const sp = Astro.url.searchParams;
const source = Number(sp.get('source')) || 0;
const product = Number(sp.get('product')) || 0;
const kind = sp.get('kind') ?? '';
const KINDS: Record<string, string> = {
  SET: 'Set by admin',
  PORTAL: 'Vendor (seller hub)',
  SHIPPED: 'Shipped to customer',
  RETURNED: 'Returned',
  ADJUST: 'Adjustment',
};

const where: string[] = [];
const params: any[] = [];
if (source) {
  where.push('m.source_id = ?');
  params.push(source);
}
if (product) {
  where.push('m.product_id = ?');
  params.push(product);
}
if (KINDS[kind]) {
  where.push('m.kind = ?');
  params.push(kind);
}
const rows = all<any>(
  `SELECT m.*, s.name AS source_name, p.name AS product_name FROM inv_movements m
   LEFT JOIN inv_sources s ON s.id = m.source_id LEFT JOIN products p ON p.id = m.product_id
   ${where.length ? 'WHERE ' + where.join(' AND ') : ''} ORDER BY m.id DESC LIMIT 400`,
  ...params,
);
const sources = all<{ id: number; name: string }>("SELECT id, name FROM inv_sources ORDER BY CASE kind WHEN 'own' THEN 0 ELSE 1 END, name");
const productName = product ? all<{ name: string }>('SELECT name FROM products WHERE id = ?', product)[0]?.name : '';
const sel = 'min-height:40px;border:1.5px solid var(--line-strong);border-radius:8px;padding:0 8px';
---

<Admin title="Stock history" active="inventory">
  <div class="inv">
    <div class="page-head">
      <div>
        <h1>Stock history</h1>
        <p>Every change to a quantity, who made it and why. Quantities only — no prices.{productName && <> Showing <b>{productName}</b> · <a href="/admin/inventory/movements">all products</a></>}</p>
      </div>
    </div>
    <InventoryNav active="movements" />

    <form method="get" class="toolbar">
      {product > 0 && <input type="hidden" name="product" value={product} />}
      <select name="source" aria-label="Stock with" style={sel}>
        <option value="">Everyone</option>
        {sources.map((s) => <option value={s.id} selected={s.id === source}>{s.name}</option>)}
      </select>
      <select name="kind" aria-label="Type" style={sel}>
        <option value="">All changes</option>
        {Object.entries(KINDS).map(([k, label]) => <option value={k} selected={k === kind}>{label}</option>)}
      </select>
      <button class="btn btn--sm btn--ghost" type="submit">Filter</button>
    </form>

    <div class="table-wrap">
      {
        rows.length ? (
          <table class="tbl">
            <thead>
              <tr>
                <th scope="col">When</th>
                <th scope="col">Product</th>
                <th scope="col">Stock with</th>
                <th scope="col">Change</th>
                <th scope="col" class="num">Units</th>
                <th scope="col" class="num">Now</th>
                <th scope="col">By</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((m) => (
                <tr>
                  <td class="small">{when(m.created_at)}</td>
                  <td><a href={`/admin/inventory/products/${m.product_id}`}>{m.product_name ?? `#${m.product_id}`}</a></td>
                  <td>{m.source_name ?? '—'}</td>
                  <td>
                    {KINDS[m.kind] ?? m.kind}
                    {(m.ref || m.note) && <div class="small muted">{[m.ref, m.note].filter(Boolean).join(' · ')}</div>}
                  </td>
                  <td class="num"><span class={m.delta > 0 ? 'delta-pos' : 'delta-neg'}>{m.delta > 0 ? '+' : '−'}{Math.abs(m.delta)}</span></td>
                  <td class="num">{m.qty_after}</td>
                  <td class="small">{m.actor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="muted" style="padding:16px">No stock changes yet.</p>
        )
      }
    </div>
  </div>
</Admin>
