---
import Admin from '@/layouts/Admin.astro';
import AdminField from '@/components/admin/AdminField.astro';
import MembershipCard from '@/components/MembershipCard.astro';
import Icon from '@/components/Icon.astro';
import { RESOURCES } from '@/lib/admin/resources';
import { parseForm, saveRow, toFormValue } from '@/lib/admin/forms';
import { get, run } from '@/lib/db';

const def = RESOURCES[Astro.params.resource!];
if (!def) return Astro.redirect('/admin');
const isNew = Astro.params.id === 'new';
if (isNew && def.canCreate === false) return Astro.redirect(`/admin/r/${def.key}`);
const id = isNew ? null : Number(Astro.params.id);
let row: Record<string, any> | undefined = id ? get(`SELECT * FROM ${def.table} WHERE id = ?`, id) : {};
if (!row) return Astro.redirect(`/admin/r/${def.key}`);

let errors: Record<string, string> = {};
let values: Record<string, string> = {};

// Defaults for new records
const DEFAULTS: Record<string, any> = {
  published: 1, active: 1, in_stock: 1, sort: 0, validity_days: 365, card_from: '#0f2a4a', card_to: '#2a5d8f', card_text: '#ffffff',
  card_pattern: 'circuit', employment_type: 'FULL_TIME', location: 'Chikhali, Pimpri-Chinchwad', condition: 'New', topic: 'General',
  group_name: 'Repair & support', published_at: new Date().toISOString().slice(0, 10), posted_at: new Date().toISOString().slice(0, 10),
  benefits: '[]', images: '[]', category: def.key === 'projects' ? 'cctv-projects' : '',
  rating: '4.5', rating_count: '128 Ratings & 42 Reviews', badge: 'Assured',
  offer_tag: 'Extra ₹1,000 off with Virnobyte Card',
  warranty: '1 Year Virnobyte Warranty', replacement_policy: '7-Day Replacement Guarantee',
  diagnostic_setup: 'Free On-Site Diagnostic Setup', delivery_text: 'Free Delivery by Tomorrow',
  delivery_sub: 'Doorstep setup & testing in PCMC & Pune',
  wow_deal: 'Exchange Old Laptop / PC & save up to ₹15,000',
};
if (isNew) row = Object.fromEntries(def.fields.map((f) => [f.name, DEFAULTS[f.name] ?? '']));

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('_action') === 'delete' && id && def.canDelete !== false) {
    if (def.key === 'plans' && get('SELECT 1 FROM memberships WHERE plan_id = ?', id)) {
      errors._form = 'Members hold cards on this plan. Turn off "On sale" instead of deleting it.';
    } else {
      run(`DELETE FROM ${def.table} WHERE id = ?`, id);
      return Astro.redirect(`/admin/r/${def.key}?deleted=1`, 303);
    }
  } else {
    const parsed = await parseForm(def, form, id);
    errors = parsed.errors;
    if (!Object.keys(errors).length) {
      const newId = saveRow(def, parsed.row, id);
      return Astro.redirect(form.get('_action') === 'save_close' ? `/admin/r/${def.key}?saved=1` : `/admin/r/${def.key}/${newId}?saved=1`, 303);
    }
    // Re-show what the admin typed.
    for (const f of def.fields) {
      const raw = form.get(f.name);
      values[f.name] = f.type === 'bool' ? (raw === 'on' ? '1' : '0') : typeof raw === 'string' ? raw : toFormValue(f, parsed.row[f.name]);
      if ((f.type === 'image' || f.type === 'images') && parsed.row[f.name]) values[f.name] = parsed.row[f.name];
    }
  }
}
for (const f of def.fields) if (!(f.name in values)) values[f.name] = toFormValue(f, row[f.name]);

const saved = Astro.url.searchParams.get('saved');
const titleField = def.fields.find((f) => ['name', 'title', 'question', 'caption'].includes(f.name));
const heading = isNew ? `New ${def.singular}` : (titleField && row[titleField.name]) || `Edit ${def.singular}`;
const publicUrl = !isNew ? def.publicUrl?.(row) : null;
const isPlan = def.key === 'plans';
let lastSection = '';
---

<Admin title={heading} active={def.key}>
  <div class="page-head">
    <div>
      <a href={`/admin/r/${def.key}`} class="small">← {def.label}</a>
      <h1>{heading}</h1>
    </div>
    {
      publicUrl && (
        <a class="btn btn--ghost" href={publicUrl} target="_blank" rel="noopener">
          View on site <Icon name="external" size={16} />
        </a>
      )
    }
  </div>

  {saved && <p class="alert alert--ok" role="status" style="margin-bottom:14px">Saved. Changes are live on the website.</p>}
  {errors._form && <p class="alert alert--error" role="alert" style="margin-bottom:14px">{errors._form}</p>}
  {Object.keys(errors).filter((k) => k !== '_form').length > 0 && <p class="alert alert--error" role="alert" style="margin-bottom:14px">Some fields need attention — see the messages below.</p>}

  <div class:list={[isPlan && 'split-2']}>
    <form method="post" enctype="multipart/form-data" id="edit-form">
      <div class="panel">
        <div class="form-grid">
          {
            def.fields.map((f) => {
              const showSection = f.section && f.section !== lastSection;
              if (f.section) lastSection = f.section;
              return (
                <>
                  {showSection && <h2 class="section-title">{f.section}</h2>}
                  <AdminField field={f} value={values[f.name] ?? ''} error={errors[f.name]} />
                </>
              );
            })
          }
        </div>
      </div>
      <div class="sticky-actions">
        <div class="btn-row">
          <button class="btn" type="submit" name="_action" value="save">Save</button>
          <button class="btn btn--ghost" type="submit" name="_action" value="save_close">Save and close</button>
        </div>
      </div>
    </form>

    {
      isPlan && (
        <aside class="sticky-col">
          <div class="panel">
            <h2 style="margin-bottom:12px">Card preview</h2>
            <MembershipCard
              live
              planName={values.name || 'Plan'}
              from={values.card_from || '#0f2a4a'}
              to={values.card_to || '#2a5d8f'}
              text={values.card_text || '#ffffff'}
              pattern={values.card_pattern || 'circuit'}
              coins={Number(values.coins) || 0}
              holder="Member name"
            />
            <p class="small muted" style="margin-top:12px">Updates as you edit. Every member card on this plan uses this design.</p>
          </div>
        </aside>
      )
    }
  </div>

  {
    !isNew && def.canDelete !== false && (
      <form method="post" data-confirm={`Delete this ${def.singular}? This cannot be undone.`} style="margin-top:24px">
        <button class="btn btn--danger" type="submit" name="_action" value="delete">Delete {def.singular}</button>
      </form>
    )
  }
</Admin>

{
  isPlan && (
    <script>
      const form = document.getElementById('edit-form') as HTMLFormElement;
      const card = document.querySelector<HTMLElement>('[data-card]');
      const fmt = new Intl.NumberFormat('en-IN');
      const sync = () => {
        if (!card) return;
        const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '';
        card.style.setProperty('--from', v('card_from'));
        card.style.setProperty('--to', v('card_to'));
        card.style.setProperty('--fg', v('card_text'));
        card.className = card.className.replace(/pattern-\w+/, `pattern-${v('card_pattern') || 'circuit'}`);
        const name = card.querySelector('[data-f="name"]');
        if (name) name.textContent = v('name') || 'Plan';
        const coins = card.querySelector('[data-f="coins"]');
        if (coins) coins.textContent = fmt.format(Number(v('coins')) || 0);
      };
      form.addEventListener('input', sync);
      form.addEventListener('change', sync);
    </script>
  )
}
