---
import Admin from '@/layouts/Admin.astro';
import Icon from '@/components/Icon.astro';
import { RESOURCES } from '@/lib/admin/resources';
import FilterBar from '@/components/admin/FilterBar.astro';
import { LIST_LIMIT, filterOptions, listRows, readFilters } from '@/lib/admin/forms';
import { formatDate, inr } from '@/lib/format';

const def = RESOURCES[Astro.params.resource!];
if (!def) return Astro.redirect('/admin');

const sp = Astro.url.searchParams;
const q = sp.get('q')?.trim() ?? '';
const values = readFilters(def, sp);
const sort = sp.get('sort') ?? '';
const { rows, count, total } = listRows(def, q, values, sort);
const filters = (def.filters ?? []).map((f) => (f.type === 'select' ? { ...f, resolvedOptions: filterOptions(def, f) } : f));
const filtered = q || Object.keys(values).length > 0;
const plural = (w: string) => (/[^aeiou]y$/.test(w) ? w.slice(0, -1) + 'ies' : /(s|x|ch|sh)$/.test(w) ? w + 'es' : w + 's');
const saved = Astro.url.searchParams.get('saved');
const deleted = Astro.url.searchParams.get('deleted');
const first = def.columns[0].name;
---

<Admin title={def.label} active={def.key}>
  <div class="page-head">
    <div>
      <h1>{def.label}</h1>
      {def.intro && <p>{def.intro}</p>}
    </div>
    {
      def.canCreate !== false && (
        <a class="btn" href={`/admin/r/${def.key}/new`}>
          <Icon name="plus" /> New {def.singular}
        </a>
      )
    }
  </div>

  {saved && <p class="alert alert--ok" role="status" style="margin-bottom:14px">Saved.</p>}
  {deleted && <p class="alert alert--ok" role="status" style="margin-bottom:14px">Deleted.</p>}

  <FilterBar
    filters={filters}
    values={values}
    q={q}
    sorts={def.sorts}
    sort={sort}
    count={count}
    shown={Math.min(count, LIST_LIMIT)}
    total={def.sumColumn ? total : null}
    noun={plural(def.singular)}
    one={def.singular}
    searchable={!!def.search?.length}
  />

  <div class="table-wrap">
    {
      rows.length ? (
        <table class="tbl">
          <thead>
            <tr>
              {def.columns.map((c) => (
                <th scope="col" class={c.type === 'money' ? 'num' : undefined}>{c.label}</th>
              ))}
              {def.publicUrl && <th scope="col"><span class="sr-only">View</span></th>}
            </tr>
          </thead>
          <tbody>
            {rows.map((r: any) => {
              const url = def.publicUrl?.(r);
              return (
                <tr>
                  {def.columns.map((c) => {
                    const v = r[c.name];
                    const content =
                      c.type === 'bool' ? <span class:list={['pill', v ? 'on' : 'off']}>{v ? 'Yes' : 'No'}</span>
                      : c.type === 'money' ? (v == null ? '—' : inr(v))
                      : c.type === 'date' ? formatDate(v)
                      : c.type === 'status' ? <span class:list={['pill', v]}>{v}</span>
                      : v;
                    return (
                      <td class={c.type === 'money' ? 'num' : undefined}>
                        {c.name === first ? <a class="row-link" href={`/admin/r/${def.key}/${r.id}`}>{content || '(untitled)'}</a> : content}
                      </td>
                    );
                  })}
                  {def.publicUrl && (
                    <td class="num">
                      {url && (
                        <a href={url} target="_blank" rel="noopener" class="small" aria-label="View on site">
                          View <Icon name="external" size={14} />
                        </a>
                      )}
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
      ) : (
        <p class="empty-state">
          {filtered ? <>Nothing matches these filters. <a href={Astro.url.pathname}>Clear filters</a></> : `No ${def.label.toLowerCase()} yet.`}
        </p>
      )
    }
  </div>
</Admin>
