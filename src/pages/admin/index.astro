---
import Admin from '@/layouts/Admin.astro';
import { all, get } from '@/lib/db';
import { getSettings } from '@/lib/settings';
import { formatDate, num } from '@/lib/format';

const s = getSettings();
const n = (sql: string) => get<{ n: number }>(sql)!.n;
const stats = {
  active: n("SELECT COUNT(*) AS n FROM memberships WHERE status = 'active'"),
  pending: n("SELECT COUNT(*) AS n FROM memberships WHERE status = 'pending'"),
  coins: n('SELECT COALESCE(SUM(delta), 0) AS n FROM coin_ledger'),
  newEnq: n("SELECT COUNT(*) AS n FROM enquiries WHERE status = 'new'"),
  enq30: n("SELECT COUNT(*) AS n FROM enquiries WHERE created_at >= datetime('now', '-30 days')"),
  expiring: n("SELECT COUNT(*) AS n FROM memberships WHERE status = 'active' AND end_date <= date('now', '+30 days')"),
};
const pending = all<any>(
  `SELECT m.id, m.card_number, m.created_at, u.id AS uid, u.name, u.phone, p.name AS plan, p.price
   FROM memberships m JOIN users u ON u.id = m.user_id JOIN plans p ON p.id = m.plan_id
   WHERE m.status = 'pending' ORDER BY m.id DESC LIMIT 10`,
);
const enquiries = all<any>("SELECT * FROM enquiries ORDER BY id DESC LIMIT 8");
const expiring = all<any>(
  `SELECT u.id AS uid, u.name, u.phone, m.end_date, p.name AS plan FROM memberships m JOIN users u ON u.id = m.user_id JOIN plans p ON p.id = m.plan_id
   WHERE m.status = 'active' AND m.end_date <= date('now', '+30 days') ORDER BY m.end_date LIMIT 10`,
);
---

<Admin title="Dashboard" active="dashboard">
  <div class="page-head">
    <div>
      <h1>Dashboard</h1>
      <p>Everything that needs a response today.</p>
    </div>
  </div>

  <div class="kpis">
    <a class="kpi" href="/admin/members?status=pending"><span>Cards awaiting activation</span><b>{stats.pending}</b></a>
    <a class="kpi" href="/admin/r/enquiries?status=new"><span>New enquiries</span><b>{stats.newEnq}</b></a>
    <a class="kpi" href="/admin/members?status=active"><span>Active members</span><b>{stats.active}</b></a>
    <div class="kpi"><span>{s.coins.name} outstanding</span><b>{num(stats.coins)}</b></div>
    <div class="kpi"><span>Enquiries, last 30 days</span><b>{stats.enq30}</b></div>
    <div class="kpi"><span>Cards expiring in 30 days</span><b>{stats.expiring}</b></div>
  </div>

  <div class="split-2">
    <section class="panel">
      <div class="panel-head"><h2>Recent enquiries</h2><a href="/admin/r/enquiries" class="small">All enquiries</a></div>
      {
        enquiries.length ? (
          <table class="tbl">
            <thead><tr><th scope="col">Received</th><th scope="col">Name</th><th scope="col">About</th><th scope="col">Status</th></tr></thead>
            <tbody>
              {enquiries.map((e) => (
                <tr>
                  <td>{formatDate(e.created_at)}</td>
                  <td><a class="row-link" href={`/admin/r/enquiries/${e.id}`}>{e.name}</a><div class="small muted">{e.phone}</div></td>
                  <td>{e.topic}{e.kind === 'job' && <span class="pill" style="margin-left:6px">job</span>}</td>
                  <td><span class:list={['pill', e.status]}>{e.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="muted">No enquiries yet. Booking-form submissions appear here.</p>
        )
      }
    </section>

    <div>
      <section class="panel">
        <div class="panel-head"><h2>Cards to activate</h2></div>
        {
          pending.length ? (
            <table class="tbl">
              <tbody>
                {pending.map((p) => (
                  <tr>
                    <td><a class="row-link" href={`/admin/members/${p.uid}`}>{p.name}</a><div class="small muted">{p.phone}</div></td>
                    <td>{p.plan}<div class="small muted">₹{num(p.price)}</div></td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="muted">No pending card requests.</p>
          )
        }
      </section>
      <section class="panel">
        <div class="panel-head"><h2>Renewals due</h2></div>
        {
          expiring.length ? (
            <table class="tbl">
              <tbody>
                {expiring.map((p) => (
                  <tr>
                    <td><a class="row-link" href={`/admin/members/${p.uid}`}>{p.name}</a><div class="small muted">{p.phone}</div></td>
                    <td>{p.plan}<div class="small muted">ends {formatDate(p.end_date)}</div></td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="muted">No cards expire in the next 30 days.</p>
          )
        }
      </section>
    </div>
  </div>
</Admin>
