---
import Auth from '@/layouts/Auth.astro';
import Field from '@/components/Field.astro';
import { authenticate, createSession, rateLimit } from '@/lib/auth';

const next = Astro.url.searchParams.get('next');
const safeNext = next && next.startsWith('/admin') ? next : '/admin';
let error = '';
let email = '';

if (Astro.locals.user?.role === 'admin') return Astro.redirect(safeNext);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  if (!rateLimit(`admin-login:${Astro.clientAddress}`, 8, 15 * 60_000)) {
    error = 'Too many attempts. Wait 15 minutes and try again.';
  } else {
    const user = authenticate(email, String(form.get('password') ?? ''));
    if (!user || user.role !== 'admin') error = 'These details do not match an administrator account.';
    else {
      createSession(Astro.cookies, user.id, Astro.url.protocol === 'https:');
      return Astro.redirect(safeNext, 303);
    }
  }
}
---

<Auth title="Admin sign in | Virnobyte" heading="Admin sign in">
  {error && <p class="alert alert--error" role="alert">{error}</p>}
  <form method="post">
    <Field label="Email" name="email" type="email" required autocomplete="username" value={email} />
    <Field label="Password" name="password" type="password" required autocomplete="current-password" />
    <button class="btn btn--block" type="submit">Sign in</button>
  </form>
</Auth>
