---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import { posts } from '@/lib/data';
import { breadcrumbs, itemList } from '@/lib/schema';
import { formatDate, readingMinutes } from '@/lib/format';
import { getSettings } from '@/lib/settings';

const s = getSettings();
const isAdmin = Astro.locals.user?.role === 'admin';
const list = posts();
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
];
const [lead, ...rest] = list;

// Customizable image ratios from Settings
const leadRatio = s.blog?.leadImageSize === 'natural' ? 'auto' : (s.blog?.leadImageSize || '16/9').replace('/', ' / ');
const leadFit = s.blog?.leadImageSize === 'natural' ? 'contain' : 'cover';
const gridRatio = s.blog?.gridImageSize === 'natural' ? 'auto' : (s.blog?.gridImageSize || '16/10').replace('/', ' / ');
const gridFit = s.blog?.gridImageSize === 'natural' ? 'contain' : 'cover';
---

<Base
  title={`${s.blog?.title || 'IT Tips & Guides for Homes and Businesses'} | Virnobyte Blog`}
  description={s.blog?.lede || "Practical guides on computer and laptop problems, CCTV maintenance, office networks, data recovery and IT AMC from Virnobyte's technicians in Pune."}
  canonical="/blog"
  image="/og/pages/blog.jpg"
  jsonLd={[
    breadcrumbs(Astro.site!, crumbs),
    itemList(Astro.site!, 'Virnobyte IT Guides and Troubleshooting Articles', list.map((p) => ({ name: p.title, url: `/blog/${p.slug}`, description: p.description })))
  ]}
>
  {isAdmin && (
    <div class="admin-blog-toolbar">
      <div class="wrap admin-blog-toolbar-inner">
        <div class="admin-toolbar-status">
          <span class="admin-chip">⚡ Admin Mode</span>
          <span class="admin-toolbar-text">You can edit this page, customize image sizes, and manage all blog content.</span>
        </div>
        <div class="admin-toolbar-actions">
          <a href="/admin/settings#blog" class="admin-btn admin-btn-edit">
            ✏️ Edit Page Content &amp; Image Sizes
          </a>
          <a href="/admin/r/posts/new" class="admin-btn admin-btn-new">
            ➕ New Post
          </a>
          <a href="/admin/r/posts" class="admin-btn admin-btn-manage">
            📂 All Articles ({list.length})
          </a>
        </div>
      </div>
    </div>
  )}

  <PageHero
    crumbs={crumbs}
    eyebrow={s.blog?.eyebrow || 'Guides'}
    title={s.blog?.title || 'Practical IT advice from our workshop'}
    lede={s.blog?.lede || 'What we see every week in Pimpri-Chinchwad and Pune, written up so you can fix, prevent or plan.'}
  />

  <section class="section" style={`--lead-aspect: ${leadRatio}; --lead-fit: ${leadFit}; --grid-aspect: ${gridRatio}; --grid-fit: ${gridFit};`}>
    <div class="wrap">
      {list.length === 0 && <p class="lede">New guides are on the way.</p>}
      {
        lead && (
          <div class="lead-wrapper">
            <a href={`/blog/${lead.slug}`} class="lead" data-reveal>
              <div class="lead-img-box">
                <Photo image={lead.image} alt={lead.title} eager sizes="(min-width: 1024px) 55vw, 100vw" widths={[768, 1080, 1440, 1920]} />
              </div>
              <div class="lead-body">
                <span class="small muted">{formatDate(lead.published_at)} · {readingMinutes(lead.body)} min read</span>
                <h2>{lead.title}</h2>
                <p class="lede">{lead.description}</p>
              </div>
            </a>
            {isAdmin && (
              <a href={`/admin/r/posts/${lead.id}`} class="admin-card-edit-btn" title="Edit this article in Admin">
                ✏️ Edit Article
              </a>
            )}
          </div>
        )
      }
      <ul class="posts">
        {
          rest.map((p) => (
            <li class="post-item" data-reveal>
              <a href={`/blog/${p.slug}`} class="post">
                <div class="post-img-box">
                  <Photo image={p.image} alt={p.title} sizes="(min-width: 1000px) 30vw, 100vw" widths={[480, 768, 1080]} />
                </div>
                <span class="small muted">{formatDate(p.published_at)} · {readingMinutes(p.body)} min read</span>
                <h2 class="h-post">{p.title}</h2>
                <p class="small muted">{p.description}</p>
              </a>
              {isAdmin && (
                <a href={`/admin/r/posts/${p.id}`} class="admin-card-edit-btn" title={`Edit "${p.title}" in Admin`}>
                  ✏️ Edit
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Admin Toolbar on Blog */
  .admin-blog-toolbar {
    background: #0f172a;
    color: #f8fafc;
    border-bottom: 2px solid #3b82f6;
    padding: 10px 0;
    font-size: 13px;
  }
  .admin-blog-toolbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .admin-toolbar-status {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .admin-chip {
    background: #2563eb;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .admin-toolbar-text {
    color: #cbd5e1;
    font-size: 13px;
  }
  .admin-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .admin-btn {
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  .admin-btn-edit {
    background: #3b82f6;
    color: #ffffff;
  }
  .admin-btn-edit:hover {
    background: #1d4ed8;
  }
  .admin-btn-new {
    background: #10b981;
    color: #ffffff;
  }
  .admin-btn-new:hover {
    background: #059669;
  }
  .admin-btn-manage {
    background: #334155;
    color: #f1f5f9;
  }
  .admin-btn-manage:hover {
    background: #475569;
  }

  /* Card Edit Buttons */
  .lead-wrapper,
  .post-item {
    position: relative;
  }
  .admin-card-edit-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(15, 23, 42, 0.88);
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    z-index: 5;
    transition: background 0.15s;
  }
  .admin-card-edit-btn:hover {
    background: #2563eb;
    color: #ffffff;
  }

  .lead {
    display: grid;
    gap: var(--space-5);
    color: inherit;
    text-decoration: none;
    margin-bottom: var(--space-8);
    align-items: center;
  }
  .lead-img-box :global(img) {
    width: 100%;
    aspect-ratio: var(--lead-aspect, 16 / 9);
    object-fit: var(--lead-fit, cover);
    border-radius: var(--radius-l);
  }
  .lead-body {
    display: grid;
    gap: var(--space-3);
  }
  .lead:hover h2,
  .post:hover h2 {
    color: var(--accent);
    text-decoration: underline;
  }
  @media (min-width: 1024px) {
    .lead {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-7);
    }
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-7) var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .post-item {
    display: flex;
    flex-direction: column;
  }
  .post {
    display: grid;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .post-img-box :global(img) {
    width: 100%;
    aspect-ratio: var(--grid-aspect, 16 / 10);
    object-fit: var(--grid-fit, cover);
    border-radius: var(--radius);
  }
  .h-post {
    font-size: 1.25rem;
  }
</style>
