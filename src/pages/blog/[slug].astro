---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { post, posts, services } from '@/lib/data';
import { getSettings } from '@/lib/settings';
import { article, breadcrumbs } from '@/lib/schema';
import { formatDate, markdown, readingMinutes } from '@/lib/format';

const isAdmin = Astro.locals.user?.role === 'admin';
const p = post(Astro.params.slug!, isAdmin);
if (!p) return Astro.rewrite('/404');

const s = getSettings();
const site = Astro.site!;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: p.title, href: `/blog/${p.slug}` },
];
const related = services().filter((x) => p.related.includes(x.slug));
const more = posts(4).filter((x) => x.slug !== p.slug).slice(0, 3);
const og = `/og/posts/${p.slug}.jpg`;

// Customizable image size and fit
const imgSize = p.image_size || '21/9';
let coverAspect = '21 / 9';
let coverMaxHeight = 'none';

if (imgSize === '16/9') {
  coverAspect = '16 / 9';
} else if (imgSize === '16/10') {
  coverAspect = '16 / 10';
} else if (imgSize === '4/3') {
  coverAspect = '4 / 3';
} else if (imgSize === 'natural') {
  coverAspect = 'auto';
  coverMaxHeight = '560px';
} else if (imgSize === 'compact') {
  coverAspect = '21 / 9';
  coverMaxHeight = '320px';
} else if (imgSize === 'large') {
  coverAspect = '16 / 9';
  coverMaxHeight = '560px';
}
const coverFit = imgSize === 'natural' ? (p.image_fit || 'contain') : (p.image_fit || 'cover');
---

<Base
  title={`${p.title} | ${s.business.name}`}
  description={p.description}
  canonical={`/blog/${p.slug}`}
  type="article"
  image={og}
  publishedTime={p.published_at}
  modifiedTime={p.updated_at}
  jsonLd={[article(site, p, new URL(og, site).href), breadcrumbs(site, crumbs)]}
>
  {isAdmin && (
    <div class="admin-article-toolbar">
      <div class="wrap admin-article-toolbar-inner">
        <div class="admin-toolbar-status">
          <span class="admin-chip">⚡ Admin Mode</span>
          <span>Editing article: <strong>{p.title}</strong></span>
          <span class:list={['admin-status-pill', p.published ? 'published' : 'draft']}>
            {p.published ? '● Published' : '○ Draft'}
          </span>
          <span class="admin-size-indicator">Image Size: <strong>{p.image_size || '21/9'}</strong> ({p.image_fit || 'cover'})</span>
        </div>
        <div class="admin-toolbar-actions">
          <a href={`/admin/r/posts/${p.id}`} class="admin-btn admin-btn-edit">
            ✏️ Edit Content &amp; Image Size
          </a>
          <a href="/admin/r/posts/new" class="admin-btn admin-btn-new">
            ➕ New Post
          </a>
          <a href="/admin/r/posts" class="admin-btn admin-btn-manage">
            📂 All Posts
          </a>
        </div>
      </div>
    </div>
  )}

  <article>
    <header class="section--tight head">
      <div class="wrap narrow stack">
        <Breadcrumbs items={crumbs} />
        <h1>{p.title}</h1>
        <p class="lede">{p.description}</p>
        <p class="small muted">
          By {p.author || `the ${s.business.name} team`} · <time datetime={p.published_at}>{formatDate(p.published_at)}</time> · {readingMinutes(p.body)} min read
        </p>
      </div>
      <div class="wrap cover" style={`--cover-aspect: ${coverAspect}; --cover-max-height: ${coverMaxHeight}; --cover-fit: ${coverFit};`}>
        <Photo image={p.image} alt={p.title} eager sizes="(min-width: 1200px) 1100px, 100vw" widths={[768, 1080, 1440, 1920, 2560]} />
      </div>
    </header>

    <div class="section--tight">
      <div class="wrap narrow body">
        <div class="prose" set:html={markdown(p.body)} />

        {
          related.length > 0 && (
            <aside class="card rel" aria-label="Related services">
              <h2>Related services</h2>
              <ul>
                {related.map((r) => (
                  <li>
                    <a href={`/services/${r.slug}`} class="text-link">
                      {r.name} <Icon name="arrow" size={16} />
                    </a>
                    <span class="small muted">{r.short}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section section--white">
        <div class="wrap">
          <h2 class="more-h">More guides</h2>
          <ul class="more">
            {more.map((m) => (
              <li>
                <a href={`/blog/${m.slug}`}>{m.title}</a>
                <span class="small muted">{formatDate(m.published_at)}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</Base>

<style>
  /* Admin Article Toolbar */
  .admin-article-toolbar {
    background: #0f172a;
    color: #f8fafc;
    border-bottom: 2px solid #3b82f6;
    padding: 10px 0;
    font-size: 13px;
  }
  .admin-article-toolbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .admin-toolbar-status {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .admin-chip {
    background: #2563eb;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .admin-status-pill {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 3px;
  }
  .admin-status-pill.published {
    background: #059669;
    color: #ffffff;
  }
  .admin-status-pill.draft {
    background: #d97706;
    color: #ffffff;
  }
  .admin-size-indicator {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 2px 8px;
    border-radius: 4px;
    color: #94a3b8;
    font-size: 11.5px;
  }
  .admin-size-indicator strong {
    color: #60a5fa;
  }
  .admin-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .admin-btn {
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  .admin-btn-edit {
    background: #3b82f6;
    color: #ffffff;
  }
  .admin-btn-edit:hover {
    background: #1d4ed8;
  }
  .admin-btn-new {
    background: #10b981;
    color: #ffffff;
  }
  .admin-btn-new:hover {
    background: #059669;
  }
  .admin-btn-manage {
    background: #334155;
    color: #f1f5f9;
  }
  .admin-btn-manage:hover {
    background: #475569;
  }

  .head {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0;
  }
  .narrow {
    max-width: calc(780px + 2 * var(--gutter));
  }
  .head h1 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
  }
  .cover {
    max-width: calc(1200px + 2 * var(--gutter));
    margin-top: var(--space-7);
    transform: translateY(var(--space-6));
  }
  .cover :global(img) {
    width: 100%;
    aspect-ratio: var(--cover-aspect, 21 / 9);
    max-height: var(--cover-max-height, none);
    object-fit: var(--cover-fit, cover);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow);
  }
  .body {
    padding-top: var(--space-7);
    display: grid;
    gap: var(--space-7);
  }
  .prose {
    font-size: var(--fs-body);
  }
  .rel h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }
  .rel ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .rel li {
    display: grid;
    gap: 2px;
  }
  .more-h {
    margin-bottom: var(--space-5);
  }
  .more {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .more li {
    display: grid;
    gap: 2px;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .more a {
    font-weight: 650;
    font-size: 1.125rem;
  }
</style>
