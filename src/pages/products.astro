---
import { getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { products, type Product } from '@/lib/data';
import { contactInfo } from '@/lib/settings';
import { breadcrumbs, itemList } from '@/lib/schema';
import { resolveImage, PHOTOS } from '@/lib/images';
import { userFromCookies } from '@/lib/auth';

const user = Astro.locals.user || userFromCookies(Astro.cookies);
const c = contactInfo();
const items = products() as Product[];
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products' },
];

// ── Image helpers ────────────────────────────────────────────────
// Library photos are optimised to WebP at card size; uploads are already WebP cut-outs.
type CardImg = { src: string; kind: 'photo' | 'cutout' };
async function img(key: string | undefined, width = 720): Promise<CardImg | null> {
  if (!key) return null;
  const r = resolveImage(key);
  if (r.kind === 'upload') return { src: r.src, kind: 'cutout' };
  const out = await getImage({ src: r.meta, width: Math.min(width, r.meta.width), format: 'webp', quality: 78 });
  return { src: out.src, kind: 'photo' };
}
const imagesOf = (p: Product) => (Array.isArray(p.images) && p.images.length ? p.images : p.image ? [p.image] : []).filter(Boolean);

// ── Formatting ───────────────────────────────────────────────────
const inr = (v: number | null | undefined) =>
  v === null || v === undefined || Number.isNaN(v) ? '' : '₹' + Math.round(v).toLocaleString('en-IN');
const discountOf = (p: Product) => (p.price && p.mrp && p.mrp > p.price ? Math.round(((p.mrp - p.price) / p.mrp) * 100) : 0);
const ratingOf = (p: Product) => {
  const n = parseFloat(p.rating);
  return Number.isFinite(n) && n > 0 ? Math.min(5, n) : 0;
};
const ratingCountOf = (p: Product) => {
  const m = (p.rating_count || '').match(/\d[\d,]*/);
  return m ? m[0] : '';
};
const bulletsOf = (p: Product, n = 3) =>
  (p.summary || '')
    .split('\n')
    .map((l) => l.replace(/^[•\-\s]+/, '').trim())
    .filter(Boolean)
    .slice(0, n);
const buyHref = (slug: string) =>
  user ? `/checkout/${slug}` : `/account/login?next=${encodeURIComponent(`/checkout/${slug}`)}`;

// ── Cards ────────────────────────────────────────────────────────
const cards = await Promise.all(
  items.map(async (p) => {
    const list = imagesOf(p);
    const [a, b] = await Promise.all([img(list[0]), img(list[1])]);
    return {
      p,
      main: a ?? (await img('virnobyte-hardware-solutions')),
      alt: b,
      discount: discountOf(p),
      rating: ratingOf(p),
      ratingCount: ratingCountOf(p),
      bullets: bulletsOf(p),
      buyable: !!(p.price && p.in_stock),
    };
  }),
);

// ── Categories (from the live catalogue, so nothing links to an empty shelf) ──
const catNames = [...new Set(items.map((p) => p.category).filter(Boolean))];
const categories = await Promise.all(
  catNames.map(async (name) => {
    const inCat = cards.filter((x) => x.p.category === name);
    const cover = inCat.find((x) => x.main)?.main ?? null;
    return { name, count: inCat.length, cover };
  }),
);
categories.sort((a, b) => b.count - a.count);

// ── Hero: the featured PC plus the deepest current deal ──
const featured = cards.find((x) => x.p.category === 'Desktops' && x.p.price) ?? cards.find((x) => x.p.price) ?? cards[0];
const bestDeal = [...cards].filter((x) => x !== featured && x.discount).sort((a, b) => b.discount - a.discount)[0];
const heroImg = featured
  ? await img(imagesOf(featured.p)[0], 1600)
  : null;
const builderImg = await getImage({ src: PHOTOS['virnobyte-build-08-rgb-gaming-pc'], width: 900, format: 'webp', quality: 75 });

const prices = items.map((p) => p.price || 0).filter(Boolean);
const PRICE_BANDS = [
  { id: 'all', label: 'Any price', min: 0, max: Infinity },
  { id: 'u5', label: 'Under ₹5,000', min: 0, max: 5000 },
  { id: '5-20', label: '₹5,000 – ₹20,000', min: 5000, max: 20000 },
  { id: '20-50', label: '₹20,000 – ₹50,000', min: 20000, max: 50000 },
  { id: 'o50', label: 'Above ₹50,000', min: 50000, max: Infinity },
].map((b) => ({ ...b, count: b.id === 'all' ? items.length : prices.filter((v) => v >= b.min && v < b.max).length }));
---

<Base
  title="IT Hardware, Laptops & Computer Products in Pune | Virnobyte"
  description="Shop certified laptops, custom PCs, CCTV kits, SSDs, RAM upgrades, routers, and power backup from Virnobyte in Chikhali, Pune. Doorstep delivery, warranty and installation."
  canonical="/products"
  image="/og/pages/products.jpg"
  jsonLd={[
    breadcrumbs(Astro.site!, crumbs),
    itemList(Astro.site!, 'Virnobyte Certified Hardware Catalog', items.map((it) => ({ name: it.name, url: `/products/${it.slug}`, description: it.summary })))
  ]}
>
  <div class="store">
    <!-- ── Hero ───────────────────────────────────────────── -->
    <section class="st-hero">
      <div class="wrap">
        <div class="st-crumbs"><Breadcrumbs items={crumbs} /></div>
        <div class="st-hero-grid">
          {
            featured && (
              <a class="st-feature" href={`/products/${featured.p.slug}`}>
                <div class="st-feature-copy">
                  <span class="st-kicker">Featured build</span>
                  <h1>
                    The Virnobyte store
                    <span>{featured.p.name}</span>
                  </h1>
                  <ul class="st-feature-specs">
                    {featured.bullets.slice(0, 3).map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                  <div class="st-feature-price">
                    <strong>{inr(featured.p.price)}</strong>
                    {featured.discount > 0 && (
                      <>
                        <s>{inr(featured.p.mrp)}</s>
                        <span class="st-save">{featured.discount}% off</span>
                      </>
                    )}
                  </div>
                  <span class="st-feature-cta">
                    Shop now <Icon name="arrow" size={18} />
                  </span>
                </div>
                {heroImg && (
                  <div class="st-feature-media">
                    <img src={heroImg.src} alt="" loading="eager" fetchpriority="high" decoding="async" />
                  </div>
                )}
              </a>
            )
          }
          <div class="st-promos">
            {
              bestDeal && (
                <a class="st-promo st-promo--deal" href={`/products/${bestDeal.p.slug}`}>
                  <div>
                    <span class="st-kicker">Deal of the week</span>
                    <h2>{bestDeal.p.name}</h2>
                    <p class="st-promo-price">
                      <strong>{inr(bestDeal.p.price)}</strong> <span class="st-save">-{bestDeal.discount}%</span>
                    </p>
                  </div>
                  {bestDeal.main && (
                    <img
                      src={bestDeal.main.src}
                      alt=""
                      class:list={['st-promo-img', bestDeal.main.kind]}
                      loading="eager"
                      decoding="async"
                    />
                  )}
                </a>
              )
            }
            <a class="st-promo st-promo--build" href="/custom-pc-builder">
              <img src={builderImg.src} alt="" class="st-promo-bg" loading="eager" decoding="async" />
              <div>
                <span class="st-kicker">PC Builder</span>
                <h2>Design your own PC</h2>
                <p>Pick every part. We assemble, stress-test and deliver.</p>
              </div>
              <span class="st-round"><Icon name="arrow" size={18} /></span>
            </a>
          </div>
        </div>

        <ul class="st-perks">
          <li><Icon name="shield" size={18} /> <span><strong>Genuine hardware</strong> with invoice</span></li>
          <li><Icon name="clock" size={18} /> <span><strong>7-day</strong> replacement</span></li>
          <li><Icon name="wrench" size={18} /> <span><strong>Free setup</strong> in {c.locality} &amp; Pune</span></li>
          <li><Icon name="receipt" size={18} /> <span><strong>Secure checkout</strong> &amp; GST bill</span></li>
        </ul>
      </div>
    </section>

    <!-- ── Category tiles ─────────────────────────────────── -->
    <section class="st-cats wrap" aria-labelledby="st-cats-h">
      <h2 id="st-cats-h" class="st-section-title">Shop by category</h2>
      <div class="st-cat-row" role="list">
        <button type="button" class="st-cat on" data-cat-tile="" role="listitem" aria-pressed="true">
          <span class="st-cat-media st-cat-media--all"><Icon name="dashboard" size={26} /></span>
          <span class="st-cat-name">Everything</span>
          <span class="st-cat-count">{items.length} items</span>
        </button>
        {
          categories.map((cat) => (
            <button type="button" class="st-cat" data-cat-tile={cat.name} role="listitem" aria-pressed="false">
              <span class:list={['st-cat-media', cat.cover?.kind]}>
                {cat.cover && <img src={cat.cover.src} alt="" loading="lazy" decoding="async" />}
              </span>
              <span class="st-cat-name">{cat.name}</span>
              <span class="st-cat-count">
                {cat.count} item{cat.count === 1 ? '' : 's'}
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <!-- ── Catalogue ──────────────────────────────────────── -->
    <section class="st-catalog wrap" aria-labelledby="st-title">
      <aside class="st-filters" id="st-filters" aria-label="Filters" data-filters>
        <div class="st-filters-head">
          <h2>Filters</h2>
          <button type="button" class="st-link" data-reset>Clear all</button>
          <button type="button" class="st-close" data-filters-close aria-label="Close filters"><Icon name="close" size={20} /></button>
        </div>

        <fieldset class="st-fs">
          <legend>Category</legend>
          {
            categories.map((cat) => (
              <label class="st-check">
                <input type="checkbox" name="cat" value={cat.name} />
                <span class="st-box" />
                <span class="st-check-label">{cat.name}</span>
                <span class="st-check-count">{cat.count}</span>
              </label>
            ))
          }
        </fieldset>

        <fieldset class="st-fs">
          <legend>Price</legend>
          {
            PRICE_BANDS.map((b, i) => (
              <label class="st-check st-radio">
                <input type="radio" name="price" value={b.id} data-min={b.min} data-max={b.max === Infinity ? '' : b.max} checked={i === 0} />
                <span class="st-box" />
                <span class="st-check-label">{b.label}</span>
                <span class="st-check-count">{b.count}</span>
              </label>
            ))
          }
        </fieldset>

        <fieldset class="st-fs">
          <legend>Availability &amp; offers</legend>
          <label class="st-switch">
            <input type="checkbox" name="stock" />
            <span class="st-track"><span /></span>
            In stock only
          </label>
          <label class="st-switch">
            <input type="checkbox" name="deal" />
            <span class="st-track"><span /></span>
            30% off or more
          </label>
          <label class="st-switch">
            <input type="checkbox" name="refurb" />
            <span class="st-track"><span /></span>
            Certified refurbished
          </label>
        </fieldset>

        <div class="st-help">
          <Icon name="message" size={20} />
          <div>
            <strong>Not sure what to buy?</strong>
            <p>Tell us your budget — an engineer will suggest the right part.</p>
            <a href={c.whatsapp ?? '/contact'} rel="noopener">Ask on WhatsApp</a>
          </div>
        </div>

        <button type="button" class="st-apply" data-filters-close>Show <span data-count-inline>{items.length}</span> products</button>
      </aside>
      <div class="st-scrim" data-filters-close></div>

      <div class="st-main">
        <div class="st-toolbar" data-toolbar>
          <div class="st-search">
            <Icon name="search" size={18} />
            <input type="search" id="st-q" placeholder="Search laptops, SSDs, CCTV kits…" aria-label="Search products" autocomplete="off" />
            <kbd aria-hidden="true">/</kbd>
          </div>
          <button type="button" class="st-filter-btn" data-filters-open aria-controls="st-filters">
            <Icon name="settings" size={17} /> Filters <span class="st-badge" data-active-n hidden>0</span>
          </button>
          <label class="st-sort">
            <span>Sort</span>
            <select id="st-sort" aria-label="Sort products">
              <option value="featured">Featured</option>
              <option value="price-low">Price: low to high</option>
              <option value="price-high">Price: high to low</option>
              <option value="discount">Biggest discount</option>
              <option value="rating">Top rated</option>
            </select>
          </label>
          <div class="st-view" role="group" aria-label="Layout">
            <button type="button" class="on" data-view="grid" aria-pressed="true" aria-label="Grid view">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            </button>
            <button type="button" data-view="list" aria-pressed="false" aria-label="List view">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="6" height="6" rx="1.5" /><rect x="3" y="14" width="6" height="6" rx="1.5" /><path d="M13 6h8M13 9h5M13 16h8M13 19h5" /></svg>
            </button>
          </div>
        </div>

        <div class="st-meta">
          <h2 id="st-title" data-title>All products</h2>
          <p><span data-count>{items.length}</span> results</p>
          <div class="st-chips" data-chips></div>
        </div>

        <ul class="st-grid" data-grid>
          {
            cards.map((x, i) => (
              <li
                class="st-card"
                data-card
                data-name={`${x.p.name} ${x.p.category} ${x.bullets.join(' ')}`.toLowerCase()}
                data-cat={x.p.category}
                data-price={x.p.price || 0}
                data-discount={x.discount}
                data-rating={x.rating}
                data-stock={x.p.in_stock ? 1 : 0}
                data-cond={(x.p.condition || '').toLowerCase()}
                data-order={i}
              >
                <a href={`/products/${x.p.slug}`} class="st-card-media" aria-label={x.p.name}>
                  {x.main && (
                    <img
                      src={x.main.src}
                      alt={x.p.name}
                      class:list={['st-img', x.main.kind]}
                      loading={i < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  )}
                  {x.alt && <img src={x.alt.src} alt="" class:list={['st-img st-img--alt', x.alt.kind]} loading="lazy" decoding="async" />}
                  <span class="st-tags">
                    {x.discount > 0 && <span class="st-tag st-tag--off">-{x.discount}%</span>}
                    {x.p.condition === 'Refurbished' && <span class="st-tag st-tag--refurb">Refurbished</span>}
                    {x.p.badge && x.p.badge !== 'Assured' && <span class="st-tag">{x.p.badge}</span>}
                  </span>
                </a>

                <div class="st-card-body">
                  <p class="st-card-cat">
                    {x.p.category}
                    {x.p.badge === 'Assured' && (
                      <span class="st-assured" title="Tested and certified by Virnobyte">
                        <Icon name="shield" size={12} /> Assured
                      </span>
                    )}
                  </p>
                  <h3 class="st-card-title">
                    <a href={`/products/${x.p.slug}`}>{x.p.name}</a>
                  </h3>
                  {x.rating > 0 && (
                    <p class="st-rating" aria-label={`Rated ${x.rating} out of 5`}>
                      <span class="st-stars" style={`--rating:${x.rating}`} aria-hidden="true" />
                      <span>{x.rating.toFixed(1)}</span>
                      {x.ratingCount && <span class="st-muted">({x.ratingCount})</span>}
                    </p>
                  )}
                  {x.bullets.length > 0 && (
                    <ul class="st-bullets">
                      {x.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                  <div class="st-price">
                    {x.p.price ? (
                      <>
                        <strong>{inr(x.p.price)}</strong>
                        {x.discount > 0 && <s>{inr(x.p.mrp)}</s>}
                        {x.discount > 0 && x.p.mrp && x.p.price && <span class="st-saving">Save {inr(x.p.mrp - x.p.price)}</span>}
                      </>
                    ) : (
                      <strong class="st-ask">Price on request</strong>
                    )}
                  </div>
                  <p class:list={['st-stock', { out: !x.p.in_stock }]}>
                    <span class="st-dot" />
                    {x.p.in_stock ? x.p.delivery_text || 'In stock' : 'Out of stock'}
                    {x.p.warranty && <span class="st-muted"> · {x.p.warranty}</span>}
                  </p>
                  <div class="st-actions">
                    {x.buyable ? (
                      <>
                        <button type="button" class="st-btn st-btn--cart" data-add-to-cart={x.p.slug}>
                          <Icon name="cart" size={17} />
                          <span data-label>Add to cart</span>
                        </button>
                        <a class="st-btn st-btn--buy" href={buyHref(x.p.slug)}>
                          Buy now
                        </a>
                      </>
                    ) : (
                      <a class="st-btn st-btn--cart" href={x.p.price ? `/products/${x.p.slug}` : '/contact'}>
                        {x.p.price ? 'View details' : 'Ask for price'}
                      </a>
                    )}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="st-empty" data-empty hidden>
          <Icon name="search" size={34} />
          <h3>No products match</h3>
          <p>Try a different word, or clear the filters to see everything.</p>
          <button type="button" class="st-btn st-btn--cart" data-reset>Clear filters</button>
        </div>

        <a class="st-builder-band" href="/custom-pc-builder">
          <div>
            <span class="st-kicker">Can’t find the exact spec?</span>
            <h2>Build a PC around your work, game or budget</h2>
          </div>
          <span class="st-round st-round--light"><Icon name="arrow" size={20} /></span>
        </a>
      </div>
    </section>
  </div>

  <CtaBand
    heading="Need a customized system or special IT hardware?"
    text="Tell our PCMC engineers your requirements. We source, benchmark, install, and support laptops, servers, and networks."
  />
</Base>

<script>
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];

  const grid = $('[data-grid]')!;
  const cards = $$('[data-card]', grid);
  const q = $<HTMLInputElement>('#st-q')!;
  const sort = $<HTMLSelectElement>('#st-sort')!;
  const panel = $('[data-filters]')!;
  const catBoxes = $$<HTMLInputElement>('input[name="cat"]', panel);
  const priceRadios = $$<HTMLInputElement>('input[name="price"]', panel);
  const stock = $<HTMLInputElement>('input[name="stock"]', panel)!;
  const deal = $<HTMLInputElement>('input[name="deal"]', panel)!;
  const refurb = $<HTMLInputElement>('input[name="refurb"]', panel)!;
  const tiles = $$<HTMLButtonElement>('[data-cat-tile]');
  const chips = $('[data-chips]')!;
  const countEls = [$('[data-count]'), $('[data-count-inline]')];
  const activeN = $('[data-active-n]')!;
  const title = $('[data-title]')!;
  const empty = $('[data-empty]')!;

  const state = () => {
    const cats = catBoxes.filter((b) => b.checked).map((b) => b.value);
    const band = priceRadios.find((r) => r.checked)!;
    return {
      q: q.value.trim().toLowerCase(),
      cats,
      band,
      min: Number(band.dataset.min) || 0,
      max: band.dataset.max ? Number(band.dataset.max) : Infinity,
      stock: stock.checked,
      deal: deal.checked,
      refurb: refurb.checked,
      sort: sort.value,
    };
  };

  const chip = (label: string, clear: () => void) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'st-chip';
    b.innerHTML = `<span></span><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 6l12 12M18 6L6 18"/></svg>`;
    b.querySelector('span')!.textContent = label;
    b.setAttribute('aria-label', `Remove filter: ${label}`);
    b.addEventListener('click', () => {
      clear();
      apply();
    });
    chips.appendChild(b);
  };

  function apply(push = true) {
    const s = state();
    let n = 0;
    for (const c of cards) {
      const d = c.dataset;
      const price = Number(d.price) || 0;
      const ok =
        (!s.q || (d.name || '').includes(s.q)) &&
        (!s.cats.length || s.cats.includes(d.cat || '')) &&
        (s.band.value === 'all' || (price >= s.min && price < s.max && price > 0)) &&
        (!s.stock || d.stock === '1') &&
        (!s.deal || Number(d.discount) >= 30) &&
        (!s.refurb || d.cond === 'refurbished');
      c.hidden = !ok;
      if (ok) n++;
    }

    const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      featured: (a, b) => Number(a.dataset.order) - Number(b.dataset.order),
      'price-low': (a, b) => (Number(a.dataset.price) || 1e12) - (Number(b.dataset.price) || 1e12),
      'price-high': (a, b) => Number(b.dataset.price) - Number(a.dataset.price),
      discount: (a, b) => Number(b.dataset.discount) - Number(a.dataset.discount),
      rating: (a, b) => Number(b.dataset.rating) - Number(a.dataset.rating),
    };
    [...cards].sort(by[s.sort] || by.featured).forEach((c) => grid.appendChild(c));

    countEls.forEach((el) => el && (el.textContent = String(n)));
    empty.hidden = n > 0;
    title.textContent = s.q ? `Results for “${q.value.trim()}”` : s.cats.length === 1 ? s.cats[0] : 'All products';

    // Category tiles mirror the checkbox state.
    tiles.forEach((t) => {
      const v = t.dataset.catTile || '';
      const on = v ? s.cats.length === 1 && s.cats[0] === v : s.cats.length === 0;
      t.classList.toggle('on', on);
      t.setAttribute('aria-pressed', String(on));
    });

    // Active-filter chips
    chips.textContent = '';
    s.cats.forEach((cat) => chip(cat, () => (catBoxes.find((b) => b.value === cat)!.checked = false)));
    if (s.band.value !== 'all') chip(s.band.nextElementSibling?.nextElementSibling?.textContent || 'Price', () => (priceRadios[0].checked = true));
    if (s.stock) chip('In stock', () => (stock.checked = false));
    if (s.deal) chip('30%+ off', () => (deal.checked = false));
    if (s.refurb) chip('Refurbished', () => (refurb.checked = false));
    const active = s.cats.length + (s.band.value !== 'all' ? 1 : 0) + +s.stock + +s.deal + +s.refurb;
    activeN.textContent = String(active);
    activeN.hidden = !active;

    if (push) {
      const u = new URL(location.href);
      u.search = '';
      if (s.q) u.searchParams.set('q', q.value.trim());
      s.cats.forEach((cat) => u.searchParams.append('cat', cat));
      if (s.band.value !== 'all') u.searchParams.set('price', s.band.value);
      if (s.sort !== 'featured') u.searchParams.set('sort', s.sort);
      history.replaceState(null, '', u);
    }
  }

  function reset() {
    q.value = '';
    catBoxes.forEach((b) => (b.checked = false));
    priceRadios[0].checked = true;
    stock.checked = deal.checked = refurb.checked = false;
    sort.value = 'featured';
    apply();
  }

  // Restore from the URL (e.g. /products?cat=Desktops from the home page).
  const params = new URL(location.href).searchParams;
  q.value = params.get('q') || '';
  const want = params.getAll('cat').map((v) => v.toLowerCase());
  catBoxes.forEach((b) => (b.checked = want.includes(b.value.toLowerCase())));
  const band = priceRadios.find((r) => r.value === params.get('price'));
  if (band) band.checked = true;
  if (params.get('sort')) sort.value = params.get('sort')!;
  apply(false);

  let t: number | undefined;
  q.addEventListener('input', () => {
    clearTimeout(t);
    t = window.setTimeout(apply, 120);
  });
  sort.addEventListener('change', () => apply());
  panel.addEventListener('change', () => apply());
  $$('[data-reset]').forEach((b) => b.addEventListener('click', reset));

  tiles.forEach((tile) =>
    tile.addEventListener('click', () => {
      const v = tile.dataset.catTile || '';
      catBoxes.forEach((b) => (b.checked = b.value === v));
      apply();
      $('[data-toolbar]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  // "/" focuses search, like most modern stores.
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement)) {
      e.preventDefault();
      q.focus();
    }
  });

  // Grid / list view, remembered per visitor.
  const viewBtns = $$<HTMLButtonElement>('[data-view]');
  const setView = (v: string) => {
    grid.classList.toggle('is-list', v === 'list');
    viewBtns.forEach((b) => {
      const on = b.dataset.view === v;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    try {
      localStorage.setItem('vb_store_view', v);
    } catch {}
  };
  viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view || 'grid')));
  try {
    const saved = localStorage.getItem('vb_store_view');
    if (saved) setView(saved);
  } catch {}

  // Mobile filter drawer
  const open = () => {
    document.documentElement.classList.add('st-drawer-open');
    panel.querySelector<HTMLElement>('input')?.focus();
  };
  const close = () => document.documentElement.classList.remove('st-drawer-open');
  $$('[data-filters-open]').forEach((b) => b.addEventListener('click', open));
  $$('[data-filters-close]').forEach((b) => b.addEventListener('click', close));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
</script>

