---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { products, type Product } from '@/lib/data';
import { contactInfo } from '@/lib/settings';
import { breadcrumbs } from '@/lib/schema';
import { inr } from '@/lib/format';
import { resolveImage } from '@/lib/images';

const c = contactInfo();
const items = products() as Product[];
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products' },
];

// Helper to pre-resolve image URLs for clean client-side swapping
function getPhotoUrls(images: string[]) {
  if (!images || !images.length) return [];
  return images.map((imgKey) => {
    const res = resolveImage(imgKey);
    return res.kind === 'upload' ? res.src : res.meta.src;
  });
}

// Parse multiline summary into neat Flipkart-style specifications
function parseSpecs(summary: string) {
  if (!summary) return [];
  return summary
    .split('\n')
    .map((s) => s.trim().replace(/^[•\-\*]\s*/, ''))
    .filter(Boolean);
}

// Calculate discount percentage
function getDiscount(price: number | null, mrp: number | null) {
  if (!price || !mrp || mrp <= price) return null;
  return Math.round(((mrp - price) / mrp) * 100);
}

// Get categories for quick filter pills
const categories = ['All', ...new Set(items.map((p) => p.category as string))];
---

<Base
  title="IT Hardware, Laptops & Computer Products in Pune | Virnobyte"
  description="Shop certified laptops, custom PCs, CCTV kits, SSDs, RAM upgrades, routers, and power backup from Virnobyte in Chikhali, Pune. Doorstep delivery, warranty and installation."
  canonical="/products"
  image="/og/pages/products.jpg"
  jsonLd={breadcrumbs(Astro.site!, crumbs)}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Virnobyte Assured Tech Store"
    title="IT Hardware & Certified Products"
    lede={`Browse our verified laptops, custom gaming & office PCs, CCTV security kits, SSDs and networking gear. Tested by engineers, backed by local warranty and doorstep setup across ${c.locality} & Pune.`}
  />

  <section class="section fk-store-section">
    <div class="wrap">
      {/* ── Flipkart Toolbar: Search, Category Pills & Sort ── */}
      <div class="fk-toolbar">
        <div class="fk-search-box" style="position: relative; display: flex; align-items: center; width: 100%;">
          <span class="fk-search-icon-wrap" aria-hidden="true" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); display: inline-flex; align-items: center; justify-content: center; pointer-events: none; z-index: 2; width: 18px; height: 18px; color: #878787;">
            <Icon name="search" size={18} />
          </span>
          <input
            type="search"
            id="fk-product-search"
            placeholder="Search laptops, SSDs, CCTV kits, desktop PCs..."
            aria-label="Search products"
          />
          <button type="button" id="fk-search-clear" class="fk-search-clear" aria-label="Clear search" style="display:none;">✕</button>
        </div>

        <div class="fk-filter-pills" role="tablist" aria-label="Filter by category">
          {
            categories.map((cat, i) => (
              <button
                type="button"
                class:list={['fk-pill', { active: i === 0 }]}
                data-filter-cat={cat}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                {cat}
                {cat === 'All' ? ` (${items.length})` : ''}
              </button>
            ))
          }
        </div>

        <div class="fk-sort-bar">
          <span class="fk-sort-label">Sort By:</span>
          <div class="fk-sort-options">
            <button type="button" class="fk-sort-btn active" data-sort="relevance">Popularity</button>
            <button type="button" class="fk-sort-btn" data-sort="price-low">Price — Low to High</button>
            <button type="button" class="fk-sort-btn" data-sort="price-high">Price — High to Low</button>
            <button type="button" class="fk-sort-btn" data-sort="discount">Biggest Discount</button>
          </div>
        </div>
      </div>

      {/* ── Unified Flipkart Product Listing (No Category Headings) ── */}
      <div class="fk-products-container" id="fk-products-container">
        <div class="fk-products-list" id="fk-products-list">
          {
            items.map((p) => {
              const rawList = Array.isArray(p.images) && p.images.length ? p.images : (p.image ? [p.image] : []);
              const resolvedPhotos = getPhotoUrls(rawList);
              const photoUrls = resolvedPhotos.length ? resolvedPhotos : ['/virnobyte-circuit-board.webp'];
              const hasMultiple = photoUrls.length > 1;
              const specs = parseSpecs(p.summary);
              const discount = getDiscount(p.price, p.mrp);

              return (
                <article
                  class="fk-card"
                  data-product-card
                  data-name={p.name.toLowerCase()}
                  data-category={p.category}
                  data-price={p.price || 0}
                  data-discount={discount || 0}
                  data-id={p.id}
                >
                  {/* Column 1: Media Gallery & Badges */}
                  <div class="fk-col-media">
                    <div
                      class="fk-media-box"
                      data-prod-gallery
                      data-photos={JSON.stringify(photoUrls)}
                      data-name={p.name}
                    >
                      <a href={`/products/${p.slug}`} class="fk-img-anchor" aria-label={`View ${p.name}`}>
                        <img
                          src={photoUrls[0]}
                          alt={p.name}
                          class="fk-main-img"
                          loading="lazy"
                          decoding="async"
                        />
                      </a>

                      {discount && (
                        <div class="fk-discount-badge">
                          <span>↓ {discount}% OFF</span>
                        </div>
                      )}

                      {p.badge && (
                        <div class="fk-assured-badge" title={`Virnobyte ${p.badge} - 100% Genuine & Tested`}>
                          <span class="fk-assured-tick">✓</span>
                          <span class="fk-assured-text">{p.badge}</span>
                        </div>
                      )}

                      {hasMultiple && (
                        <>
                          <button type="button" class="fk-nav-btn fk-prev-btn" aria-label="Previous photo">‹</button>
                          <button type="button" class="fk-nav-btn fk-next-btn" aria-label="Next photo">›</button>
                          <span class="fk-counter-badge">
                            <span class="active-num">1</span>/{photoUrls.length}
                          </span>
                        </>
                      )}

                      <button type="button" class="fk-wishlist-btn" aria-label="Save to wishlist" title="Wishlist">
                        ♥
                      </button>
                    </div>

                    {/* Thumbnail Strip */}
                    {hasMultiple && (
                      <div class="fk-thumb-strip" aria-label="Product photos">
                        {photoUrls.slice(0, 6).map((url, idx) => (
                          <button
                            type="button"
                            class:list={['fk-thumb-btn', { active: idx === 0 }]}
                            data-index={idx}
                            aria-label={`View photo ${idx + 1}`}
                          >
                            <img src={url} alt="" loading="lazy" />
                          </button>
                        ))}
                        {photoUrls.length > 6 && (
                          <a href={`/products/${p.slug}`} class="fk-thumb-more" title="View all photos">
                            +{photoUrls.length - 6}
                          </a>
                        )}
                      </div>
                    )}
                  </div>

                  {/* Column 2: Product Title, Rating & Sorted Specs Summary */}
                  <div class="fk-col-info">
                    <div class="fk-badges-row">
                      <span class:list={['fk-condition-tag', { refurbished: p.condition === 'Refurbished' }]}>
                        {p.condition === 'Refurbished' ? 'Certified Refurbished (Grade A++)' : 'Brand New Sealed'}
                      </span>
                      {p.in_stock ? (
                        <span class="fk-stock-tag in-stock">In Stock • Fast Dispatch</span>
                      ) : (
                        <span class="fk-stock-tag on-order">On Order</span>
                      )}
                    </div>

                    <h2 class="fk-title">
                      <a href={`/products/${p.slug}`}>{p.name}</a>
                    </h2>

                    <div class="fk-rating-row">
                      <div class="fk-rating-pill">
                        <span>{p.rating || '4.5'}</span>
                        <span class="fk-star">★</span>
                      </div>
                      <span class="fk-rating-count">{p.rating_count || '128 Ratings & 42 Reviews'}</span>
                    </div>

                    {/* Sorted Specifications Bullet List */}
                    <ul class="fk-specs-list">
                      {specs.length > 0 ? (
                        specs.map((spec) => (
                          <li>
                            <span class="fk-bullet">•</span>
                            <span class="fk-spec-item">{spec}</span>
                          </li>
                        ))
                      ) : (
                        <li>
                          <span class="fk-bullet">•</span>
                          <span class="fk-spec-item">{p.summary || 'Certified genuine hardware inspected by Virnobyte technicians.'}</span>
                        </li>
                      )}
                    </ul>

                    <div class="fk-trust-row">
                      {p.warranty && (
                        <span class="fk-trust-item">
                          <Icon name="shield" size={14} />
                          <span>{p.warranty}</span>
                        </span>
                      )}
                      {p.replacement_policy && (
                        <span class="fk-trust-item">
                          <Icon name="clock" size={14} />
                          <span>{p.replacement_policy}</span>
                        </span>
                      )}
                      {p.diagnostic_setup && (
                        <span class="fk-trust-item">
                          <Icon name="wrench" size={14} />
                          <span>{p.diagnostic_setup}</span>
                        </span>
                      )}
                    </div>
                  </div>

                  {/* Column 3: Flipkart Price Block & Fast Order CTA */}
                  <div class="fk-col-price">
                    <div class="fk-price-block">
                      <div class="fk-price-main">
                        {p.price ? (
                          <span class="fk-current-price">{inr(p.price)}</span>
                        ) : (
                          <span class="fk-ask-price">Ask for Price</span>
                        )}
                        {p.mrp && p.price && p.mrp > p.price && (
                          <span class="fk-mrp-price">{inr(p.mrp)}</span>
                        )}
                        {discount && (
                          <span class="fk-discount-green">{discount}% off</span>
                        )}
                      </div>

                      <div class="fk-special-tag">
                        <span>Special Price</span>
                      </div>

                      {p.offer_tag && (
                        <p class="fk-offer-text">
                          🏷️ <strong>{p.offer_tag}</strong>
                        </p>
                      )}

                      <div class="fk-delivery-text">
                        <strong>{p.delivery_text || 'Free Delivery by Tomorrow'}</strong>
                        <span>{p.delivery_sub || 'Doorstep setup & testing in PCMC & Pune'}</span>
                      </div>
                    </div>

                    <div class="fk-actions-block">
                      {p.price ? (
                        <a href={`/checkout/${p.slug}`} class="fk-btn-buynow">
                          <span>⚡ Buy Now</span>
                        </a>
                      ) : null}
                      <a
                        class="fk-btn-whatsapp"
                        href={c.whatsappUrl(`Hi ${c.name}, I want to buy / enquire about: ${p.name} (Code: ${p.slug}, Price: ${p.price ? inr(p.price) : 'Best Price'}). Is it available?`)}
                        target="_blank"
                        rel="noopener"
                      >
                        <Icon name="whatsapp" size={18} />
                        <span>Enquire on WhatsApp</span>
                      </a>

                      <a href={`/products/${p.slug}`} class="fk-btn-details">
                        <span>View Full Specs &amp; Photos →</span>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>

        {/* Empty Search Result Fallback */}
        <div id="fk-no-results" class="fk-no-results" style="display: none;">
          <div class="fk-no-results-box">
            <Icon name="search" size={40} />
            <h3>No products found</h3>
            <p>Try searching with another keyword or select "All" from the category filters.</p>
            <button type="button" class="btn btn--ghost" id="fk-reset-filters">Reset Filters</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Need a customized system or special IT hardware?"
    text="Tell our PCMC engineers your requirements. We source, benchmark, install, and support laptops, servers, and networks."
  />
</Base>

<style>
  .fk-store-section {
    padding-top: var(--space-5);
    padding-bottom: var(--space-9);
    background: #f1f3f6; /* Classic Flipkart background tone */
  }

  /* ── Flipkart Toolbar: Search, Pills & Sort ───────────────── */
  .fk-toolbar {
    background: #ffffff;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 20px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fk-search-box {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }
  .fk-search-icon-wrap {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #878787;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
    width: 18px;
    height: 18px;
  }
  .fk-search-icon-wrap :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    stroke: currentColor;
  }
  .fk-search-box input {
    width: 100%;
    padding: 12px 38px 12px 42px;
    border-radius: 6px;
    border: 1px solid #dcdcdc;
    font-size: 15px;
    background: #f9f9f9;
    color: #212121;
    transition: all 0.2s ease;
    box-sizing: border-box;
    line-height: 1.4;
  }
  .fk-search-box input:focus {
    background: #ffffff;
    border-color: #2874f0;
    box-shadow: 0 0 0 3px rgba(40, 116, 240, 0.15);
    outline: none;
  }
  .fk-search-clear {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: #e0e0e0;
    color: #616161;
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    font-size: 12px;
    font-weight: 700;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    z-index: 2;
  }
  .fk-search-clear:hover {
    background: #bdbdbd;
    color: #212121;
  }

  .fk-filter-pills {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }
  .fk-pill {
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid #dcdcdc;
    background: #ffffff;
    color: #212121;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }
  .fk-pill:hover {
    border-color: #2874f0;
    color: #2874f0;
  }
  .fk-pill.active {
    background: #2874f0;
    color: #ffffff;
    border-color: #2874f0;
    box-shadow: 0 2px 6px rgba(40, 116, 240, 0.3);
  }

  .fk-sort-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid #f0f0f0;
    padding-top: 12px;
    flex-wrap: wrap;
  }
  .fk-sort-label {
    font-size: 13px;
    font-weight: 700;
    color: #212121;
  }
  .fk-sort-options {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .fk-sort-btn {
    border: none;
    background: none;
    font-size: 13px;
    color: #878787;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .fk-sort-btn:hover {
    color: #2874f0;
  }
  .fk-sort-btn.active {
    color: #2874f0;
    font-weight: 700;
    border-bottom: 2px solid #2874f0;
    border-radius: 0;
  }

  /* ── Flipkart Card Container ───────────────────────────────── */
  .fk-products-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fk-card {
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    display: grid;
    grid-template-columns: 280px 1fr 260px;
    gap: 24px;
    padding: 22px;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    box-sizing: border-box;
  }
  .fk-card:hover {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
    border-color: #c4d7f5;
    transform: translateY(-2px);
  }

  /* ── Column 1: Media & Gallery ─────────────────────────────── */
  .fk-col-media {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }
  .fk-media-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #fbfbfb;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #f0f0f0;
  }
  .fk-img-anchor {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .fk-main-img {
    max-width: 95%;
    max-height: 95%;
    object-fit: contain;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0.2, 1), opacity 0.2s ease;
  }
  .fk-media-box:hover .fk-main-img {
    transform: scale(1.08);
  }

  .fk-discount-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #388e3c;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    z-index: 2;
  }
  .fk-assured-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: #0284c7;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    z-index: 2;
  }
  .fk-assured-tick {
    font-size: 10px;
  }
  .fk-wishlist-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    color: #c2c2c2;
    font-size: 16px;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.15s ease;
    z-index: 2;
  }
  .fk-wishlist-btn:hover,
  .fk-wishlist-btn.active {
    color: #ff4343;
    border-color: #ff4343;
    background: #fff0f0;
  }
  .fk-counter-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 999px;
    z-index: 2;
  }

  .fk-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #dcdcdc;
    font-size: 18px;
    line-height: 1;
    display: grid;
    place-items: center;
    color: #212121;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, background-color 0.15s;
    z-index: 3;
  }
  .fk-media-box:hover .fk-nav-btn {
    opacity: 1;
  }
  .fk-nav-btn:hover {
    background: #2874f0;
    color: #ffffff;
    border-color: #2874f0;
  }
  .fk-prev-btn { left: 6px; }
  .fk-next-btn { right: 6px; }

  /* Thumbnails */
  .fk-thumb-strip {
    display: flex;
    gap: 6px;
    width: 100%;
    overflow-x: auto;
    padding-bottom: 2px;
  }
  .fk-thumb-btn {
    flex: 0 0 40px;
    height: 34px;
    border-radius: 4px;
    border: 1.5px solid #e0e0e0;
    background: #ffffff;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    opacity: 0.7;
    transition: all 0.15s ease;
  }
  .fk-thumb-btn:hover,
  .fk-thumb-btn.active {
    opacity: 1;
    border-color: #2874f0;
    box-shadow: 0 2px 5px rgba(40, 116, 240, 0.25);
  }
  .fk-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .fk-thumb-more {
    flex: 0 0 34px;
    height: 34px;
    border-radius: 4px;
    background: #f0f0f0;
    color: #878787;
    font-size: 11px;
    font-weight: 700;
    display: grid;
    place-items: center;
    text-decoration: none;
  }

  /* ── Column 2: Product Info & Sorted Specs ─────────────────── */
  .fk-col-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fk-badges-row {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .fk-condition-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    background: #e8f5e9;
    color: #2e7d32;
  }
  .fk-condition-tag.refurbished {
    background: #e0f2fe;
    color: #0369a1;
  }
  .fk-stock-tag {
    font-size: 11px;
    font-weight: 600;
    color: #388e3c;
  }
  .fk-stock-tag.on-order {
    color: #d97706;
  }

  .fk-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .fk-title a {
    color: #212121;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .fk-title a:hover {
    color: #2874f0;
  }

  .fk-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .fk-rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: #388e3c;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
  }
  .fk-star {
    font-size: 11px;
  }
