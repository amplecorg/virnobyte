<script>
  // ── Flipkart Real-time Filter, Search & Sort Controller ──────
  const searchInput = document.getElementById('fk-product-search') as HTMLInputElement | null;
  const pillBtns = document.querySelectorAll<HTMLButtonElement>('.fk-pill');
  const sortBtns = document.querySelectorAll<HTMLButtonElement>('.fk-sort-btn');
  const cardsContainer = document.getElementById('fk-products-list');
  const noResultsBox = document.getElementById('fk-no-results');
  const resetBtn = document.getElementById('fk-reset-filters');

  let activeCategory = 'All';
  let searchQuery = '';
  let activeSort = 'relevance';

  const applyFiltersAndSort = () => {
    if (!cardsContainer) return;
    const cards = Array.from(cardsContainer.querySelectorAll<HTMLElement>('[data-product-card]'));
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const category = card.dataset.category || '';
      const matchesCat = activeCategory === 'All' || category.toLowerCase() === activeCategory.toLowerCase();
      const matchesSearch = !searchQuery || name.includes(searchQuery) || category.toLowerCase().includes(searchQuery);

      if (matchesCat && matchesSearch) {
        card.style.display = 'grid';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Sort visible cards
    const visibleCards = cards.filter((c) => c.style.display !== 'none');
    visibleCards.sort((a, b) => {
      const priceA = Number(a.dataset.price) || 0;
      const priceB = Number(b.dataset.price) || 0;
      const discountA = Number(a.dataset.discount) || 0;
      const discountB = Number(b.dataset.discount) || 0;
      const idA = Number(a.dataset.id) || 0;
      const idB = Number(b.dataset.id) || 0;

      if (activeSort === 'price-low') return priceA - priceB;
      if (activeSort === 'price-high') return priceB - priceA;
      if (activeSort === 'discount') return discountB - discountA;
      return idA - idB; // Default relevance
    });

    visibleCards.forEach((c) => cardsContainer.appendChild(c));

    if (noResultsBox) {
      noResultsBox.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  };

  const searchClear = document.getElementById('fk-search-clear');

  // Search Listener
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    if (searchClear) searchClear.style.display = searchQuery ? 'grid' : 'none';
    applyFiltersAndSort();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    if (searchClear) searchClear.style.display = 'none';
    applyFiltersAndSort();
    searchInput?.focus();
  });

  // Category Pills Listener
  pillBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      pillBtns.forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.dataset.filterCat || 'All';
      applyFiltersAndSort();
    });
  });

  // Sort Options Listener
  sortBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sortBtns.forEach((s) => s.classList.remove('active'));
      btn.classList.add('active');
      activeSort = btn.dataset.sort || 'relevance';
      applyFiltersAndSort();
    });
  });

  // Reset Button
  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'All';
    activeSort = 'relevance';
    pillBtns.forEach((p, idx) => p.classList.toggle('active', idx === 0));
    sortBtns.forEach((s, idx) => s.classList.toggle('active', idx === 0));
    applyFiltersAndSort();
  });

  // ── Wishlist Toggle ─────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.fk-wishlist-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      btn.classList.toggle('active');
    });
  });

  // ── Multi-photo Thumbnail Switcher on Hover & Click ─────────
  document.querySelectorAll<HTMLElement>('[data-product-card]').forEach((card) => {
    let photos: string[] = [];
    const mediaBox = card.querySelector<HTMLElement>('[data-prod-gallery]');
    try {
      photos = JSON.parse(mediaBox?.dataset.photos || '[]');
    } catch {
      photos = [];
    }
    if (photos.length <= 1) return;

    let currentIndex = 0;
    const mainImg = card.querySelector<HTMLImageElement>('.fk-main-img');
    const counter = card.querySelector<HTMLElement>('.fk-counter-badge .active-num');
    const prevBtn = card.querySelector<HTMLButtonElement>('.fk-prev-btn');
    const nextBtn = card.querySelector<HTMLButtonElement>('.fk-next-btn');
    const thumbBtns = card.querySelectorAll<HTMLButtonElement>('.fk-thumb-btn');

    const updatePhoto = (index: number) => {
      currentIndex = (index + photos.length) % photos.length;
      if (mainImg) {
        mainImg.src = photos[currentIndex];
      }
      if (counter) {
        counter.textContent = String(currentIndex + 1);
      }
      thumbBtns.forEach((b, idx) => {
        b.classList.toggle('active', idx === currentIndex);
      });
    };

    if (prevBtn) {
      prevBtn.onclick = (e) => {
        e.stopPropagation();
        e.preventDefault();
        updatePhoto(currentIndex - 1);
      };
    }
    if (nextBtn) {
      nextBtn.onclick = (e) => {
        e.stopPropagation();
        e.preventDefault();
        updatePhoto(currentIndex + 1);
      };
    }

    thumbBtns.forEach((b) => {
      b.onclick = (e) => {
        e.stopPropagation();
        e.preventDefault();
        const idx = Number(b.dataset.index) || 0;
        updatePhoto(idx);
      };
      b.onmouseenter = (e) => {
        e.stopPropagation();
        const idx = Number(b.dataset.index) || 0;
        updatePhoto(idx);
      };
    });
  });
</script>
