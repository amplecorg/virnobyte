---
// Buy Now: checkout for a single product, without touching the cart.
import Base from '@/layouts/Base.astro';
import CheckoutView from '@/components/shop/CheckoutView.astro';
import { product } from '@/lib/data';
import { buildLine, viewOf } from '@/lib/commerce/cart';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/account/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`, 302);
}

const p = product(String(Astro.params.slug || ''));
if (!p) return Astro.redirect('/products', 302);

const view = viewOf(null, [buildLine(p, Number(Astro.url.searchParams.get('qty')) || 1)]);
// Out of stock or price on request: send the shopper back to the product page.
if (!view.totals.itemCount) return Astro.redirect(`/products/${p.slug}`, 302);
---

<Base
  title={`Checkout: ${p.name} | Virnobyte Secure Order`}
  description={`Order ${p.name} online with secure UPI, card or NetBanking payment, or Cash on Delivery.`}
  canonical={`/checkout/${p.slug}`}
  noindex
>
  <CheckoutView lines={view.lines} totals={view.totals} mode="buy" slug={p.slug} />
</Base>
