---
// Cart checkout. Old links of the form /checkout?product=<slug> still go to Buy Now.
import Base from '@/layouts/Base.astro';
import CheckoutView from '@/components/shop/CheckoutView.astro';
import { getCart } from '@/lib/commerce/cart';
import { userFromCookies } from '@/lib/auth';

const user = Astro.locals.user || userFromCookies(Astro.cookies);
if (!user) {
  return Astro.redirect(`/account/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`, 302);
}

const prod = Astro.url.searchParams.get('product') || Astro.url.searchParams.get('slug');
if (prod) return Astro.redirect(`/checkout/${encodeURIComponent(prod)}`, 302);

const secure = Astro.url.protocol === 'https:' || Astro.request.headers.get('x-forwarded-proto') === 'https';
const view = getCart(Astro.cookies, user, secure);
if (!view.totals.itemCount) return Astro.redirect('/cart', 302);
---

<Base title="Checkout | Virnobyte Secure Order" description="Enter your delivery address and pay securely to complete your Virnobyte order." canonical="/checkout" noindex>
  <CheckoutView lines={view.lines} totals={view.totals} mode="cart" />
</Base>
