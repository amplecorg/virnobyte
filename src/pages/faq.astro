---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { allFaqs, services } from '@/lib/data';
import { breadcrumbs, faqPage } from '@/lib/schema';

const general = allFaqs();
const topics = [...new Set(general.map((f) => f.topic))];
const anchor = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-');
const serviceFaqs = services()
  .map((s) => ({ ...s, own: s.faqs.filter((f) => !general.some((g) => g.question === f.q)) }))
  .filter((s) => s.own.length);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'FAQ', href: '/faq' },
];
// Every question in the schema is rendered visibly below.
const visible = [...general.map((f) => ({ q: f.question, a: f.answer })), ...serviceFaqs.flatMap((s) => s.own)];
---

<Base
  title="IT Services FAQ | Computer Repair, CCTV & AMC | Virnobyte"
  description="Answers about computer and laptop repair costs, doorstep service, CCTV installation, networking, data recovery, IT AMC and membership cards at Virnobyte in Pune."
  canonical="/faq"
  jsonLd={[breadcrumbs(Astro.site!, crumbs), faqPage(visible)]}
>
  <PageHero crumbs={crumbs} eyebrow="Help" title="Frequently asked questions" lede="Straight answers about how we work, what to expect, and how to get help quickly." />
  <section class="section">
    <div class="wrap faq-page">
      <nav class="toc" aria-label="FAQ topics">
        <p class="eyebrow">Topics</p>
        <ul>
          {topics.map((t) => <li><a href={`#${anchor(t)}`}>{t}</a></li>)}
          <li><a href="#by-service">By service</a></li>
        </ul>
      </nav>
      <div class="groups">
        {
          topics.map((t) => (
            <section id={anchor(t)} data-reveal>
              <h2>{t}</h2>
              <FaqList faqs={general.filter((f) => f.topic === t).map((f) => ({ q: f.question, a: f.answer }))} />
            </section>
          ))
        }
        <section id="by-service">
          <h2>By service</h2>
          {
            serviceFaqs.map((s) => (
              <div class="svc" data-reveal>
                <h3><a href={`/services/${s.slug}`}>{s.name}</a></h3>
                <FaqList faqs={s.own} />
              </div>
            ))
          }
        </section>
      </div>
    </div>
  </section>
  <CtaBand heading="Still have a question?" text="Call or WhatsApp us and a technician will answer directly." />
</Base>

<style>
  .faq-page {
    display: grid;
    gap: var(--space-7);
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .toc a {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--ink);
  }
  .groups {
    display: grid;
    gap: var(--space-8);
  }
  .groups h2 {
    margin-bottom: var(--space-4);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .svc {
    margin-top: var(--space-6);
  }
  .svc h3 {
    margin-bottom: var(--space-2);
  }
  @media (min-width: 1100px) {
    .faq-page {
      grid-template-columns: 240px minmax(0, 860px);
      gap: var(--space-8);
    }
    .toc {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      align-self: start;
    }
    .toc ul {
      flex-direction: column;
    }
  }
</style>
