---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { product, products, type Product } from '@/lib/data';
import { contactInfo } from '@/lib/settings';
import { inr } from '@/lib/format';
import { resolveImage } from '@/lib/images';
import { productNode, breadcrumbs } from '@/lib/schema';

const { slug } = Astro.params;
const p = product(slug as string) as Product | undefined;

if (!p) {
  return Astro.redirect('/products', 302);
}

const c = contactInfo();
const allProducts = products() as Product[];

// Helper to resolve images
function getPhotoUrls(images: string[]) {
  if (!images || !images.length) return [];
  return images.map((imgKey) => {
    const res = resolveImage(imgKey);
    return res.kind === 'upload' ? res.src : res.meta.src;
  });
}

// Suggestions: prioritize products from the same category, followed by other catalog products
const sameCategory = allProducts.filter((item) => item.id !== p.id && item.category === p.category);
const otherProducts = allProducts.filter((item) => item.id !== p.id && item.category !== p.category);
const suggestions = [...sameCategory, ...otherProducts];

// Format price like Amazon India (e.g. ₹109.00 or ₹24,990.00)
function formatAmzPrice(price: number | null) {
  if (!price) return null;
  return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(price);
}

// Amazon star rating generator
function getAmzStars(ratingStr?: string | null) {
  const val = parseFloat(ratingStr || '4.2');
  const full = Math.floor(val);
  const half = val % 1 >= 0.3;
  let s = '★'.repeat(full);
  if (half && s.length < 5) s += '★';
  while (s.length < 5) s += '☆';
  return s.slice(0, 5);
}

// Amazon review count extractor
function getAmzCount(countStr?: string | null) {
  if (!countStr) return '128';
  const m = countStr.match(/\d[\d,]*/);
  return m ? m[0] : '128';
}

// Formatted delivery date matching Amazon format (e.g. "Wednesday, November 11")
function getAmzDeliveryDate() {
  const d = new Date();
  d.setDate(d.getDate() + 2);
  return d.toLocaleDateString('en-IN', { weekday: 'long', month: 'long', day: 'numeric' });
}
const amzDeliveryDate = getAmzDeliveryDate();

// Helper to resolve card images
function getCardImage(prod: Product) {
  const list = Array.isArray(prod.images) && prod.images.length ? prod.images : (prod.image ? [prod.image] : []);
  const resolved = getPhotoUrls(list);
  return resolved.length ? resolved[0] : '/virnobyte-circuit-board.webp';
}

// Helper to calculate discount percentage
function calcDiscount(price: number | null, mrp: number | null) {
  if (!price || !mrp || mrp <= price) return null;
  return Math.round(((mrp - price) / mrp) * 100);
}

const rawList = Array.isArray(p.images) && p.images.length ? p.images : (p.image ? [p.image] : []);
const resolvedPhotos = getPhotoUrls(rawList);
const photoUrls = resolvedPhotos.length ? resolvedPhotos : ['/virnobyte-circuit-board.webp'];
const hasMultiple = photoUrls.length > 1;

// Parse multiline summary into specifications
function parseSpecs(summary: string) {
  if (!summary) return [];
  return summary
    .split('\n')
    .map((s) => s.trim().replace(/^[•\-\*]\s*/, ''))
    .filter(Boolean);
}
const specs = parseSpecs(p.summary);

// Discount calculation
const discount = p.price && p.mrp && p.mrp > p.price ? Math.round(((p.mrp - p.price) / p.mrp) * 100) : null;

// Helper to parse custom badge prefix like [Special Offer] or default to given label
function parseBadge(text: string, defaultBadge: string) {
  const m = (text || '').match(/^\[(.*?)\]\s*(.*)$/);
  if (m) return { badge: m[1], text: m[2] };
  return { badge: defaultBadge, text };
}

// Format secondary perk under price (Image 1 line 2)
function formatPerk(text: string) {
  if (!text) return '';
  const trimmed = text.trim();
  if (trimmed.startsWith('+')) return trimmed;
  const hasIncluded = trimmed.toLowerCase().includes('included');
  return `+ ${trimmed}${hasIncluded ? '' : ' Included'}`;
}

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products' },
  { name: p.category, href: `/products#${p.category.toLowerCase().replace(/[^a-z]+/g, '-')}` },
  { name: p.name, href: `/products/${p.slug}` },
];
---

<Base
  title={`${p.name} | Virnobyte Pune`}
  description={`${p.name} - ${p.summary ? p.summary.slice(0, 150) : 'Supplied, tested, and backed by local warranty from Virnobyte in Chikhali, Pune.'}`}
  canonical={`/products/${p.slug}`}
  image={photoUrls[0]}
  jsonLd={[productNode(Astro.site || Astro.url.origin, p), breadcrumbs(Astro.site || Astro.url.origin, crumbs)]}
>
  <div class="fk-detail-page">
    <div class="wrap">
      {/* ── Flipkart Breadcrumbs ─────────────────────────────── */}
      <nav class="fk-detail-crumbs" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="fk-sep">/</span>
        <a href="/products">Products</a>
        <span class="fk-sep">/</span>
        <a href="/products">{p.category}</a>
        <span class="fk-sep">/</span>
        <span class="fk-current-crumb">{p.name}</span>
      </nav>

      {/* ── Flipkart Two-Column Product Layout ───────────────── */}
      <div class="fk-detail-grid">
        {/* Left Column: Sticky Gallery & Action Buttons */}
        <div class="fk-detail-left">
          <div class="fk-gallery-wrapper">
            {/* Main Stage with Zoom Loupe */}
            <div class="fk-detail-stage" id="fk-detail-stage">
              <img
                id="fk-detail-main-img"
                class="fk-detail-main-img"
                src={photoUrls[0]}
                alt={p.name}
              />

              {discount && (
                <div class="fk-detail-discount-badge">
                  <span>↓ {discount}% OFF</span>
                </div>
              )}

              <button type="button" class="fk-detail-wishlist" id="fk-wishlist-toggle" aria-label="Wishlist">
                ♥
              </button>

              <div class="fk-trust-shield-pill">
                <span class="fk-shield-icon">🛡️</span>
                <span>{p.badge ? `Virnobyte • ${p.badge}` : 'Trust Shield • Verified'}</span>
              </div>

              {hasMultiple && (
                <span class="fk-detail-counter">
                  <span id="fk-counter-active">1</span> / {photoUrls.length}
                </span>
              )}

              <div class="fk-zoom-hint">
                <Icon name="search" size={13} />
                <span>Hover to inspect • Click for full screen</span>
              </div>
            </div>

            {/* Thumbnail Strip */}
            {hasMultiple && (
              <div class="fk-detail-thumbs" id="fk-detail-thumbs" aria-label="Product thumbnails">
                {photoUrls.map((url, idx) => (
                  <button
                    type="button"
                    class:list={['fk-detail-thumb-btn', { active: idx === 0 }]}
                    data-index={idx}
                    aria-label={`View photo ${idx + 1}`}
                  >
                    <img src={url} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>

          {/* Sticky Bottom Action CTA Buttons */}
          <div class="fk-detail-actions">
            {p.price ? (
              <a class="fk-action-btn fk-btn-buy" href={`/checkout/${p.slug}`}>
                <span>⚡ Buy Now</span>
              </a>
            ) : null}

            <a class="fk-action-btn fk-btn-call" href={c.tel}>
              <Icon name="phone" size={18} />
              <span>Call Technician: {c.phone}</span>
            </a>
          </div>
        </div>

        {/* Right Column: Title, Ratings, Price, Offers & Sorted Specs */}
        <div class="fk-detail-right">
          <div class="fk-brand-line">
            <span class="fk-brand-tag">Visit {p.category} Store</span>
            <span class="fk-sku-pill">ID: {p.slug}</span>
          </div>

          <h1 class="fk-detail-title">{p.name}</h1>

          {/* Ratings & Reviews Pill */}
          <div class="fk-detail-rating-row">
            <div class="fk-rating-pill-green">
              <span>{p.rating || '4.5'}</span>
              <span class="fk-star-icon">★</span>
            </div>
            <span class="fk-rating-text">{p.rating_count || '128 Ratings & 42 Customer Reviews'}</span>
            <span class="fk-sep-dot">•</span>
            <span class="fk-assured-tag">✓ Virnobyte {p.badge || 'Assured'}</span>
          </div>

          {/* Flipkart Price Box */}
          <div class="fk-detail-price-box">
            <div class="fk-price-row">
              {discount && <span class="fk-discount-pill">↓ {discount}%</span>}
              {p.mrp && p.price && p.mrp > p.price && (
                <span class="fk-mrp-crossed">{inr(p.mrp)}</span>
              )}
              {p.price ? (
                <span class="fk-final-price">{inr(p.price)}</span>
              ) : (
                <span class="fk-final-price ask">Ask for Price</span>
              )}
            </div>

            {/* Image 1 Line 1: Primary offer tag under price */}
            {p.offer_tag ? (
              <div class="fk-discount-callout">
                <span>🏷️ {p.offer_tag}</span>
              </div>
            ) : null}

            {/* Image 1 Line 2: Secondary perk under price */}
            {p.diagnostic_setup ? (
              <div class="fk-fee-note">
                <span>{formatPerk(p.diagnostic_setup)}</span>
              </div>
            ) : null}
          </div>

          {/* Flipkart WOW! DEAL & Offers Card (Image 2) - Only displayed if at least one offer is entered */}
          {(p.wow_deal || p.bank_offer || p.emi_offer || p.partner_offer) && (
            <div class="fk-offers-card">
              {p.wow_deal && (() => {
                const { badge, text } = parseBadge(p.wow_deal, 'WOW! DEAL');
                return (
                  <div class="fk-offer-heading">
                    <span class="fk-wow-tag">{badge}</span>
                    <span class="fk-wow-text">{text}</span>
                  </div>
                );
              })()}

              {(p.bank_offer || p.emi_offer || p.partner_offer) && (
                <div class="fk-offer-list">
                  {p.bank_offer && (() => {
                    const { badge, text } = parseBadge(p.bank_offer, 'Bank Offer');
                    return (
                      <div class="fk-offer-item">
                        <span class="fk-offer-badge">{badge}</span>
                        <span>{text}</span>
                      </div>
                    );
                  })()}
                  {p.emi_offer && (() => {
                    const { badge, text } = parseBadge(p.emi_offer, 'No Cost EMI');
                    return (
                      <div class="fk-offer-item">
                        <span class="fk-offer-badge">{badge}</span>
                        <span>{text}</span>
                      </div>
                    );
                  })()}
                  {p.partner_offer && (() => {
                    const { badge, text } = parseBadge(p.partner_offer, 'Partner Offer');
                    return (
                      <div class="fk-offer-item">
                        <span class="fk-offer-badge">{badge}</span>
                        <span>{text}</span>
                      </div>
                    );
                  })()}
                </div>
              )}
            </div>
          )}

          {/* Delivery & Pincode Checker */}
          {(p.delivery_text || p.delivery_sub) && (
            <div class="fk-delivery-box">
              <div class="fk-delivery-head">
                <Icon name="pin" size={16} />
                <span>Deliver to: <strong>Pune &amp; PCMC (411019, 411062, 411033...)</strong></span>
              </div>
              <p class="fk-delivery-promise">
                🚚 <strong>{p.delivery_text || 'Free Doorstep Delivery'}</strong>{p.delivery_sub ? ` — ${p.delivery_sub}` : ''}
              </p>
            </div>
          )}

          {/* Services & Guarantees */}
          {(p.warranty || p.replacement_policy || p.diagnostic_setup) && (
            <div class="fk-services-strip">
              {p.warranty && (
                <div class="fk-service-cell">
                  <Icon name="shield" size={20} class="fk-serv-icon" />
                  <div class="fk-serv-text">
                    <strong>Warranty</strong>
                    <span>{p.warranty}</span>
                  </div>
                </div>
              )}
              {p.replacement_policy && (
                <div class="fk-service-cell">
                  <Icon name="clock" size={20} class="fk-serv-icon" />
                  <div class="fk-serv-text">
                    <strong>Replacement</strong>
                    <span>{p.replacement_policy}</span>
                  </div>
                </div>
              )}
              {p.diagnostic_setup && (
                <div class="fk-service-cell">
                  <Icon name="wrench" size={20} class="fk-serv-icon" />
                  <div class="fk-serv-text">
                    <strong>Diagnostic / Setup</strong>
                    <span>{p.diagnostic_setup.replace(/^\+\s*/, '').replace(/\s+Included$/i, '')}</span>
                  </div>
                </div>
              )}
            </div>
          )}

          {/* ── Sorted Product Specifications (Flipkart Highlights) ── */}
          <div class="fk-specs-section">
            <h2 class="fk-specs-heading">Product Highlights &amp; Specifications</h2>
            <ul class="fk-detail-specs-list">
              {specs.length > 0 ? (
                specs.map((spec) => (
                  <li>
                    <span class="fk-spec-bullet">•</span>
                    <span class="fk-spec-content">{spec}</span>
                  </li>
                ))
              ) : (
                <li>
                  <span class="fk-spec-bullet">•</span>
                  <span class="fk-spec-content">{p.summary || 'Certified genuine hardware benchmarked by Virnobyte.'}</span>
                </li>
              )}
            </ul>
          </div>

          {/* Description & Full Inspection Note */}
          <div class="fk-overview-box">
            <h3>Virnobyte Certification &amp; Inspection</h3>
            <p>
              Every unit goes through a thorough 35-point hardware check: battery health test, display color &amp; dead-pixel verification, thermal paste renewal, port testing, and stress benchmarking.
            </p>
          </div>
        </div>
      </div>

      {/* ── Amazon-Style Product Suggestions Carousel (As Attached) ── */}
      {suggestions.length > 0 && (
        <section class="amz-suggestions-section" aria-label="Related Products & Recommendations">
          <div class="amz-sug-header">
            <h2 class="amz-sug-title">Related products with free delivery on eligible orders</h2>
            <span class="amz-sug-page-indicator" id="amz-page-indicator">Page 1 of {Math.max(1, Math.ceil(suggestions.length / 5))}</span>
          </div>

          <div class="amz-carousel-wrapper">
            {/* Left Scroll Arrow */}
            <button
              type="button"
              class="amz-carousel-arrow amz-arrow-prev"
              id="amz-carousel-prev"
              aria-label="Previous suggestions"
              title="Previous"
            >
              ‹
            </button>

            {/* Scrollable Products Track */}
            <div class="amz-carousel-track" id="amz-carousel-track" role="region" aria-label="Suggested products carousel">
              {suggestions.map((item) => {
                const itemImg = getCardImage(item);
                const itemDisc = calcDiscount(item.price, item.mrp);
                const itemPriceFormatted = formatAmzPrice(item.price);
                const itemMrpFormatted = formatAmzPrice(item.mrp);
                const stars = getAmzStars(item.rating);
                const reviewCount = getAmzCount(item.rating_count);

                return (
                  <article class="amz-card">
                    <a href={`/products/${item.slug}`} class="amz-card-media" aria-label={item.name}>
                      <img src={itemImg} alt={item.name} loading="lazy" decoding="async" />
                    </a>

                    <div class="amz-card-details">
                      <a href={`/products/${item.slug}`} class="amz-card-title" title={item.name}>
                        {item.name}
                      </a>

                      {/* Ratings row: Amazon Orange Stars + Review count */}
                      <div class="amz-rating-row">
                        <span class="amz-stars" aria-label={`${item.rating || '4.2'} out of 5 stars`}>
                          {stars}
                        </span>
                        <a href={`/products/${item.slug}`} class="amz-rating-count">
                          {reviewCount}
                        </a>
                      </div>

                      {/* Price & Discount row (e.g. -56% ₹109.00) */}
                      <div class="amz-price-row">
                        {itemDisc ? <span class="amz-discount-pct">-{itemDisc}%</span> : null}
                        {itemPriceFormatted ? (
                          <span class="amz-main-price">{itemPriceFormatted}</span>
                        ) : (
                          <span class="amz-main-price amz-ask">Ask for Price</span>
                        )}
                      </div>

                      {/* Badge (e.g. #1 Best Seller - NO "Great Indian Festival") */}
                      {item.badge ? (
                        <div class="amz-badge-row">
                          <span class="amz-badge-pill">#1 Best Seller</span>
                        </div>
                      ) : null}

                      {/* M.R.P. strikethrough */}
                      {itemMrpFormatted && item.price && item.mrp && item.mrp > item.price ? (
                        <div class="amz-mrp-row">
                          <span>M.R.P.: </span>
                          <span class="amz-mrp-crossed">{itemMrpFormatted}</span>
                        </div>
                      ) : null}

                      {/* Delivery lines */}
                      <div class="amz-delivery-info">
                        <p class="amz-del-date">
                          Get it by <strong>{amzDeliveryDate}</strong>
                        </p>
                        <p class="amz-del-ship">FREE Delivery over ₹499.</p>
                        <p class="amz-del-fulfill">Fulfilled by Virnobyte.</p>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>

            {/* Right Scroll Arrow */}
            <button
              type="button"
              class="amz-carousel-arrow amz-arrow-next"
              id="amz-carousel-next"
              aria-label="Next suggestions"
              title="Next"
            >
              ›
            </button>
          </div>
        </section>
      )}

      {/* ── Amazon-Style Product Suggestions Carousel (As Attached) ── */}
      {suggestions.length > 0 && (
        <section class="amz-suggestions-section" aria-label="Related Products & Recommendations">
          <div class="amz-sug-header">
            <h2 class="amz-sug-title">Related products with free delivery on eligible orders</h2>
            <span class="amz-sug-page-indicator" id="amz-page-indicator">Page 1 of {Math.max(1, Math.ceil(suggestions.length / 5))}</span>
          </div>

          <div class="amz-carousel-wrapper">
            {/* Left Scroll Arrow */}
            <button
              type="button"
              class="amz-carousel-arrow amz-arrow-prev"
              id="amz-carousel-prev"
              aria-label="Previous suggestions"
              title="Previous"
            >
              ‹
            </button>

            {/* Scrollable Products Track */}
            <div class="amz-carousel-track" id="amz-carousel-track" role="region" aria-label="Suggested products carousel">
              {suggestions.map((item) => {
                const itemImg = getCardImage(item);
                const itemDisc = calcDiscount(item.price, item.mrp);
                const itemPriceFormatted = formatAmzPrice(item.price);
                const itemMrpFormatted = formatAmzPrice(item.mrp);
                const stars = getAmzStars(item.rating);
                const reviewCount = getAmzCount(item.rating_count);

                return (
                  <article class="amz-card">
                    <a href={`/products/${item.slug}`} class="amz-card-media" aria-label={item.name}>
                      <img src={itemImg} alt={item.name} loading="lazy" decoding="async" />
                    </a>

                    <div class="amz-card-details">
                      <a href={`/products/${item.slug}`} class="amz-card-title" title={item.name}>
                        {item.name}
                      </a>

                      {/* Ratings row: Amazon Orange Stars + Review count */}
                      <div class="amz-rating-row">
                        <span class="amz-stars" aria-label={`${item.rating || '4.2'} out of 5 stars`}>
                          {stars}
                        </span>
                        <a href={`/products/${item.slug}`} class="amz-rating-count">
                          {reviewCount}
                        </a>
                      </div>

                      {/* Price & Discount row (e.g. -56% ₹109.00) */}
                      <div class="amz-price-row">
                        {itemDisc ? <span class="amz-discount-pct">-{itemDisc}%</span> : null}
                        {itemPriceFormatted ? (
                          <span class="amz-main-price">{itemPriceFormatted}</span>
                        ) : (
                          <span class="amz-main-price amz-ask">Ask for Price</span>
                        )}
                      </div>

                      {/* Badge (e.g. #1 Best Seller - NO "Great Indian Festival") */}
                      {item.badge ? (
                        <div class="amz-badge-row">
                          <span class="amz-badge-pill">#1 Best Seller</span>
                        </div>
                      ) : null}

                      {/* M.R.P. strikethrough */}
                      {itemMrpFormatted && item.price && item.mrp && item.mrp > item.price ? (
                        <div class="amz-mrp-row">
                          <span>M.R.P.: </span>
                          <span class="amz-mrp-crossed">{itemMrpFormatted}</span>
                        </div>
                      ) : null}

                      {/* Delivery lines */}
                      <div class="amz-delivery-info">
                        <p class="amz-del-date">
                          Get it by <strong>{amzDeliveryDate}</strong>
                        </p>
                        <p class="amz-del-ship">FREE Delivery over ₹499.</p>
                        <p class="amz-del-fulfill">Fulfilled by Virnobyte.</p>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>

            {/* Right Scroll Arrow */}
            <button
              type="button"
              class="amz-carousel-arrow amz-arrow-next"
              id="amz-carousel-next"
              aria-label="Next suggestions"
              title="Next"
            >
              ›
            </button>
          </div>
        </section>
      )}
    </div>
  </div>

  <CtaBand
    heading="Have questions about specifications or want a live video demo?"
    text="Message our workshop technicians directly on WhatsApp. We can show you the device, run benchmarks, and confirm compatibility."
  />
</Base>

<style>
  .fk-detail-page {
    background: #f1f3f6;
    padding-top: 14px;
    padding-bottom: 48px;
  }

  /* Breadcrumbs */
  .fk-detail-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #878787;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .fk-detail-crumbs a {
    color: #878787;
    text-decoration: none;
    transition: color 0.15s;
  }
  .fk-detail-crumbs a:hover {
    color: #2874f0;
  }
  .fk-sep {
    color: #c2c2c2;
  }
  .fk-current-crumb {
    color: #212121;
    font-weight: 600;
  }

  /* Two Column Grid */
  .fk-detail-grid {
    display: grid;
    grid-template-columns: 460px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* ── Left Column: Sticky Gallery ───────────────────────────── */
  .fk-detail-left {
    position: sticky;
    top: calc(var(--header-h) + 16px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fk-gallery-wrapper {
    background: #ffffff;
    border-radius: 8px;
    padding: 16px;
    border: 1px solid #e0e0e0;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fk-detail-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
