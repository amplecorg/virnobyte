</style>

<script>
  // ── Detail Page Gallery & Hover Loupe ───────────────────────
  const stage = document.getElementById('fk-detail-stage');
  const mainImg = document.getElementById('fk-detail-main-img') as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.fk-detail-thumb-btn');
  const counterActive = document.getElementById('fk-counter-active');
  const wishlistBtn = document.getElementById('fk-wishlist-toggle');

  if (wishlistBtn) {
    wishlistBtn.onclick = () => {
      wishlistBtn.classList.toggle('active');
    };
  }

  // Hover Loupe Zoom Effect
  if (stage && mainImg) {
    let isHovered = false;
    stage.addEventListener('mouseenter', () => {
      isHovered = true;
    });

    stage.addEventListener('mousemove', (e) => {
      if (!isHovered) return;
      const rect = stage.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      mainImg.style.transformOrigin = `${x}% ${y}%`;
      mainImg.style.transform = 'scale(2)';
    });

    stage.addEventListener('mouseleave', () => {
      isHovered = false;
      mainImg.style.transformOrigin = 'center center';
      mainImg.style.transform = 'scale(1)';
    });
  }

  // Thumbnail Click / Hover Switcher
  thumbBtns.forEach((btn) => {
    const handleSwitch = () => {
      const img = btn.querySelector('img');
      if (img && mainImg) {
        mainImg.style.opacity = '0.35';
        setTimeout(() => {
          mainImg.src = img.src;
          mainImg.style.opacity = '1';
        }, 120);
      }
      thumbBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      if (counterActive) {
        counterActive.textContent = String(Number(btn.dataset.index || 0) + 1);
      }
    };

    btn.onclick = handleSwitch;
    btn.onmouseenter = handleSwitch;
  });

  // ── Amazon Suggestions Carousel Navigation ─────────────────
  const amzTrack = document.getElementById('amz-carousel-track');
  const amzPrev = document.getElementById('amz-carousel-prev') as HTMLButtonElement | null;
  const amzNext = document.getElementById('amz-carousel-next') as HTMLButtonElement | null;
  const amzIndicator = document.getElementById('amz-page-indicator');

  if (amzTrack && amzPrev && amzNext) {
    const updateAmzArrows = () => {
      const maxScroll = amzTrack.scrollWidth - amzTrack.clientWidth;
      amzPrev.disabled = amzTrack.scrollLeft <= 5;
      amzNext.disabled = amzTrack.scrollLeft >= maxScroll - 5;

      if (amzIndicator && amzTrack.clientWidth > 0) {
        const totalPages = Math.max(1, Math.ceil(amzTrack.scrollWidth / amzTrack.clientWidth));
        const currentPage = Math.min(totalPages, Math.floor((amzTrack.scrollLeft + 10) / amzTrack.clientWidth) + 1);
        amzIndicator.textContent = `Page ${currentPage} of ${totalPages}`;
      }
    };

    amzPrev.addEventListener('click', () => {
      amzTrack.scrollBy({ left: -(amzTrack.clientWidth * 0.75), behavior: 'smooth' });
    });

    amzNext.addEventListener('click', () => {
      amzTrack.scrollBy({ left: amzTrack.clientWidth * 0.75, behavior: 'smooth' });
    });

    amzTrack.addEventListener('scroll', updateAmzArrows, { passive: true });
    window.addEventListener('resize', updateAmzArrows);
    setTimeout(updateAmzArrows, 150);
  }
</script>

