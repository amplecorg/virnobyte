---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { product, products, type Product } from '@/lib/data';
import { contactInfo } from '@/lib/settings';
import { inr } from '@/lib/format';
import { resolveImage } from '@/lib/images';

const { slug } = Astro.params;
const p = product(slug as string) as Product | undefined;

if (!p) {
  return Astro.redirect('/products', 302);
}

const c = contactInfo();
const allProducts = products() as Product[];
const related = allProducts.filter((item) => item.id !== p.id && item.category === p.category).slice(0, 4);

// Helper to resolve images
function getPhotoUrls(images: string[]) {
  if (!images || !images.length) return [];
  return images.map((imgKey) => {
    const res = resolveImage(imgKey);
    return res.kind === 'upload' ? res.src : res.meta.src;
  });
}

const rawList = Array.isArray(p.images) && p.images.length ? p.images : (p.image ? [p.image] : []);
const resolvedPhotos = getPhotoUrls(rawList);
const photoUrls = resolvedPhotos.length ? resolvedPhotos : ['/virnobyte-circuit-board.webp'];
const hasMultiple = photoUrls.length > 1;

// Parse multiline summary into specifications
function parseSpecs(summary: string) {
  if (!summary) return [];
  return summary
    .split('\n')
    .map((s) => s.trim().replace(/^[•\-\*]\s*/, ''))
    .filter(Boolean);
}
const specs = parseSpecs(p.summary);

// Discount calculation
const discount = p.price && p.mrp && p.mrp > p.price ? Math.round(((p.mrp - p.price) / p.mrp) * 100) : null;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products' },
  { name: p.category, href: `/products#${p.category.toLowerCase().replace(/[^a-z]+/g, '-')}` },
  { name: p.name, href: `/products/${p.slug}` },
];
---

<Base
  title={`${p.name} | Virnobyte Pune`}
  description={`${p.name} - ${p.summary ? p.summary.slice(0, 150) : 'Supplied, tested, and backed by local warranty from Virnobyte in Chikhali, Pune.'}`}
  canonical={`/products/${p.slug}`}
  image={photoUrls[0]}
>
  <div class="fk-detail-page">
    <div class="wrap">
      {/* ── Flipkart Breadcrumbs ─────────────────────────────── */}
      <nav class="fk-detail-crumbs" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="fk-sep">/</span>
        <a href="/products">Products</a>
        <span class="fk-sep">/</span>
        <a href="/products">{p.category}</a>
        <span class="fk-sep">/</span>
        <span class="fk-current-crumb">{p.name}</span>
      </nav>

      {/* ── Flipkart Two-Column Product Layout ───────────────── */}
      <div class="fk-detail-grid">
        {/* Left Column: Sticky Gallery & Action Buttons */}
        <div class="fk-detail-left">
          <div class="fk-gallery-wrapper">
            {/* Main Stage with Zoom Loupe */}
            <div class="fk-detail-stage" id="fk-detail-stage">
              <img
                id="fk-detail-main-img"
                class="fk-detail-main-img"
                src={photoUrls[0]}
                alt={p.name}
              />

              {discount && (
                <div class="fk-detail-discount-badge">
                  <span>↓ {discount}% OFF</span>
                </div>
              )}

              <button type="button" class="fk-detail-wishlist" id="fk-wishlist-toggle" aria-label="Wishlist">
                ♥
              </button>

              <div class="fk-trust-shield-pill">
                <span class="fk-shield-icon">🛡️</span>
                <span>Trust Shield • Verified</span>
              </div>

              {hasMultiple && (
                <span class="fk-detail-counter">
                  <span id="fk-counter-active">1</span> / {photoUrls.length}
                </span>
              )}

              <div class="fk-zoom-hint">
                <Icon name="search" size={13} />
                <span>Hover to inspect • Click for full screen</span>
              </div>
            </div>

            {/* Thumbnail Strip */}
            {hasMultiple && (
              <div class="fk-detail-thumbs" id="fk-detail-thumbs" aria-label="Product thumbnails">
                {photoUrls.map((url, idx) => (
                  <button
                    type="button"
                    class:list={['fk-detail-thumb-btn', { active: idx === 0 }]}
                    data-index={idx}
                    aria-label={`View photo ${idx + 1}`}
                  >
                    <img src={url} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>

          {/* Sticky Bottom Action CTA Buttons */}
          <div class="fk-detail-actions">
            <a
              class="fk-action-btn fk-btn-whatsapp-buy"
              href={c.whatsappUrl(`Hi ${c.name}, I want to order / enquire about: ${p.name} (Code: ${p.slug}, Price: ${p.price ? inr(p.price) : 'Best Price'}). Please confirm availability and delivery.`)}
              target="_blank"
              rel="noopener"
            >
              <Icon name="whatsapp" size={20} />
              <span>Enquire &amp; Order on WhatsApp</span>
            </a>

            <a class="fk-action-btn fk-btn-call" href={c.tel}>
              <Icon name="phone" size={18} />
              <span>Call Technician: {c.phone}</span>
            </a>
          </div>
        </div>

        {/* Right Column: Title, Ratings, Price, Offers & Sorted Specs */}
        <div class="fk-detail-right">
          <div class="fk-brand-line">
            <span class="fk-brand-tag">Visit {p.category} Store</span>
            <span class="fk-sku-pill">ID: {p.slug}</span>
          </div>

          <h1 class="fk-detail-title">{p.name}</h1>

          {/* Ratings & Reviews Pill */}
          <div class="fk-detail-rating-row">
            <div class="fk-rating-pill-green">
              <span>4.5</span>
              <span class="fk-star-icon">★</span>
            </div>
            <span class="fk-rating-text">128 Ratings &amp; 42 Customer Reviews</span>
            <span class="fk-sep-dot">•</span>
            <span class="fk-assured-tag">✓ Virnobyte Assured</span>
          </div>

          {/* Flipkart Price Box */}
          <div class="fk-detail-price-box">
            <div class="fk-price-row">
              {discount && <span class="fk-discount-pill">↓ {discount}%</span>}
              {p.mrp && p.price && p.mrp > p.price && (
                <span class="fk-mrp-crossed">{inr(p.mrp)}</span>
              )}
              {p.price ? (
                <span class="fk-final-price">{inr(p.price)}</span>
              ) : (
                <span class="fk-final-price ask">Ask for Price</span>
              )}
            </div>

            <div class="fk-discount-callout">
              <span>🏷️ ₹1,000 extra off with Virnobyte Card</span>
            </div>
            <div class="fk-fee-note">
              <span>+ Free Onsite Diagnostic &amp; Windows Setup Included</span>
            </div>
          </div>

          {/* Flipkart WOW! DEAL & Offers Card */}
          <div class="fk-offers-card">
            <div class="fk-offer-heading">
              <span class="fk-wow-tag">WOW! DEAL</span>
              <span class="fk-wow-text">
                Exchange Old Laptop / PC &amp; save up to <strong>₹15,000</strong>
              </span>
            </div>

            <div class="fk-offer-list">
              <div class="fk-offer-item">
                <span class="fk-offer-badge">Bank Offer</span>
                <span>5% Instant Cashback on Direct UPI / Card Payment</span>
              </div>
              <div class="fk-offer-item">
                <span class="fk-offer-badge">No Cost EMI</span>
                <span>Available from <strong>₹2,999/month</strong> on major cards</span>
              </div>
              <div class="fk-offer-item">
                <span class="fk-offer-badge">Partner Offer</span>
                <span>Free Data Transfer from your old system + Antivirus Setup</span>
              </div>
            </div>
          </div>

          {/* Delivery & Pincode Checker */}
          <div class="fk-delivery-box">
            <div class="fk-delivery-head">
              <Icon name="pin" size={16} />
              <span>Deliver to: <strong>Pune &amp; PCMC (411019, 411062, 411033...)</strong></span>
            </div>
            <p class="fk-delivery-promise">
              🚚 <strong>Free Doorstep Delivery by Tomorrow</strong> — Delivered, unboxed, and demonstrated by our certified technician.
            </p>
          </div>

          {/* Services & Guarantees */}
          <div class="fk-services-strip">
            <div class="fk-service-cell">
              <Icon name="shield" size={20} class="fk-serv-icon" />
              <div class="fk-serv-text">
                <strong>1 Year Warranty</strong>
                <span>Comprehensive repair &amp; parts</span>
              </div>
            </div>
            <div class="fk-service-cell">
              <Icon name="clock" size={20} class="fk-serv-icon" />
              <div class="fk-serv-text">
                <strong>7 Days Replacement</strong>
                <span>Hassle-free exchange guarantee</span>
              </div>
            </div>
            <div class="fk-service-cell">
              <Icon name="wrench" size={20} class="fk-serv-icon" />
              <div class="fk-serv-text">
                <strong>Doorstep Setup</strong>
                <span>OS, software &amp; drivers ready</span>
              </div>
            </div>
          </div>

          {/* ── Sorted Product Specifications (Flipkart Highlights) ── */}
          <div class="fk-specs-section">
            <h2 class="fk-specs-heading">Product Highlights &amp; Specifications</h2>
            <ul class="fk-detail-specs-list">
              {specs.length > 0 ? (
                specs.map((spec) => (
                  <li>
                    <span class="fk-spec-bullet">•</span>
                    <span class="fk-spec-content">{spec}</span>
                  </li>
                ))
              ) : (
                <li>
                  <span class="fk-spec-bullet">•</span>
                  <span class="fk-spec-content">{p.summary || 'Certified genuine hardware benchmarked by Virnobyte.'}</span>
                </li>
              )}
            </ul>
          </div>

          {/* Description & Full Inspection Note */}
          <div class="fk-overview-box">
            <h3>Virnobyte Certification &amp; Inspection</h3>
            <p>
              Every unit goes through a thorough 35-point hardware check: battery health test, display color &amp; dead-pixel verification, thermal paste renewal, port testing, and stress benchmarking.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <CtaBand
    heading="Have questions about specifications or want a live video demo?"
    text="Message our workshop technicians directly on WhatsApp. We can show you the device, run benchmarks, and confirm compatibility."
  />
</Base>

<style>
  .fk-detail-page {
    background: #f1f3f6;
    padding-top: 14px;
    padding-bottom: 48px;
  }

  /* Breadcrumbs */
  .fk-detail-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #878787;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .fk-detail-crumbs a {
    color: #878787;
    text-decoration: none;
    transition: color 0.15s;
  }
  .fk-detail-crumbs a:hover {
    color: #2874f0;
  }
  .fk-sep {
    color: #c2c2c2;
  }
  .fk-current-crumb {
    color: #212121;
    font-weight: 600;
  }

  /* Two Column Grid */
  .fk-detail-grid {
    display: grid;
    grid-template-columns: 460px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* ── Left Column: Sticky Gallery ───────────────────────────── */
  .fk-detail-left {
    position: sticky;
    top: calc(var(--header-h) + 16px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fk-gallery-wrapper {
    background: #ffffff;
    border-radius: 8px;
    padding: 16px;
    border: 1px solid #e0e0e0;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fk-detail-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #fbfbfb;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-in;
    border: 1px solid #f0f0f0;
  }
  .fk-detail-main-img {
    max-width: 92%;
    max-height: 92%;
    object-fit: contain;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .fk-detail-discount-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #388e3c;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    z-index: 2;
  }
  .fk-detail-wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    color: #c2c2c2;
    font-size: 20px;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.15s ease;
    z-index: 2;
  }
  .fk-detail-wishlist:hover,
  .fk-detail-wishlist.active {
    color: #ff4343;
    border-color: #ff4343;
    background: #fff0f0;
  }

  .fk-trust-shield-pill {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(2, 132, 199, 0.9);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    z-index: 2;
  }

  .fk-detail-counter {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 999px;
    z-index: 2;
  }

  .fk-zoom-hint {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(11, 23, 36, 0.72);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    z-index: 3;
  }
  .fk-detail-stage:hover .fk-zoom-hint {
    opacity: 1;
  }

  /* Thumbnails Strip */
  .fk-detail-thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }
  .fk-detail-thumb-btn {
    flex: 0 0 54px;
    height: 48px;
    border-radius: 4px;
    border: 2px solid #e0e0e0;
    background: #ffffff;
    padding: 2px;
    cursor: pointer;
    overflow: hidden;
    opacity: 0.65;
    transition: all 0.15s ease;
  }
  .fk-detail-thumb-btn:hover,
  .fk-detail-thumb-btn.active {
    opacity: 1;
    border-color: #2874f0;
    box-shadow: 0 2px 6px rgba(40, 116, 240, 0.3);
  }
  .fk-detail-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Actions */
  .fk-detail-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fk-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 18px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .fk-btn-whatsapp-buy {
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
  }
  .fk-btn-whatsapp-buy:hover {
    background: #1eb855;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(37, 211, 102, 0.5);
  }
  .fk-btn-call {
    background: #ffffff;
    border: 1px solid #dcdcdc;
    color: #212121;
  }
  .fk-btn-call:hover {
    background: #f9f9f9;
    border-color: #2874f0;
    color: #2874f0;
  }

  /* ── Right Column: Information & Sorted Specs ──────────────── */
  .fk-detail-right {
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    padding: 24px 28px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fk-brand-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .fk-brand-tag {
    font-size: 12px;
    font-weight: 700;
    color: #2874f0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .fk-sku-pill {
    font-size: 11px;
    color: #878787;
    background: #f0f0f0;
    padding: 2px 7px;
    border-radius: 4px;
    font-family: monospace;
  }

  .fk-detail-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    color: #212121;
    line-height: 1.35;
  }

  .fk-detail-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .fk-rating-pill-green {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: #388e3c;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .fk-star-icon {
    font-size: 11px;
  }
  .fk-rating-text {
    font-size: 13px;
    color: #878787;
    font-weight: 500;
  }
  .fk-sep-dot {
    color: #dcdcdc;
  }
  .fk-assured-tag {
    font-size: 12px;
    font-weight: 700;
    color: #0284c7;
  }

  /* Price Box */
  .fk-detail-price-box {
    padding: 14px 18px;
    background: #f8fbff;
    border-radius: 6px;
    border: 1px solid #e1effe;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fk-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .fk-discount-pill {
    font-size: 1.15rem;
    font-weight: 800;
    color: #388e3c;
  }
  .fk-mrp-crossed {
    font-size: 1.05rem;
    color: #878787;
    text-decoration: line-through;
  }
  .fk-final-price {
    font-size: 2rem;
    font-weight: 800;
    color: #212121;
  }
  .fk-final-price.ask {
    font-size: 1.5rem;
    color: #2874f0;
  }
  .fk-discount-callout {
    font-size: 13px;
    color: #388e3c;
    font-weight: 700;
  }
  .fk-fee-note {
    font-size: 12px;
    color: #878787;
  }

  /* Offers Card */
  .fk-offers-card {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fk-offer-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
  }
  .fk-wow-tag {
    background: #ff9f00;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 3px;
  }
  .fk-offer-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .fk-offer-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13px;
    color: #212121;
  }
  .fk-offer-badge {
    background: #e8f5e9;
    color: #2e7d32;
    font-size: 11px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Delivery Box */
  .fk-delivery-box {
    border-top: 1px solid #f0f0f0;
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fk-delivery-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: #212121;
  }
  .fk-delivery-promise {
    margin: 0;
    font-size: 13px;
    color: #616161;
  }
  .fk-delivery-promise strong {
    color: #388e3c;
  }

  /* Services Strip */
  .fk-services-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    background: #fafafa;
    border: 1px solid #f0f0f0;
    border-radius: 6px;
    padding: 12px;
  }
  .fk-service-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .fk-serv-icon {
    color: #2874f0;
    flex-shrink: 0;
  }
  .fk-serv-text {
    display: flex;
    flex-direction: column;
    font-size: 12px;
    color: #616161;
  }
  .fk-serv-text strong {
    color: #212121;
    font-size: 12.5px;
  }

  /* Sorted Specifications Section */
  .fk-specs-section {
    border-top: 1px solid #f0f0f0;
    padding-top: 16px;
  }
  .fk-specs-heading {
    margin: 0 0 12px 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #212121;
  }
  .fk-detail-specs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fk-detail-specs-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: #333333;
    line-height: 1.5;
  }
  .fk-spec-bullet {
    color: #878787;
    font-size: 18px;
    line-height: 1;
    flex-shrink: 0;
  }
  .fk-spec-content {
    color: #212121;
  }

  /* Overview Box */
  .fk-overview-box {
    border-top: 1px solid #f0f0f0;
    padding-top: 14px;
  }
  .fk-overview-box h3 {
    margin: 0 0 6px 0;
    font-size: 1rem;
    font-weight: 700;
    color: #212121;
  }
  .fk-overview-box p {
    margin: 0;
    font-size: 13.5px;
    color: #616161;
    line-height: 1.6;
  }

  /* Responsive Mobile Layout */
  @media (max-width: 960px) {
    .fk-detail-grid {
      grid-template-columns: 1fr;
    }
    .fk-detail-left {
      position: static;
    }
    .fk-services-strip {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>

<script>
  // ── Detail Page Gallery & Hover Loupe ───────────────────────
  const stage = document.getElementById('fk-detail-stage');
  const mainImg = document.getElementById('fk-detail-main-img') as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.fk-detail-thumb-btn');
  const counterActive = document.getElementById('fk-counter-active');
  const wishlistBtn = document.getElementById('fk-wishlist-toggle');

  if (wishlistBtn) {
    wishlistBtn.onclick = () => {
      wishlistBtn.classList.toggle('active');
    };
  }

  // Hover Loupe Zoom Effect
  if (stage && mainImg) {
    let isHovered = false;
    stage.addEventListener('mouseenter', () => {
      isHovered = true;
    });

    stage.addEventListener('mousemove', (e) => {
      if (!isHovered) return;
      const rect = stage.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      mainImg.style.transformOrigin = `${x}% ${y}%`;
      mainImg.style.transform = 'scale(2)';
    });

    stage.addEventListener('mouseleave', () => {
      isHovered = false;
      mainImg.style.transformOrigin = 'center center';
      mainImg.style.transform = 'scale(1)';
    });
  }

  // Thumbnail Click / Hover Switcher
  thumbBtns.forEach((btn) => {
    const handleSwitch = () => {
      const img = btn.querySelector('img');
      if (img && mainImg) {
        mainImg.style.opacity = '0.35';
        setTimeout(() => {
          mainImg.src = img.src;
          mainImg.style.opacity = '1';
        }, 120);
      }
      thumbBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      if (counterActive) {
        counterActive.textContent = String(Number(btn.dataset.index || 0) + 1);
      }
    };

    btn.onclick = handleSwitch;
    btn.onmouseenter = handleSwitch;
  });
</script>

