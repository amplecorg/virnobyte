---
import '@/styles/global.css';
import '@/styles/admin.css';
import Icon from '@/components/Icon.astro';
import { get } from '@/lib/db';

interface Props {
  title: string;
  active?: string;
}
const { title, active } = Astro.props;
const user = Astro.locals.user!;
const newEnq = get<{ n: number }>("SELECT COUNT(*) AS n FROM enquiries WHERE status = 'new'")!.n;
const pending = get<{ n: number }>("SELECT COUNT(*) AS n FROM memberships WHERE status = 'pending'")!.n;
const pcReq = get<{ n: number }>("SELECT COUNT(*) AS n FROM pc_builds WHERE status IN ('quote','ordered')")!.n;
const newOrders = get<{ n: number }>("SELECT COUNT(*) AS n FROM orders WHERE order_status = 'CONFIRMED'")?.n ?? 0;

const NAV: { group: string; items: { href: string; label: string; key: string; icon: string; badge?: number }[] }[] = [
  { group: 'Overview', items: [{ href: '/admin', label: 'Dashboard', key: 'dashboard', icon: 'dashboard' }] },
  {
    group: 'Membership',
    items: [
      { href: '/admin/members', label: 'Members & coins', key: 'members', icon: 'users', badge: pending },
      { href: '/admin/r/plans', label: 'Plans & card design', key: 'plans', icon: 'credit-card' },
      { href: '/admin/settings#coins', label: 'Coin program', key: 'coins', icon: 'coin' },
    ],
  },
  {
    group: 'E-Commerce & Orders',
    items: [
      { href: '/admin/r/orders', label: 'Customer Orders', key: 'orders', icon: 'receipt', badge: newOrders },
      { href: '/admin/r/products', label: 'Products Catalog', key: 'products', icon: 'shield' },
      { href: '/admin/settings#payments', label: 'Cashfree & Checkout', key: 'payments', icon: 'credit-card' },
    ],
  },
  {
    group: 'Leads',
    items: [
      { href: '/admin/r/enquiries', label: 'Enquiries', key: 'enquiries', icon: 'mail', badge: newEnq },
      { href: '/admin/r/pc_builds', label: 'PC build requests', key: 'pc_builds', icon: 'wrench', badge: pcReq },
    ],
  },
  {
    group: 'PC builder',
    items: [
      { href: '/admin/r/pc_parts', label: 'Parts & prices', key: 'pc_parts', icon: 'cpu' },
      { href: '/admin/r/pc_presets', label: 'Preset builds', key: 'pc_presets', icon: 'shield' },
      { href: '/admin/settings#pcbuilder', label: 'GST & fees', key: 'pcsettings', icon: 'receipt' },
    ],
  },
  {
    group: 'Content',
    items: [
      { href: '/admin/r/services', label: 'Services', key: 'services', icon: 'wrench' },
      { href: '/admin/r/posts', label: 'Blog', key: 'posts', icon: 'file-text' },
      { href: '/admin/r/faqs', label: 'FAQs', key: 'faqs', icon: 'message' },
      { href: '/admin/r/products', label: 'Products', key: 'products', icon: 'shield' },
      { href: '/admin/r/projects', label: 'Portfolio', key: 'projects', icon: 'briefcase' },
      { href: '/admin/r/gallery', label: 'Gallery', key: 'gallery', icon: 'image' },
      { href: '/admin/r/jobs', label: 'Careers', key: 'jobs', icon: 'clock' },
      { href: '/admin/r/testimonials', label: 'Testimonials', key: 'testimonials', icon: 'message' },
      { href: '/admin/r/pages', label: 'Legal & profile pages', key: 'pages', icon: 'file-text' },
    ],
  },
  { group: 'Site', items: [{ href: '/admin/settings', label: 'Business, home & SEO', key: 'settings', icon: 'settings' }] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Virnobyte admin</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/AmazonEmber_W_Rg.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/AmazonEmber_W_Bd.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      if (typeof localStorage !== 'undefined' && localStorage.getItem('vb_sidebar_collapsed') === 'true' && window.matchMedia('(min-width: 900px)').matches) {
        document.documentElement.classList.add('sidebar-collapsed');
      }
    </script>
  </head>
  <body class="admin">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="shell" id="admin-shell">
      <aside class="side" id="admin-side">
        <div class="side-head">
          <a class="logo" href="/admin" title="Virnobyte Admin">
            <img src="/virnobyte-logo.png" alt="" width="32" height="25" />
            <span class="logo-text">Virnobyte <span class="logo-badge">admin</span></span>
          </a>
          <button
            type="button"
            class="side-toggle"
            id="sidebar-toggle"
            aria-label="Toggle sidebar"
            title="Minimize sidebar (Ctrl+B)"
          >
            <Icon name="panel-close" size={18} class="icon-collapse" />
            <Icon name="panel-open" size={18} class="icon-expand" />
          </button>
        </div>
        <details class="navwrap" open>
          <summary>Menu</summary>
          <nav aria-label="Admin">
            {
              NAV.map((g) => (
                <div class="group">
                  <p>{g.group}</p>
                  {g.items.map((i) => (
                    <a href={i.href} aria-current={active === i.key ? 'page' : undefined} title={i.label}>
                      <span class="nav-icon"><Icon name={i.icon as any} size={18} /></span>
                      <span class="nav-label">{i.label}</span>
                      {i.badge ? <b class="badge">{i.badge}</b> : null}
                    </a>
                  ))}
                </div>
              ))
            }
          </nav>
        </details>
        <div class="me">
          <span class="small me-email">{user.email}</span>
          <div class="me-actions">
            <a href="/" target="_blank" rel="noopener" class="small" title="View site">
              <Icon name="external" size={16} />
              <span>View site</span>
            </a>
            <form method="post" action="/account/logout">
              <button type="submit" class="linkish small" title="Sign out">
                <Icon name="logout" size={16} />
                <span>Sign out</span>
              </button>
            </form>
          </div>
        </div>
      </aside>
      <main id="content" class="content">
        <div class="mobile-bar">
          <button type="button" class="mobile-toggle" id="mobile-sidebar-toggle" aria-label="Toggle menu">
            <Icon name="menu" size={18} />
            <span>Menu</span>
          </button>
          <span class="mobile-title">{title}</span>
        </div>
        <slot />
      </main>
    </div>
    <script>
      // Sidebar minimize / maximize functionality
      const toggle = document.getElementById('sidebar-toggle');
      const mobileToggle = document.getElementById('mobile-sidebar-toggle');
      const navwrap = document.querySelector<HTMLDetailsElement>('.navwrap');

      const applySidebarState = (collapsed: boolean) => {
        document.documentElement.classList.toggle('sidebar-collapsed', collapsed);
        localStorage.setItem('vb_sidebar_collapsed', String(collapsed));
        if (toggle) {
          toggle.setAttribute('title', collapsed ? 'Maximize sidebar (Ctrl+B)' : 'Minimize sidebar (Ctrl+B)');
          toggle.setAttribute('aria-label', collapsed ? 'Maximize sidebar' : 'Minimize sidebar');
        }
      };

      toggle?.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 899px)').matches) {
          if (navwrap) navwrap.open = !navwrap.open;
        } else {
          const isCollapsed = document.documentElement.classList.contains('sidebar-collapsed');
          applySidebarState(!isCollapsed);
        }
      });

      mobileToggle?.addEventListener('click', () => {
        if (navwrap) {
          navwrap.open = !navwrap.open;
          if (navwrap.open) navwrap.scrollIntoView({ behavior: 'smooth' });
        }
      });

      // Keyboard shortcut Ctrl+B / Cmd+B to toggle sidebar
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b' && !e.altKey) {
          e.preventDefault();
          const isCollapsed = document.documentElement.classList.contains('sidebar-collapsed');
          applySidebarState(!isCollapsed);
        }
      });

      // Collapse the menu on small screens by default.
      if (navwrap && matchMedia('(max-width: 899px)').matches) navwrap.open = false;

      // Live character counters for SEO fields.
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-max]').forEach((el) => {
        const out = el.closest('.field')?.querySelector<HTMLElement>('[data-count]');
        const max = Number(el.dataset.max);
        const upd = () => {
          if (!out) return;
          out.textContent = `${el.value.length} / ${max}`;
          out.classList.toggle('over', el.value.length > max);
        };
        el.addEventListener('input', upd);
        upd();
      });
      // Confirm destructive actions.
      document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
        f.addEventListener('submit', (e) => {
          if (!confirm(f.dataset.confirm!)) e.preventDefault();
        }),
      );
    </script>
  </body>
</html>
