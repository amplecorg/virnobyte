---
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';

interface Props {
  crumbs: { name: string; href: string }[];
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: string;
  imageAlt?: string;
}
const { crumbs, eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<section class:list={['page-hero', { 'has-image': image }]}>
  <div class="wrap grid-hero">
    <div class="copy">
      <Breadcrumbs items={crumbs} />
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="media">
          <Photo image={image} alt={imageAlt} eager sizes="(min-width: 1100px) 45vw, 100vw" widths={[480, 768, 1080, 1440, 1920, 2560]} />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-7) var(--space-8);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .grid-hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .copy h1 {
    max-width: 18ch;
  }
  .media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-l);
  }
  @media (min-width: 1100px) {
    .has-image .grid-hero {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
