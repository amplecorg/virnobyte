---
import { googleConfig } from '@/lib/google';

/** "Continue with Google" — rendered only when Google sign-in is set up in Admin → Settings. */
interface Props {
  next?: string | null;
}
const { next } = Astro.props;
const enabled = googleConfig().enabled;
const href = `/account/google${next ? `?next=${encodeURIComponent(next)}` : ''}`;
---

{
  enabled && (
    <>
      <a class="g-btn" href={href}>
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z" />
          <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.4 5.7c4.3-4 6.9-9.9 6.9-17.1z" />
          <path fill="#FBBC05" d="M10.5 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C1 16.4 0 20.1 0 24s1 7.6 2.6 10.8l7.9-6.1z" />
          <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.7c-2.1 1.4-4.8 2.3-8.5 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.6 42.6 14.6 48 24 48z" />
        </svg>
        Continue with Google
      </a>
      <div class="g-or"><span>or use your email</span></div>
    </>
  )
}

<style>
  .g-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    border: 1.5px solid var(--line-strong, #cbd5e1);
    border-radius: 8px;
    background: #fff;
    color: #1f2937;
    font-weight: 650;
    text-decoration: none;
  }
  .g-btn:hover {
    background: #f8fafc;
    border-color: #94a3b8;
  }
  .g-or {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-3, #64748b);
    font-size: 13px;
    margin: 4px 0;
  }
  .g-or::before,
  .g-or::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--line, #e2e8f0);
  }
</style>
