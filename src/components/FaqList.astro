---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---

<div class="faqs">
  {
    faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>
          <span class="q">{f.q}</span>
          <span class="pm" aria-hidden="true" />
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faqs {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    cursor: pointer;
    list-style: none;
    min-height: 48px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    font-weight: 700;
    line-height: 1.35;
  }
  .pm {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.8px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 0.2s;
  }
  .pm::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .pm::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  details p {
    padding-bottom: var(--space-5);
    color: var(--ink-2);
    max-width: 70ch;
  }
</style>
