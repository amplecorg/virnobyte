---
import { Picture } from 'astro:assets';
import { resolveImage } from '@/lib/images';

interface Props {
  image: string | null | undefined;
  alt: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  position?: string;
}

const {
  image,
  alt,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  widths = [480, 768, 1080, 1440, 1920],
  eager = false,
  class: cls,
  position,
} = Astro.props;
const img = resolveImage(image);
const style = position ? `object-position:${position}` : undefined;
---

{
  img.kind === 'asset' ? (
    <Picture
      src={img.meta}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths.filter((w) => w <= img.meta.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
      class={cls}
      style={style}
    />
  ) : (
    <img
      src={img.src}
      alt={alt}
      width={img.width}
      height={img.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      class={cls}
      style={style}
    />
  )
}
