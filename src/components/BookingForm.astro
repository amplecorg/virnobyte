---
import StepForm from './StepForm.astro';
import Field from './Field.astro';
import { services } from '@/lib/data';
import { getSettings } from '@/lib/settings';

interface Props {
  preset?: string;
  source?: string;
}
const { preset, source = Astro.url.pathname } = Astro.props;
const svc = services();
const areas = [...getSettings().business.serviceAreas, 'Other nearby area'];
// Browsers compile `pattern` with the v flag, so class punctuation must be escaped.
const PHONE = String.raw`\+?[0-9 \(\)\-]{10,16}`;
---

<StepForm action="/api/enquiry" id="booking-form" submitLabel="Book the service" draftKey="booking">
  <input type="hidden" name="source" value={source} />
  <fieldset data-step data-title="What needs fixing">
    <legend>What do you need help with?</legend>
    <Field
      label="Service"
      name="topic"
      type="select"
      required
      value={preset}
      msgRequired="Choose the service closest to your problem."
      options={[...svc.map((s) => s.name), 'Membership card', 'Something else']}
    />
    <Field
      label="Describe the problem"
      name="message"
      type="textarea"
      rows={4}
      hint="Device brand and model, what happens, and since when."
      placeholder="e.g. HP laptop shuts down after 10 minutes and gets very hot."
    />
  </fieldset>

  <fieldset data-step data-title="Where and when">
    <legend>Where should we help you?</legend>
    <Field label="Area" name="area" type="select" required options={areas} msgRequired="Choose your area so we can plan the visit." />
    <Field
      label="Preferred option"
      name="preferred"
      type="select"
      required
      msgRequired="Choose doorstep visit, workshop drop-off or a call back."
      options={['Doorstep visit', 'I will bring it to the Chikhali workshop', 'Call me first']}
    />
  </fieldset>

  <fieldset data-step data-title="Your details">
    <legend>How can we reach you?</legend>
    <div class="two">
      <Field label="Your name" name="name" required autocomplete="name" msgRequired="Enter your name." />
      <Field
        label="Mobile number"
        name="phone"
        type="tel"
        required
        autocomplete="tel"
        inputmode="tel"
        pattern={PHONE}
        msgRequired="Enter a mobile number so we can call you back."
        msgPattern="Enter a 10-digit mobile number, e.g. 98765 43210."
      />
    </div>
    <Field label="Email" name="email" type="email" autocomplete="email" />
    <p class="small muted">We use these details only to respond to this request. See our <a href="/privacy-policy">privacy policy</a>.</p>
  </fieldset>
</StepForm>
