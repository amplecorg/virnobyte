---
import Icon from './Icon.astro';
import { contactInfo } from '@/lib/settings';

interface Props {
  heading?: string;
  text?: string;
  whatsappText?: string;
}
const c = contactInfo();
const {
  heading = 'Tell us what is wrong. We will tell you what it takes to fix it.',
  text = `Call, WhatsApp or book online. Walk-ins welcome at our ${c.locality} workshop.`,
  whatsappText,
} = Astro.props;
---

<section class="cta section--night" data-reveal>
  <div class="wrap inner">
    <div class="copy">
      <h2>{heading}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn" href="/contact#book"><Icon name="calendar" /> Book a Service</a>
      <a class="btn btn--light" href={c.tel}><Icon name="phone" /> Call {c.phone}</a>
      <a class="btn btn--light" href={c.whatsappUrl(whatsappText)} rel="noopener" target="_blank"><Icon name="whatsapp" /> WhatsApp</a>
      <a class="btn btn--light" href={c.directions} rel="noopener" target="_blank"><Icon name="directions" /> Get Directions</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-8);
  }
  .inner {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }
  .copy {
    display: grid;
    gap: var(--space-4);
    max-width: 760px;
  }
  @media (min-width: 1100px) {
    .inner {
      grid-template-columns: 1.2fr 1fr;
    }
    .btn-row {
      justify-content: flex-end;
    }
  }
</style>
