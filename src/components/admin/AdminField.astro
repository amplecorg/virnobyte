---
import { getImage } from 'astro:assets';
import type { FieldDef } from '@/lib/admin/resources';
import { PHOTOS, PHOTO_KEYS, photoLabel } from '@/lib/images';

interface Props {
  field: FieldDef;
  value: string;
  error?: string;
  scope?: string;
}
const { field: f, value, error, scope = '' } = Astro.props;
const id = `af-${scope}${f.name}`.replace(/\./g, '-');

let thumbs: Record<string, string> = {};
let preview = '';
let currentImages: string[] = [];

if (f.type === 'image' || f.type === 'images') {
  const entries = await Promise.all(
    PHOTO_KEYS.map(async (k) => [k, (await getImage({ src: PHOTOS[k], width: 480, format: 'webp' })).src] as const),
  );
  thumbs = Object.fromEntries(entries);
  if (f.type === 'image') {
    preview = value.startsWith('/uploads/') ? value : thumbs[value] ?? '';
  } else {
    try {
      if (value.startsWith('[')) {
        currentImages = JSON.parse(value);
      } else if (value) {
        currentImages = [value];
      }
    } catch {
      currentImages = [];
    }
    if (!Array.isArray(currentImages)) currentImages = [];
  }
}
---

<div class:list={['field', { half: f.half }]} data-invalid={error ? '' : undefined}>
  {
    f.type === 'bool' ? (
      <label class="switch">
        <input type="checkbox" name={f.name} checked={value === '1'} />
        {f.label}
      </label>
    ) : (
      <label for={id}>
        {f.label}
        {f.required && <span class="muted"> *</span>}
      </label>
    )
  }
  {f.help && <span class="hint">{f.help}</span>}

  {
    (f.type === 'text' || f.type === 'slug') && (
      <input id={id} name={f.name} type="text" value={value} required={f.required} data-max={f.max} />
    )
  }
  {(f.type === 'number' || f.type === 'money') && <input id={id} name={f.name} type="number" inputmode="numeric" value={value} step="1" />}
  {f.type === 'date' && <input id={id} name={f.name} type="date" value={value.slice(0, 10)} />}
  {
    (f.type === 'textarea' || f.type === 'markdown' || f.type === 'list' || f.type === 'faqs' || f.type === 'kv') && (
      <textarea
        id={id}
        name={f.name}
        rows={f.rows ?? (f.type === 'faqs' ? 10 : f.type === 'list' ? 6 : 4)}
        class={f.type !== 'textarea' ? 'mono' : undefined}
        data-max={f.max}
        placeholder={f.type === 'faqs' ? 'Q: Question?\nA: Answer.\n\nQ: Next question?\nA: Answer.' : undefined}
      >{value}</textarea>
    )
  }
  {
    f.type === 'select' && (
      <select id={id} name={f.name}>
        {f.options!.map((o) => (
          <option value={o.value} selected={o.value === value}>
            {o.label}
          </option>
        ))}
      </select>
    )
  }
  {
    f.type === 'color' && (
      <div class="color-row">
        <input id={id} name={f.name} type="color" value={value || '#0b2545'} data-color-for={f.name} />
        <code class="small">{value}</code>
      </div>
    )
  }
  {
    f.type === 'image' && (
      <div class="img-field" data-img-field data-thumbs={JSON.stringify(thumbs)}>
        {preview && <img class="preview" src={preview} alt="" loading="lazy" />}
        <select id={id} name={f.name}>
          <option value="">No image</option>
          {value.startsWith('/uploads/') && (
            <option value={value} selected>
              Uploaded: {value.split('/').pop()}
            </option>
          )}
          <optgroup label="Photo library (4K)">
            {PHOTO_KEYS.map((k) => (
              <option value={k} selected={k === value}>
                {photoLabel(k)}
              </option>
            ))}
          </optgroup>
        </select>
        <label class="small">
          Or upload a new photo (converted to WebP, up to 3840px):
          <input type="file" name={`${f.name}__upload`} accept="image/jpeg,image/png,image/webp" />
        </label>
      </div>
    )
  }
  {
    f.type === 'images' && (
      <div class="multi-img-field" data-multi-img data-thumbs={JSON.stringify(thumbs)}>
        <input type="hidden" name={f.name} id={id} value={value || '[]'} class="images-json-input" />

        {/* Current Photos Gallery */}
        <div class="current-gallery-wrap">
          <div class="gallery-header">
            <strong>Current photos ({currentImages.length})</strong>
            <span class="small muted">First photo is used as main product cover</span>
          </div>
          <div class="current-gallery" data-gallery>
            {currentImages.map((src, idx) => {
              const thumbUrl = src.startsWith('/uploads/') ? src : thumbs[src] || src;
              return (
                <div class="gallery-item" data-src={src} data-index={idx} draggable="true">
                  <div class="img-wrap">
                    <img src={thumbUrl} alt="" loading="lazy" />
                    {idx === 0 && <span class="cover-badge">★ Cover</span>}
                  </div>
                  <div class="item-bar">
                    {idx > 0 ? (
                      <button type="button" class="action-btn action-cover" title="Make this cover photo">
                        Set Cover
                      </button>
                    ) : (
                      <span class="cover-label">Primary</span>
                    )}
                    <button type="button" class="action-btn action-del" title="Remove photo" aria-label="Remove photo">
                      ✕
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
          {currentImages.length === 0 && (
            <p class="empty-hint" data-empty-hint>No photos uploaded yet. Drag & drop or select photos below.</p>
          )}
        </div>

        {/* Drag and Drop Zone */}
        <div class="drop-zone" data-drop-zone>
          <input
            type="file"
            name={`${f.name}__upload`}
            id={`${id}-upload`}
            class="multi-file-input"
            multiple
            accept="image/jpeg,image/png,image/webp"
          />
          <div class="drop-zone-content">
            <svg class="drop-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="17 8 12 3 7 8" />
              <line x1="12" y1="3" x2="12" y2="15" />
            </svg>
            <div class="drop-texts">
              <strong class="drop-main-text">Drag & drop product photos here</strong>
              <span class="drop-sub-text">or <button type="button" class="browse-link" data-trigger-browse>browse from device</button> (select multiple files, JPG/PNG/WebP)</span>
            </div>
          </div>
        </div>

        {/* Live Pending Uploads List */}
        <div class="pending-uploads-wrap" data-pending-wrap style="display:none;">
          <div class="pending-header">
            <strong>Ready to upload on save (<span data-pending-count>0</span> photos)</strong>
            <button type="button" class="small muted clear-btn" data-clear-pending>Clear newly selected</button>
          </div>
          <div class="pending-grid" data-pending-grid></div>
        </div>

        {/* Optional Library Add */}
        <div class="lib-picker-row">
          <label class="small muted" for={`${id}-lib`}>Or add from built-in 4K photo library:</label>
          <div class="lib-picker-controls">
            <select id={`${id}-lib`} class="lib-select">
              <option value="">Select a library photo...</option>
              {PHOTO_KEYS.map((k) => (
                <option value={k}>{photoLabel(k)}</option>
              ))}
            </select>
            <button type="button" class="btn btn--sm btn--ghost" data-add-lib>+ Add to product</button>
          </div>
        </div>
      </div>
    )
  }
  {f.type === 'readonly' && <p style="white-space:pre-wrap;margin:0">{value || '—'}</p>}
  {f.max && <span class="count" data-count />}
  {error && <span class="error">{error}</span>}
</div>

<style>
  .multi-img-field {
    display: grid;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
    box-sizing: border-box;
  }
  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .current-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 12px;
  }
  .gallery-item {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    cursor: grab;
  }
  .gallery-item:active {
    cursor: grabbing;
  }
  .gallery-item.dragging {
    opacity: 0.45;
    border-color: #38bdf8;
  }
  .gallery-item.dragover {
    border-color: #38bdf8;
    box-shadow: 0 0 0 2px #38bdf8;
  }
  .img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #0b1524;
    overflow: hidden;
  }
  .img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cover-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    background: #0284c7;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 999px;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.4);
  }
  .item-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px;
    background: var(--surface);
    border-top: 1px solid var(--line);
    gap: 4px;
  }
  .cover-label {
    font-size: 11px;
    font-weight: 700;
    color: #38bdf8;
  }
  .action-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-2);
    padding: 3px 6px;
    border-radius: 4px;
    transition: background 0.12s, color 0.12s;
  }
  .action-btn:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .action-del:hover {
    background: #ef4444;
    color: #fff;
  }
  .action-cover {
    color: #0284c7;
  }
  .action-cover:hover {
    background: #0284c7;
    color: #fff;
  }
  .empty-hint {
    margin: 8px 0;
    font-size: 13px;
    color: var(--ink-3);
    font-style: italic;
  }

  /* Drop Zone */
  .drop-zone {
    position: relative;
    border: 2px dashed var(--line);
    border-radius: 10px;
    background: var(--paper);
    padding: 24px 18px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.18s, background-color 0.18s;
  }
  .drop-zone:hover,
  .drop-zone.drag-active {
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.05);
  }
  .multi-file-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
  }
  .drop-zone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }
  .drop-icon {
    color: #38bdf8;
    opacity: 0.9;
  }
  .drop-texts {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .drop-main-text {
    font-size: 15px;
    color: var(--ink);
  }
  .drop-sub-text {
    font-size: 13px;
    color: var(--ink-3);
  }
  .browse-link {
    color: #38bdf8;
    text-decoration: underline;
    background: none;
    border: none;
    font: inherit;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
  }

  /* Pending uploads */
  .pending-uploads-wrap {
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 8px;
    padding: 12px;
  }
  .pending-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 13px;
  }
  .clear-btn {
    border: none;
    background: none;
    cursor: pointer;
    text-decoration: underline;
  }
  .pending-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 8px;
  }
  .pending-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    font-size: 11px;
  }
  .pending-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .pending-info {
    padding: 4px 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-2);
  }

  /* Library picker */
  .lib-picker-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .lib-picker-controls {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .lib-select {
    flex: 1;
    max-width: 320px;
  }
</style>

<script>
  // Single image field preview sync
  document.querySelectorAll<HTMLElement>('[data-img-field]').forEach((wrap) => {
    if (wrap.dataset.bound) return;
    wrap.dataset.bound = '1';
    const thumbs = JSON.parse(wrap.dataset.thumbs || '{}');
    const sel = wrap.querySelector('select')!;
    sel.addEventListener('change', () => {
      let img = wrap.querySelector<HTMLImageElement>('img.preview');
      const src = sel.value.startsWith('/uploads/') ? sel.value : thumbs[sel.value];
      if (!src) return img?.remove();
      if (!img) {
        img = document.createElement('img');
        img.className = 'preview';
        img.alt = '';
        wrap.prepend(img);
      }
      img.src = src;
    });
  });

  // Color picker sync
  document.querySelectorAll<HTMLInputElement>('[data-color-for]').forEach((el) => {
    el.addEventListener('input', () => {
      const code = el.parentElement?.querySelector('code');
      if (code) code.textContent = el.value;
    });
  });

  // Multi-image Drag & Drop and Gallery Reordering
  document.querySelectorAll<HTMLElement>('[data-multi-img]').forEach((container) => {
    if (container.dataset.bound) return;
    container.dataset.bound = '1';

    const thumbs: Record<string, string> = JSON.parse(container.dataset.thumbs || '{}');
    const hiddenJson = container.querySelector<HTMLInputElement>('.images-json-input')!;
    const gallery = container.querySelector<HTMLElement>('[data-gallery]')!;
    const emptyHint = container.querySelector<HTMLElement>('[data-empty-hint]');
    const dropZone = container.querySelector<HTMLElement>('[data-drop-zone]')!;
    const fileInput = container.querySelector<HTMLInputElement>('.multi-file-input')!;
    const triggerBrowse = container.querySelector<HTMLButtonElement>('[data-trigger-browse]');
    const pendingWrap = container.querySelector<HTMLElement>('[data-pending-wrap]')!;
    const pendingCount = container.querySelector<HTMLElement>('[data-pending-count]')!;
    const pendingGrid = container.querySelector<HTMLElement>('[data-pending-grid]')!;
    const clearPendingBtn = container.querySelector<HTMLButtonElement>('[data-clear-pending]');
    const libSelect = container.querySelector<HTMLSelectElement>('.lib-select');
    const addLibBtn = container.querySelector<HTMLButtonElement>('[data-add-lib]');

    let pendingFiles: File[] = [];

    const getStoredList = (): string[] => {
      try {
        const val = hiddenJson.value.trim();
        return val.startsWith('[') ? JSON.parse(val) : val ? [val] : [];
      } catch {
        return [];
      }
    };

    const syncHiddenJson = () => {
      const items = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-item'));
      const list = items.map((el) => el.dataset.src || '').filter(Boolean);
      hiddenJson.value = JSON.stringify(list);

      // Re-index and update badges
      items.forEach((item, idx) => {
        item.dataset.index = String(idx);
        const imgWrap = item.querySelector('.img-wrap');
        const existingBadge = item.querySelector('.cover-badge');
        const itemBar = item.querySelector('.item-bar');

        if (idx === 0) {
          if (!existingBadge && imgWrap) {
            const b = document.createElement('span');
            b.className = 'cover-badge';
            b.textContent = '★ Cover';
            imgWrap.appendChild(b);
          }
          if (itemBar) {
            itemBar.innerHTML = `<span class="cover-label">Primary</span><button type="button" class="action-btn action-del" title="Remove photo" aria-label="Remove photo">✕</button>`;
          }
        } else {
          existingBadge?.remove();
          if (itemBar) {
            itemBar.innerHTML = `<button type="button" class="action-btn action-cover" title="Make this cover photo">Set Cover</button><button type="button" class="action-btn action-del" title="Remove photo" aria-label="Remove photo">✕</button>`;
          }
        }
      });

      if (emptyHint) {
        emptyHint.style.display = list.length === 0 ? 'block' : 'none';
      }
      bindGalleryActions();
    };

    const bindGalleryActions = () => {
      gallery.querySelectorAll<HTMLElement>('.gallery-item').forEach((item) => {
        // Remove button
        const delBtn = item.querySelector('.action-del');
        if (delBtn) {
          delBtn.onclick = (e) => {
            e.stopPropagation();
            item.remove();
            syncHiddenJson();
          };
        }

        // Set Cover button
        const coverBtn = item.querySelector('.action-cover');
        if (coverBtn) {
          coverBtn.onclick = (e) => {
            e.stopPropagation();
            gallery.prepend(item);
            syncHiddenJson();
          };
        }

        // Drag to reorder
        item.ondragstart = (e) => {
          item.classList.add('dragging');
          e.dataTransfer?.setData('text/plain', item.dataset.index || '0');
        };
        item.ondragend = () => {
          item.classList.remove('dragging');
          gallery.querySelectorAll('.gallery-item').forEach((x) => x.classList.remove('dragover'));
        };
        item.ondragover = (e) => {
          e.preventDefault();
          item.classList.add('dragover');
        };
        item.ondragleave = () => {
          item.classList.remove('dragover');
        };
        item.ondrop = (e) => {
          e.preventDefault();
          item.classList.remove('dragover');
          const draggingEl = gallery.querySelector('.dragging');
          if (draggingEl && draggingEl !== item) {
            const allItems = Array.from(gallery.querySelectorAll('.gallery-item'));
            const fromIndex = allItems.indexOf(draggingEl as HTMLElement);
            const toIndex = allItems.indexOf(item);
            if (fromIndex < toIndex) {
              item.after(draggingEl);
            } else {
              item.before(draggingEl);
            }
            syncHiddenJson();
          }
        };
      });
    };

    // Add image item to gallery
    const addImageToGallery = (src: string) => {
      const current = getStoredList();
      if (current.includes(src)) return; // Avoid duplicates

      const thumbUrl = src.startsWith('/uploads/') ? src : thumbs[src] || src;
      const idx = current.length;

      const div = document.createElement('div');
      div.className = 'gallery-item';
      div.dataset.src = src;
      div.dataset.index = String(idx);
      div.draggable = true;

      div.innerHTML = `
        <div class="img-wrap">
          <img src="${thumbUrl}" alt="" loading="lazy" />
          ${idx === 0 ? '<span class="cover-badge">★ Cover</span>' : ''}
        </div>
        <div class="item-bar">
          ${idx > 0 ? '<button type="button" class="action-btn action-cover" title="Make this cover photo">Set Cover</button>' : '<span class="cover-label">Primary</span>'}
          <button type="button" class="action-btn action-del" title="Remove photo" aria-label="Remove photo">✕</button>
        </div>
      `;

      gallery.appendChild(div);
      syncHiddenJson();
    };

    // Trigger file browse from text link
    if (triggerBrowse) {
      triggerBrowse.onclick = (e) => {
        e.preventDefault();
        fileInput.click();
      };
    }

    // Drag and drop onto dropZone
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('drag-active');
      });
    });

    ['dragleave', 'dragend', 'drop'].forEach((eventName) => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('drag-active');
      });
    });

    const updatePendingPreviews = (files: File[]) => {
      pendingFiles = files;
      if (!files.length) {
        pendingWrap.style.display = 'none';
        pendingGrid.innerHTML = '';
        return;
      }

      pendingWrap.style.display = 'block';
      if (pendingCount) pendingCount.textContent = String(files.length);
      pendingGrid.innerHTML = '';

      files.forEach((file) => {
        const card = document.createElement('div');
        card.className = 'pending-card';
        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.alt = file.name;
        img.onload = () => URL.revokeObjectURL(img.src);

        const info = document.createElement('div');
        info.className = 'pending-info';
        const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
        info.textContent = `${file.name} (${sizeMb} MB)`;
        info.title = file.name;

        card.appendChild(img);
        card.appendChild(info);
        pendingGrid.appendChild(card);
      });
    };

    const handleFilesAdded = (newFileList: FileList | File[]) => {
      const validFiles = Array.from(newFileList).filter(
        (f) => f.type.startsWith('image/') && f.size <= 25 * 1024 * 1024
      );
      if (!validFiles.length) return;

      const dt = new DataTransfer();
      // Combine existing pending with new files
      const combined = [...pendingFiles, ...validFiles];
      combined.forEach((f) => dt.files && dt.items.add(f));
      fileInput.files = dt.files;
      updatePendingPreviews(combined);
    };

    dropZone.addEventListener('drop', (e: DragEvent) => {
      if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
        handleFilesAdded(e.dataTransfer.files);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFilesAdded(fileInput.files);
      }
    });

    if (clearPendingBtn) {
      clearPendingBtn.onclick = (e) => {
        e.preventDefault();
        fileInput.value = '';
        updatePendingPreviews([]);
      };
    }

    // Add from photo library
    if (addLibBtn && libSelect) {
      addLibBtn.onclick = (e) => {
        e.preventDefault();
        const chosen = libSelect.value;
        if (chosen) {
          addImageToGallery(chosen);
          libSelect.value = '';
        }
      };
    }

    // Initialize gallery item events
    bindGalleryActions();
  });
</script>
