---
import Icon from './Icon.astro';
import { contactInfo, getSettings } from '@/lib/settings';
import { services } from '@/lib/data';
import { userFromCookies } from '@/lib/auth';

const settings = getSettings();
const c = contactInfo(settings);
const svc = services();
const user = userFromCookies(Astro.cookies);
const path = Astro.url.pathname;
const is = (p: string) => (p === '/' ? path === '/' : path === p || path.startsWith(p + '/'));
const NAV = [
  { href: '/custom-pc-builder', label: 'PC Builder', pill: '3D' },
  { href: '/membership', label: 'Membership' },
  { href: '/products', label: 'Products' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
const groups = [...new Set(svc.map((s) => s.group_name))];
---

{
  settings.announcement.text && (
    <div class="announce">
      <div class="wrap announce-inner">
        {settings.announcement.href ? (
          <a href={settings.announcement.href}>{settings.announcement.text}</a>
        ) : (
          <span>{settings.announcement.text}</span>
        )}
      </div>
    </div>
  )
}

<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${c.name} home`}>
      <img src="/virnobyte-logo.png" alt="" width="44" height="34" class="brand-logo" />
      <span class="brand-text">{c.name}</span>
    </a>

    <!-- Desktop Navigation (Screen width >= 1200px) -->
    <nav class="nav" aria-label="Main Navigation">
      <details class="services-menu" data-dropdown>
        <summary aria-current={is('/services') ? 'page' : undefined}>
          <span>Services</span>
          <Icon name="chevron" size={16} />
        </summary>
        <div class="mega">
          <div class="mega-grid">
            {
              groups.map((g) => (
                <div class="mega-col">
                  <p class="mega-group">{g}</p>
                  <ul>
                    {svc
                      .filter((s) => s.group_name === g)
                      .map((s) => (
                        <li>
                          <a href={`/services/${s.slug}`}>{s.name}</a>
                        </li>
                      ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </details>

      {
        NAV.map((n) => (
          <a href={n.href} aria-current={is(n.href) ? 'page' : undefined} class="nav-link">
            <span>{n.label}</span>
            {n.pill && <span class="nav-pill">{n.pill}</span>}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="phone" href={c.tel}>
        <Icon name="phone" size={18} />
        <span>{c.phone}</span>
      </a>

      <a
        class="icon-btn account-btn"
        href={user ? (user.role === 'admin' ? '/admin' : '/account') : '/account/login'}
        aria-label={user ? 'Your account' : 'Sign in'}
        title={user ? (user.role === 'admin' ? 'Admin Panel' : 'My Account') : 'Sign In'}
      >
        <Icon name="user" size={20} />
      </a>

      <a class="btn btn--sm book" href="/contact#book">Book a Service</a>

      <!-- Responsive Mobile/Tablet Hamburger Trigger (< 1200px) -->
      <button
        type="button"
        class="mobile-toggle"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Toggle navigation menu"
      >
        <span class="icon-menu-open">
          <Icon name="menu" size={24} />
        </span>
        <span class="icon-menu-close">
          <Icon name="close" size={24} />
        </span>
      </button>
    </div>
  </div>
</header>

<!-- ── Responsive Mobile & Tablet Off-Canvas Drawer ───────────── -->
<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <aside class="drawer-panel" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="drawer-top">
      <a href="/" class="drawer-brand">
        <img src="/virnobyte-logo.png" alt="" width="36" height="28" />
        <span>{c.name}</span>
      </a>
      <button type="button" class="drawer-close-btn" id="mobile-drawer-close" aria-label="Close menu">
        <Icon name="close" size={22} />
      </button>
    </div>

    <div class="drawer-cta-band">
      <a class="btn btn--block drawer-book-btn" href="/contact#book">
        <Icon name="calendar" size={18} />
        <span>Book a Service Online</span>
      </a>
      <div class="drawer-quick-contacts">
        <a class="quick-contact-btn" href={c.tel}>
          <Icon name="phone" size={16} />
          <span>Call {c.phone}</span>
        </a>
        <a class="quick-contact-btn quick-contact-btn--wa" href={c.whatsappUrl()} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={16} />
          <span>WhatsApp</span>
        </a>
      </div>
    </div>

    <div class="drawer-scroll-area">
      <nav class="drawer-nav" aria-label="Mobile Navigation Links">
        <!-- Expandable Accordion for Services -->
        <details class="drawer-accordion">
          <summary class="drawer-nav-link drawer-nav-link--summary">
            <span class="drawer-link-title">
              <Icon name="wrench" size={20} class="drawer-icon" />
              <span>IT Services & Repairs</span>
            </span>
            <Icon name="chevron" size={16} class="drawer-chevron" />
          </summary>
          <div class="drawer-accordion-content">
            <a href="/services" class="drawer-sub-all">View All {svc.length} IT Services →</a>
            <ul class="drawer-sub-grid">
              {svc.map((s) => (
                <li>
                  <a href={`/services/${s.slug}`}>{s.name}</a>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <a href="/" class="drawer-nav-link" aria-current={is('/') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="home" size={20} class="drawer-icon" />
            <span>Home</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/custom-pc-builder" class="drawer-nav-link" aria-current={is('/custom-pc-builder') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="external" size={20} class="drawer-icon" />
            <span>Custom PC Builder</span>
            <span class="drawer-pill drawer-pill--3d">3D</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/membership" class="drawer-nav-link" aria-current={is('/membership') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="coin" size={20} class="drawer-icon" />
            <span>Membership Card & Coins</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/products" class="drawer-nav-link" aria-current={is('/products') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="receipt" size={20} class="drawer-icon" />
            <span>Products & Hardware</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/portfolio" class="drawer-nav-link" aria-current={is('/portfolio') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="directions" size={20} class="drawer-icon" />
            <span>Our Portfolio</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/about" class="drawer-nav-link" aria-current={is('/about') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="user" size={20} class="drawer-icon" />
            <span>About Virnobyte</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/about#certificates" class="drawer-nav-link drawer-nav-link--highlight">
          <span class="drawer-link-title">
            <Icon name="shield" size={20} class="drawer-icon" />
            <span>Our Certificates</span>
            <span class="drawer-pill drawer-pill--cert">Verified</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/blog" class="drawer-nav-link" aria-current={is('/blog') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="mail" size={20} class="drawer-icon" />
            <span>Blog & Workshop Guides</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/contact" class="drawer-nav-link" aria-current={is('/contact') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="pin" size={20} class="drawer-icon" />
            <span>Contact & Workshop</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/faq" class="drawer-nav-link" aria-current={is('/faq') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="clock" size={20} class="drawer-icon" />
            <span>FAQ & Help</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>

        <a href="/careers" class="drawer-nav-link" aria-current={is('/careers') ? 'page' : undefined}>
          <span class="drawer-link-title">
            <Icon name="plus" size={20} class="drawer-icon" />
            <span>Careers at Virnobyte</span>
          </span>
          <Icon name="arrow" size={16} class="drawer-arrow" />
        </a>
      </nav>
    </div>

    <div class="drawer-bottom">
      <a class="drawer-user-card" href={user ? (user.role === 'admin' ? '/admin' : '/account') : '/account/login'}>
        <div class="drawer-user-icon">
          <Icon name="user" size={20} />
        </div>
        <div class="drawer-user-info">
          <span class="drawer-user-name">{user ? user.name : 'Sign In / Portal'}</span>
          <span class="drawer-user-desc">{user ? (user.role === 'admin' ? 'Open Admin Control' : 'Membership Account') : 'Access your coins and cards'}</span>
        </div>
        <Icon name="arrow" size={16} />
      </a>
      <p class="drawer-legal">Sadichha Complex, Jadhav Wadi, Chikhali, Pune</p>
    </div>
  </aside>
</div>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const closeBtn = document.getElementById('mobile-drawer-close');

    function openMenu() {
      if (!drawer) return;
      drawer.classList.add('is-active');
      header?.classList.add('is-menu-open');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!drawer) return;
      drawer.classList.remove('is-active');
      header?.classList.remove('is-menu-open');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (drawer?.classList.contains('is-active')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMenu();
    });

    backdrop?.addEventListener('click', (e) => {
      e.preventDefault();
      closeMenu();
    });

    // Close when clicking ANY navigation link inside the drawer
    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('is-active')) {
        closeMenu();
        toggleBtn?.focus();
      }
    });

    // Close automatically when resized to desktop (>= 1200px)
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1200 && drawer?.classList.contains('is-active')) {
        closeMenu();
      }
    });
  })();
</script>

<style>
  .announce {
    background: var(--night);
    color: var(--on-night);
    font-size: var(--fs-small);
    text-align: center;
    padding: 7px 0;
  }
  .announce-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .announce a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s ease;
  }
  @supports (backdrop-filter: blur(12px)) {
    .site-header {
      background: rgb(255 255 255 / 0.88);
    }
    .site-header::before {
      content: '';
      position: absolute;
      inset: 0;
      backdrop-filter: saturate(1.4) blur(12px);
      -webkit-backdrop-filter: saturate(1.4) blur(12px);
      pointer-events: none;
      z-index: -1;
    }
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 40px;
    height: auto;
  }
  .brand-text {
    white-space: nowrap;
  }

  /* ── Desktop Navigation ─────────────────────────────────────── */
  .nav {
    display: none;
    align-items: center;
    gap: 4px;
    margin-inline: auto;
  }
  .nav > a,
  .nav summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 42px;
    padding: 0 10px;
    border-radius: 999px;
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .nav summary::-webkit-details-marker {
    display: none;
  }
  .nav > a:hover,
  .nav summary:hover {
    color: var(--ink);
    background: var(--paper);
  }
  .nav [aria-current='page'] {
    color: var(--accent);
    background: var(--accent-tint);
    font-weight: 700;
  }

  .nav-pill {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    background: #eef2f6;
    color: var(--accent);
    border: 1px solid var(--line);
    letter-spacing: 0.05em;
  }

  /* ── Desktop Mega Menu ──────────────────────────────────────── */
  .services-menu {
    position: relative;
  }
  .services-menu[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .mega {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    transform: none;
    width: min(800px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    max-height: calc(88vh - var(--header-h));
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 16px 36px -8px rgb(11 23 36 / 0.18);
    padding: var(--space-5);
    z-index: 60;
  }
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .mega-group {
    font-size: var(--fs-small);
    color: var(--ink-3);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 4px;
  }
  .mega ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mega li a {
    display: block;
    padding: 6px 8px;
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.92rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .mega li a:hover {
    color: var(--accent);
    background: var(--paper);
  }

  /* ── Header Actions ─────────────────────────────────────────── */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    flex-shrink: 0;
  }
  .phone {
    display: none;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    font-size: var(--fs-small);
    padding: 0 8px;
    font-variant-numeric: tabular-nums;
  }
  .phone:hover {
    color: var(--accent);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--ink);
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .icon-btn:hover {
    background: var(--paper);
    color: var(--accent);
  }

  .book {
    display: none;
    padding: 0.55em 1.1em;
    font-size: 0.85rem;
    font-weight: 700;
  }

  /* ── Hamburger Trigger Button ───────────────────────────────── */
  .mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--ink);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
    position: relative;
  }
  .mobile-toggle:hover {
    background: var(--paper);
    color: var(--accent);
  }
  .icon-menu-open,
  .icon-menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .icon-menu-close {
    display: none !important;
  }
  .site-header.is-menu-open .icon-menu-open {
    display: none !important;
  }
  .site-header.is-menu-open .icon-menu-close {
    display: inline-flex !important;
  }

  /* ── Off-Canvas Mobile & Tablet Drawer ──────────────────────── */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0.3s ease;
  }
  .mobile-drawer.is-active {
    visibility: visible;
    pointer-events: auto;
  }
  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(8 16 26 / 0.65);
    backdrop-filter: blur(5px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mobile-drawer.is-active .drawer-backdrop {
    opacity: 1;
  }

  .drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 32px rgb(0 0 0 / 0.25);
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
    overflow: hidden;
  }
  .mobile-drawer.is-active .drawer-panel {
    transform: translateX(0);
  }

  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .drawer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .drawer-close-btn {
    width: 38px;
    height: 38px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .drawer-close-btn:hover {
    background: var(--line);
  }

  .drawer-cta-band {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: var(--space-3);
    background: #fdfefe;
  }
  .drawer-book-btn {
    font-weight: 700;
    box-shadow: 0 4px 12px -2px rgb(10 95 194 / 0.25);
  }
  .drawer-quick-contacts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  .quick-contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: var(--radius-s);
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }
  .quick-contact-btn:hover {
    background: #fff;
    border-color: var(--accent);
    color: var(--accent);
  }
  .quick-contact-btn--wa {
    color: #0b7a42;
  }
  .quick-contact-btn--wa:hover {
    color: #0b7a42;
    border-color: #0b7a42;
    background: #eafaf1;
  }

  .drawer-scroll-area {
    flex-grow: 1;
    overflow-y: auto;
    padding: var(--space-3) var(--space-5);
    -webkit-overflow-scrolling: touch;
  }

  .drawer-nav {
    display: grid;
    gap: 2px;
  }
  .drawer-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 10px;
    border-radius: var(--radius-s);
    color: var(--ink);
    text-decoration: none;
    font-weight: 650;
    font-size: 1rem;
    transition: background-color 0.15s ease;
  }
  .drawer-nav-link:hover {
    background: var(--paper);
  }
  .drawer-nav-link[aria-current='page'] {
    background: var(--accent-tint);
    color: var(--accent);
    font-weight: 700;
  }
  .drawer-link-title {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .drawer-icon {
    color: var(--ink-3);
    flex-shrink: 0;
  }
  .drawer-nav-link[aria-current='page'] .drawer-icon {
    color: var(--accent);
