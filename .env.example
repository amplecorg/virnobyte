# ==============================================================================
# Virnobyte Production Environment Configuration (Hostinger Web Apps & VPS)
# ==============================================================================

# Public Canonical Site URL (must match your domain with https://)
PUBLIC_SITE_URL=https://virnobyte.com

# Domain(s) for Reverse Proxy & Automatic SSL (Let's Encrypt / ZeroSSL)
# Can be a single domain, or comma/space-separated list: "virnobyte.com, www.virnobyte.com"
DOMAIN_NAME=virnobyte.com, www.virnobyte.com

# Email for SSL certificate renewal notifications and emergency alerts
ACME_EMAIL=admin@virnobyte.com

# Initial Administrator Account (Created automatically on first start if no admin exists)
ADMIN_EMAIL=admin@virnobyte.com
ADMIN_PASSWORD=change-me-to-a-very-strong-password-12345

# Email / SMTP Settings (Required for sending password reset emails and enquiry notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=false
SMTP_FROM="Virnobyte <no-reply@virnobyte.com>"

# Application Internal Settings (Port 3000 is standard for Hostinger Web Apps)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=/app/data
